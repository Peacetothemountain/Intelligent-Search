<?xml version="1.0" encoding="utf-8"?>
<!-- April Fools' Day: the G wears a pair of googly eyes whose pupils rattle around, and a spring bounces beside it.
     See doodle_halloween.xml for the layout. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="48dp" android:height="48dp" android:viewportWidth="48" android:viewportHeight="48">

            <!-- Googly eyes on the G's brow -->
            <path android:fillColor="#FFFFFFFF" android:pathData="M17.5,13.6a2.9,2.9 0,1 0,5.8 0a2.9,2.9 0,1 0,-5.8 0Z M24.3,13a2.9,2.9 0,1 0,5.8 0a2.9,2.9 0,1 0,-5.8 0Z" android:strokeColor="#FF5F6368" android:strokeWidth="0.5" />
            <group android:name="pupil_left" android:translateX="20.4" android:translateY="14.6">
                <path android:fillColor="#FF202124" android:pathData="M-1.3,0a1.3,1.3 0,1 0,2.6 0a1.3,1.3 0,1 0,-2.6 0Z" />
            </group>
            <group android:name="pupil_right" android:translateX="27.8" android:translateY="13.6">
                <path android:fillColor="#FF202124" android:pathData="M-1.3,0a1.3,1.3 0,1 0,2.6 0a1.3,1.3 0,1 0,-2.6 0Z" />
            </group>

            <!-- A spring on the right, squashing and stretching -->
            <group android:name="spring" android:pivotY="45" android:translateX="42">
                <path android:pathData="M-2.6,45L2.6,44 M2.6,44L-2.6,42.6 M-2.6,42.6L2.6,41.2 M2.6,41.2L-2.6,39.8 M-2.6,39.8L2.6,38.4 M2.6,38.4L-2.6,37" android:strokeColor="#FF80868B" android:strokeLineCap="round" android:strokeWidth="0.8" />
                <path android:fillColor="#FFEA4335" android:pathData="M-2,35.4a2,2 0,1 0,4 0a2,2 0,1 0,-4 0Z" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="pupil_left">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1400" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="translateX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="20.4" />
                    <keyframe android:fraction="0.15" android:interpolator="@android:interpolator/decelerate_quad" android:value="19.1" />
                    <keyframe android:fraction="0.3" android:value="19.6" />
                    <keyframe android:fraction="0.45" android:interpolator="@android:interpolator/decelerate_quad" android:value="21.5" />
                    <keyframe android:fraction="0.6" android:value="20.9" />
                    <keyframe android:fraction="0.8" android:interpolator="@android:interpolator/bounce" android:value="20.4" />
                    <keyframe android:fraction="1" android:value="20.4" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="14.6" />
                    <keyframe android:fraction="0.15" android:interpolator="@android:interpolator/decelerate_quad" android:value="13.2" />
                    <keyframe android:fraction="0.3" android:value="12.4" />
                    <keyframe android:fraction="0.45" android:interpolator="@android:interpolator/decelerate_quad" android:value="13" />
                    <keyframe android:fraction="0.6" android:value="14.4" />
                    <keyframe android:fraction="0.8" android:interpolator="@android:interpolator/bounce" android:value="14.6" />
                    <keyframe android:fraction="1" android:value="14.6" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="pupil_right">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1100" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="translateX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="27.8" />
                    <keyframe android:fraction="0.2" android:interpolator="@android:interpolator/decelerate_quad" android:value="28.7" />
                    <keyframe android:fraction="0.4" android:value="27.6" />
                    <keyframe android:fraction="0.6" android:interpolator="@android:interpolator/decelerate_quad" android:value="26.2" />
                    <keyframe android:fraction="0.85" android:interpolator="@android:interpolator/bounce" android:value="27.8" />
                    <keyframe android:fraction="1" android:value="27.8" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="13.6" />
                    <keyframe android:fraction="0.2" android:interpolator="@android:interpolator/decelerate_quad" android:value="12.2" />
                    <keyframe android:fraction="0.4" android:value="11.8" />
                    <keyframe android:fraction="0.6" android:interpolator="@android:interpolator/decelerate_quad" android:value="12.6" />
                    <keyframe android:fraction="0.85" android:interpolator="@android:interpolator/bounce" android:value="13.6" />
                    <keyframe android:fraction="1" android:value="13.6" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="spring">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="900" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.3" android:interpolator="@android:interpolator/decelerate_quad" android:value="0.7" />
                    <keyframe android:fraction="0.55" android:interpolator="@android:interpolator/decelerate_quad" android:value="1.15" />
                    <keyframe android:fraction="0.75" android:value="0.95" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
