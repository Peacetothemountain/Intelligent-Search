<?xml version="1.0" encoding="utf-8"?>
<!-- World Bicycle Day: a bicycle rolls along under the G, wheels and pedals turning, a pennant fluttering and flowers
     nodding in its basket, as a cloud drifts by.
     See doodle_halloween.xml for the layout. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="48dp" android:height="48dp" android:viewportWidth="48" android:viewportHeight="48">

            <!-- Cloud -->
            <group android:name="cloud" android:translateX="0">
                <path android:fillColor="#FFDADCE0" android:pathData="M4.4,12.6a2,1.6 0,1 0,4 0a2,1.6 0,1 0,-4 0ZM6.5,11.4a2.5,2.3 0,1 0,5 0a2.5,2.3 0,1 0,-5 0ZM9.7,12.7a1.9,1.6 0,1 0,3.8 0a1.9,1.6 0,1 0,-3.8 0Z" />
                <path android:fillColor="#FFFFFFFF" android:pathData="M4.5,12.1a1.9,1.5 0,1 0,3.8 0a1.9,1.5 0,1 0,-3.8 0ZM6.6,10.9a2.4,2.2 0,1 0,4.8 0a2.4,2.2 0,1 0,-4.8 0ZM9.8,12.2a1.8,1.5 0,1 0,3.6 0a1.8,1.5 0,1 0,-3.6 0Z" />
            </group>

            <!-- Speed lines -->
            <group android:name="speed" android:translateX="1">
                <path android:name="speed_lines" android:strokeColor="#FFBDC1C6" android:strokeAlpha="0" android:strokeWidth="0.45" android:strokeLineCap="round" android:pathData="M8.6,39.6L11,39.6M7.4,41.8L10.4,41.8M8.8,44L11,44" />
            </group>
            <group android:name="bike" android:translateX="0" android:translateY="0">
                <group android:translateY="-0.6">

                    <!-- Pennant -->
                    <path android:strokeColor="#FF9AA0A6" android:strokeWidth="0.3" android:strokeLineCap="round" android:pathData="M16.6,42.6L14.6,35.2" />
                    <path android:name="flag" android:fillColor="#FFFA7B17" android:strokeColor="#FFE8710A" android:strokeWidth="0.2" android:strokeLineJoin="round" android:pathData="M14.6,35.4Q13,35.6 11.6,36.6Q13,36.8 14.8,37.4Z" />

                    <!-- Wheels -->
                    <path android:strokeColor="#FF80868B" android:strokeWidth="0.75" android:pathData="M13.1,42.8a3.4,3.4 0,1 0,6.8 0a3.4,3.4 0,1 0,-6.8 0ZM28.1,42.8a3.4,3.4 0,1 0,6.8 0a3.4,3.4 0,1 0,-6.8 0Z" />
                    <path android:strokeColor="#FFBDC1C6" android:strokeWidth="0.25" android:pathData="M13.6,42.8a2.9,2.9 0,1 0,5.8 0a2.9,2.9 0,1 0,-5.8 0ZM28.6,42.8a2.9,2.9 0,1 0,5.8 0a2.9,2.9 0,1 0,-5.8 0Z" />
                    <group android:name="wheel_back" android:rotation="0" android:pivotX="16.5" android:pivotY="42.8">
                        <path android:strokeColor="#FFBDC1C6" android:strokeWidth="0.22" android:pathData="M19.5,42.8L13.5,42.8M18,45.4L15,40.2M15,45.4L18,40.2" />
                    </group>
                    <group android:name="wheel_front" android:rotation="0" android:pivotX="31.5" android:pivotY="42.8">
                        <path android:strokeColor="#FFBDC1C6" android:strokeWidth="0.22" android:pathData="M34.5,42.8L28.5,42.8M33,45.4L30,40.2M30,45.4L33,40.2" />
                    </group>
                    <path android:fillColor="#FF5F6368" android:pathData="M16.05,42.8a0.45,0.45 0,1 0,0.9 0a0.45,0.45 0,1 0,-0.9 0ZM31.05,42.8a0.45,0.45 0,1 0,0.9 0a0.45,0.45 0,1 0,-0.9 0Z" />

                    <!-- Frame, seat, handlebar, pedals -->
                    <path android:strokeColor="#FF1A73E8" android:strokeWidth="1.15" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M16.5,42.8L23,42.8L29.6,38.2L21.3,37.6L16.5,42.8M23,42.8L21.3,37.6M29.6,38.2L31.5,42.8" />
                    <path android:strokeColor="#FF4285F4" android:strokeWidth="0.7" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M16.5,42.8L23,42.8L29.6,38.2L21.3,37.6L16.5,42.8M23,42.8L21.3,37.6M29.6,38.2L31.5,42.8" />
                    <path android:strokeColor="#FF80868B" android:strokeWidth="0.5" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M29.6,38.2L29.1,36.6L27.8,36.4" />
                    <path android:fillColor="#FFEA4335" android:strokeColor="#FFC5221F" android:strokeWidth="0.25" android:pathData="M19.75,37.1a1.35,0.5 0,1 0,2.7 0a1.35,0.5 0,1 0,-2.7 0Z" />
                    <group android:name="crank" android:rotation="0" android:pivotX="23" android:pivotY="42.8">
                        <path android:strokeColor="#FF5F6368" android:strokeWidth="0.45" android:strokeLineCap="round" android:pathData="M23,41.2L23,44.4M22.2,41.2L23.8,41.2M22.2,44.4L23.8,44.4" />
                    </group>
                    <path android:strokeColor="#FF80868B" android:strokeWidth="0.3" android:pathData="M22,42.8a1,1 0,1 0,2 0a1,1 0,1 0,-2 0Z" />

                    <!-- Basket of flowers -->
                    <group android:name="flowers" android:rotation="-6" android:pivotX="32.4" android:pivotY="37">
                        <path android:strokeColor="#FF34A853" android:strokeWidth="0.3" android:strokeLineCap="round" android:pathData="M31.6,37L31.4,35.4M33.2,37L33.4,35" />
                        <path android:fillColor="#FFF06292" android:strokeColor="#FFD81B60" android:strokeWidth="0.15" android:pathData="M30.9,34.5a0.5,0.5 0,1 0,1 0a0.5,0.5 0,1 0,-1 0ZM30.1,35.2a0.5,0.5 0,1 0,1 0a0.5,0.5 0,1 0,-1 0ZM31.7,35.2a0.5,0.5 0,1 0,1 0a0.5,0.5 0,1 0,-1 0ZM30.45,36a0.45,0.45 0,1 0,0.9 0a0.45,0.45 0,1 0,-0.9 0ZM31.45,36a0.45,0.45 0,1 0,0.9 0a0.45,0.45 0,1 0,-0.9 0Z" />
                        <path android:fillColor="#FFFBBC04" android:strokeColor="#FFF29900" android:strokeWidth="0.15" android:pathData="M32.9,34.1a0.5,0.5 0,1 0,1 0a0.5,0.5 0,1 0,-1 0ZM32.1,34.8a0.5,0.5 0,1 0,1 0a0.5,0.5 0,1 0,-1 0ZM33.7,34.8a0.5,0.5 0,1 0,1 0a0.5,0.5 0,1 0,-1 0ZM32.45,35.6a0.45,0.45 0,1 0,0.9 0a0.45,0.45 0,1 0,-0.9 0ZM33.45,35.6a0.45,0.45 0,1 0,0.9 0a0.45,0.45 0,1 0,-0.9 0Z" />
                        <path android:fillColor="#FFFFFFFF" android:pathData="M31,35.3a0.4,0.4 0,1 0,0.8 0a0.4,0.4 0,1 0,-0.8 0ZM33,34.9a0.4,0.4 0,1 0,0.8 0a0.4,0.4 0,1 0,-0.8 0Z" />
                    </group>
                    <path android:fillColor="#FFE6B57E" android:strokeColor="#FFC98A4B" android:strokeWidth="0.35" android:strokeLineJoin="round" android:pathData="M30.4,36.8L34.6,36.8L34.1,39.2L30.9,39.2Z" />
                    <path android:strokeColor="#FFC98A4B" android:strokeWidth="0.22" android:pathData="M30.7,38L34.3,38M32.5,36.8L32.5,39.2" />
                </group>
            </group>
        </vector>
    </aapt:attr>

    <!-- 3.2s: the bike glides forward and back with little bumps; the wheels turn every 0.8s. -->
    <target android:name="bike">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="3200" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="translateX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.5" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1.4" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.25" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-0.35" />
                    <keyframe android:fraction="0.5" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                    <keyframe android:fraction="0.75" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-0.35" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="wheel_back">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="800" android:interpolator="@android:interpolator/linear" android:propertyName="rotation" android:repeatCount="infinite" android:valueFrom="0" android:valueTo="360" android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="wheel_front">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="800" android:interpolator="@android:interpolator/linear" android:propertyName="rotation" android:repeatCount="infinite" android:valueFrom="0" android:valueTo="360" android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="crank">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1600" android:interpolator="@android:interpolator/linear" android:propertyName="rotation" android:repeatCount="infinite" android:valueFrom="0" android:valueTo="360" android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="flag">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="400" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="pathData" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="M14.6,35.4Q13,35.6 11.6,36.6Q13,36.8 14.8,37.4Z" android:valueTo="M14.6,35.4Q13.2,36.2 11.8,36Q13.2,37.2 14.8,37.4Z" android:valueType="pathType" />
        </aapt:attr>
    </target>
    <target android:name="flowers">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1600" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="-6" />
                    <keyframe android:fraction="0.5" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="6" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-6" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="speed">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="800" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="translateX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/linear" android:value="-2.5" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="speed_lines">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="800" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="strokeAlpha" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.3" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="cloud">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="6400" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="translateX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.5" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="2" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
