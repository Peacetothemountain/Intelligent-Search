<?xml version="1.0" encoding="utf-8"?>
<!-- International Cat Day: a ginger tabby loafs on top of the G, front paws over its edge. Its tail hangs down the
     G's right side and swishes, the tip trailing behind; an ear twitches, then it tilts its head and gives a slow,
     contented blink. A ball of yarn rolls to and fro below. See doodle_halloween.xml for the layout. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="48dp" android:height="48dp" android:viewportWidth="48" android:viewportHeight="48">

            <!-- Ball of yarn with a loose strand -->
            <group android:name="yarn_roll" android:translateX="41" android:translateY="40.6">
                <path android:pathData="M-2.6,1.6C-5.6,3.8 -7.8,2 -9.8,3.6C-10.8,4.4 -10.2,5.4 -9.2,4.8" android:strokeColor="#FF4285F4" android:strokeLineCap="round" android:strokeWidth="0.5" />
                <group android:name="yarn_spin">
                    <path android:fillColor="#FF4285F4" android:pathData="M-3,0a3,3 0,1 0,6 0a3,3 0,1 0,-6 0Z" />
                    <path android:fillColor="#FF1967D2" android:pathData="M3,0A3,3 0,0 1,-2.1 2.15A3.6,3.6 0,0 0,3 0Z" />
                    <path android:pathData="M-2.3,-1.6C-0.8,-0.4 0.8,-0.4 2.4,-1.6 M-2.8,0.6C-1,1.7 1,1.7 2.8,0.6 M-0.9,-2.8C0.5,-1.2 0.5,1.2 -0.9,2.8 M0.9,-2.8C2,-1.6 2.2,0 1.8,1.6" android:strokeColor="#FFAECBFA" android:strokeLineCap="round" android:strokeWidth="0.4" />
                </group>
            </group>

            <!-- Tail, hanging from the cat's rear down the right of the G; the tip trails the swish -->
            <group android:name="tail" android:pivotX="31" android:pivotY="11.6" android:rotation="-8">
                <path android:pathData="M31,11.6C34.4,11 37.2,12 37.9,15L38.4,19" android:strokeColor="#FFE8710A" android:strokeLineCap="round" android:strokeWidth="2" />
                <path android:pathData="M31,11.6C34.4,11 37.2,12 37.9,15L38.4,19" android:strokeColor="#FFFA903E" android:strokeLineCap="round" android:strokeWidth="1.3" />
                <group android:name="tail_tip" android:pivotX="38.4" android:pivotY="19">
                    <path android:pathData="M38.4,19C38.7,21.4 39.2,23.6 38.2,25.2C37.7,26 36.8,25.8 36.9,25" android:strokeColor="#FFE8710A" android:strokeLineCap="round" android:strokeWidth="2" />
                    <path android:pathData="M38.4,19C38.7,21.4 39.2,23.6 38.2,25.2" android:strokeColor="#FFFA903E" android:strokeLineCap="round" android:strokeWidth="1.3" />
                    <path android:pathData="M38.55,21L38.8,22.4" android:strokeColor="#FFE8710A" android:strokeLineCap="round" android:strokeWidth="0.6" />
                </group>
            </group>

            <!-- Loaf of a body lying along the top of the G, with tabby stripes and a shaded belly -->
            <path android:fillColor="#FFFA903E" android:pathData="M18,14.4C17.4,10 20,7 24.5,6.9C28.6,6.8 31.6,9 31.4,13.4C31.3,14.6 30.6,15 29.8,14.8C26,13.6 22,13.4 18,14.4Z" />
            <path android:fillColor="#FFE8710A" android:pathData="M18.1,14.4C18,13.4 18.3,12.7 19,12.6C23,12 27.5,12 31.35,12.8C31.3,14.6 30.6,15 29.8,14.8C26,13.6 22,13.4 18.1,14.4Z" />
            <path android:pathData="M23.2,7.1Q23.8,8.3 23.4,9.5 M26,7Q26.6,8.2 26.2,9.4 M28.7,7.7Q29.2,8.7 28.9,9.9" android:strokeColor="#FFE8710A" android:strokeLineCap="round" android:strokeWidth="0.7" />
            <!-- Front paws over the edge -->
            <path android:fillColor="#FFFA903E" android:strokeColor="#FFE8710A" android:strokeWidth="0.35" android:pathData="M19.9,14a1.25,0.95 0,1 0,2.5 0a1.25,0.95 0,1 0,-2.5 0Z M22.8,14a1.25,0.95 0,1 0,2.5 0a1.25,0.95 0,1 0,-2.5 0Z" />
            <path android:pathData="M20.8,14.3L20.8,14.85 M21.5,14.3L21.5,14.85 M23.7,14.3L23.7,14.85 M24.4,14.3L24.4,14.85" android:strokeColor="#FFE8710A" android:strokeLineCap="round" android:strokeWidth="0.25" />

            <!-- Head -->
            <group android:name="head" android:pivotX="18.4" android:pivotY="11.6">
                <path android:fillColor="#FFFA903E" android:pathData="M13.7,6.6L13.3,1.9L17,4.4Z" />
                <path android:fillColor="#FFF8BBD0" android:pathData="M14.3,5.8L14.1,3L16.2,4.5Z" />
                <group android:name="ear_right" android:pivotX="20.4" android:pivotY="5.6">
                    <path android:fillColor="#FFE8710A" android:pathData="M21.1,6.6L21.5,1.9L17.8,4.4Z" />
                    <path android:fillColor="#FFF8BBD0" android:pathData="M20.5,5.8L20.7,3L18.6,4.5Z" />
                </group>
                <path android:fillColor="#FFE8710A" android:pathData="M12.9,8.6a4.5,4.1 0,1 0,9 0a4.5,4.1 0,1 0,-9 0Z" />
                <path android:fillColor="#FFFA903E" android:pathData="M12.95,8.35a4.2,3.75 0,1 0,8.4 0a4.2,3.75 0,1 0,-8.4 0Z" />
                <path android:pathData="M16.4,4.9L16.6,6 M17.4,4.7L17.4,5.9 M18.4,4.9L18.2,6" android:strokeColor="#FFE8710A" android:strokeLineCap="round" android:strokeWidth="0.5" />
                <path android:fillAlpha="0.45" android:fillColor="#FFF28B82" android:pathData="M13.9,9.6a0.8,0.5 0,1 0,1.6 0a0.8,0.5 0,1 0,-1.6 0Z M19.3,9.6a0.8,0.5 0,1 0,1.6 0a0.8,0.5 0,1 0,-1.6 0Z" />
                <path android:fillColor="#FFFFE0B2" android:pathData="M15.45,10.2a1.05,0.85 0,1 0,2.1 0a1.05,0.85 0,1 0,-2.1 0Z M17.25,10.2a1.05,0.85 0,1 0,2.1 0a1.05,0.85 0,1 0,-2.1 0Z" />
                <path android:fillColor="#FFF28B82" android:pathData="M16.85,9.2L17.95,9.2L17.4,9.85Z" />
                <path android:pathData="M15.2,10L12.6,9.5 M15.2,10.5L12.7,10.9 M19.6,10L22.2,9.5 M19.6,10.5L22.1,10.9" android:strokeAlpha="0.75" android:strokeColor="#FFC26401" android:strokeLineCap="round" android:strokeWidth="0.22" />
                <group android:name="eyes" android:pivotY="8">
                    <path android:fillColor="#FF3C4043" android:pathData="M15.05,8a0.6,0.85 0,1 0,1.2 0a0.6,0.85 0,1 0,-1.2 0Z M18.55,8a0.6,0.85 0,1 0,1.2 0a0.6,0.85 0,1 0,-1.2 0Z" />
                    <path android:fillColor="#FFFFFFFF" android:pathData="M15.5,7.65a0.22,0.22 0,1 0,0.44 0a0.22,0.22 0,1 0,-0.44 0Z M19,7.65a0.22,0.22 0,1 0,0.44 0a0.22,0.22 0,1 0,-0.44 0Z" />
                </group>
            </group>
        </vector>
    </aapt:attr>

    <!-- Tail, 2.8s: the base swishes and the tip follows a beat behind. -->
    <target android:name="tail">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="2800" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="-8" />
                    <keyframe android:fraction="0.5" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-8" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="tail_tip">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="2800" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.25" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-10" />
                    <keyframe android:fraction="0.5" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                    <keyframe android:fraction="0.75" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="10" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- Face, 4s: an ear twitch, then a head tilt and a slow blink, then rest. -->
    <target android:name="ear_right">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="4000" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.3" android:value="0" />
                    <keyframe android:fraction="0.33" android:interpolator="@android:interpolator/decelerate_quad" android:value="16" />
                    <keyframe android:fraction="0.36" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                    <keyframe android:fraction="0.39" android:interpolator="@android:interpolator/decelerate_quad" android:value="9" />
                    <keyframe android:fraction="0.43" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="head">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="4000" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.48" android:value="0" />
                    <keyframe android:fraction="0.58" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="-8" />
                    <keyframe android:fraction="0.82" android:value="-8" />
                    <keyframe android:fraction="0.92" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="0" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="eyes">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="4000" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.56" android:value="1" />
                    <keyframe android:fraction="0.62" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0.1" />
                    <keyframe android:fraction="0.76" android:value="0.1" />
                    <keyframe android:fraction="0.82" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- The yarn rolls a little way and back. -->
    <target android:name="yarn_roll">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1800" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="translateX" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="41" android:valueTo="39.4" android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="yarn_spin">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1800" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="rotation" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="0" android:valueTo="-31" android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
