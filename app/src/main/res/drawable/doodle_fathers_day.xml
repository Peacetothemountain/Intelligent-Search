<?xml version="1.0" encoding="utf-8"?>
<!-- Father's Day: the G wears a jaunty fedora and a polka-dot bow tie. Every few seconds it tips its hat (a little
     squash before the lift, a bounce on landing), and the bow tie wiggles as the hat lands. A gold "best dad" medal
     swings beside it and sparkles glint. See doodle_halloween.xml for the layout. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="48dp" android:height="48dp" android:viewportWidth="48" android:viewportHeight="48">

            <!-- Sparkles -->
            <group android:name="spark_1" android:translateX="8.2" android:translateY="15" android:scaleX="2" android:scaleY="2">
                <path android:fillColor="#FFFBBC04" android:pathData="M0,-1Q0.24,-0.24 1,0Q0.24,0.24 0,1Q-0.24,0.24 -1,0Q-0.24,-0.24 0,-1Z" />
            </group>
            <group android:name="spark_2" android:translateX="6" android:translateY="31.5" android:scaleX="1.4" android:scaleY="1.4">
                <path android:fillColor="#FF8AB4F8" android:pathData="M0,-1Q0.24,-0.24 1,0Q0.24,0.24 0,1Q-0.24,0.24 -1,0Q-0.24,-0.24 0,-1Z" />
            </group>
            <group android:name="spark_3" android:translateX="45.6" android:translateY="17.6" android:scaleX="1.5" android:scaleY="1.5">
                <path android:fillColor="#FFFBBC04" android:pathData="M0,-1Q0.24,-0.24 1,0Q0.24,0.24 0,1Q-0.24,0.24 -1,0Q-0.24,-0.24 0,-1Z" />
            </group>

            <!-- Medal on a blue and red ribbon, swinging from its top -->
            <group android:name="medal" android:translateX="41" android:translateY="0.6">
                <path android:fillColor="#FF4285F4" android:pathData="M-2.7,0L-0.9,0L1.1,7.6L-0.7,7.6Z" />
                <path android:fillColor="#FFEA4335" android:pathData="M2.7,0L0.9,0L-1.1,7.6L0.7,7.6Z" />
                <path android:fillColor="#FFC5221F" android:pathData="M0.9,0L2.7,0L2.2,1.9L0.4,1.9Z" />
                <path android:fillColor="#FFE37400" android:pathData="M-3.5,10.6a3.5,3.5 0,1 0,7 0a3.5,3.5 0,1 0,-7 0Z" />
                <path android:fillColor="#FFFBBC04" android:pathData="M-3.15,10.3a2.9,2.9 0,1 0,5.8 0a2.9,2.9 0,1 0,-5.8 0Z" />
                <path android:fillColor="#FFFDE293" android:pathData="M-0.25,8.1L0.4,9.6L2,9.7L0.8,10.7L1.2,12.3L-0.25,11.4L-1.7,12.3L-1.3,10.7L-2.5,9.7L-0.9,9.6Z" />
            </group>

            <!-- Bow tie under the G -->
            <group android:name="bow_tie" android:translateX="24" android:translateY="40.4">
                <path android:fillColor="#FFEA4335" android:pathData="M-1,-0.9C-2.6,-2.2 -4.6,-3.2 -5.4,-2.6C-6,-2.1 -6,2.1 -5.4,2.6C-4.6,3.2 -2.6,2.2 -1,0.9Z M1,-0.9C2.6,-2.2 4.6,-3.2 5.4,-2.6C6,-2.1 6,2.1 5.4,2.6C4.6,3.2 2.6,2.2 1,0.9Z" />
                <path android:fillColor="#FFC5221F" android:pathData="M-1,-0.9C-2,-1.6 -2.9,-1.7 -3.1,-0.6L-3.1,0.6C-2.9,1.7 -2,1.6 -1,0.9Z M1,-0.9C2,-1.6 2.9,-1.7 3.1,-0.6L3.1,0.6C2.9,1.7 2,1.6 1,0.9Z M-5.6,0.9C-5.5,1.8 -5.4,2.4 -5.1,2.7C-4.4,3 -2.6,2.2 -1.6,1.4C-3,1.9 -4.4,1.9 -5.6,0.9Z M5.6,0.9C5.5,1.8 5.4,2.4 5.1,2.7C4.4,3 2.6,2.2 1.6,1.4C3,1.9 4.4,1.9 5.6,0.9Z" />
                <path android:fillColor="#FFFAD2CF" android:pathData="M-4.75,-1.2a0.5,0.5 0,1 0,1 0a0.5,0.5 0,1 0,-1 0Z M-3.4,0.9a0.45,0.45 0,1 0,0.9 0a0.45,0.45 0,1 0,-0.9 0Z M-5.3,0.6a0.38,0.38 0,1 0,0.76 0a0.38,0.38 0,1 0,-0.76 0Z M3.75,-1.2a0.5,0.5 0,1 0,1 0a0.5,0.5 0,1 0,-1 0Z M2.5,0.9a0.45,0.45 0,1 0,0.9 0a0.45,0.45 0,1 0,-0.9 0Z M4.54,0.6a0.38,0.38 0,1 0,0.76 0a0.38,0.38 0,1 0,-0.76 0Z" />
                <path android:fillColor="#FFC5221F" android:pathData="M-1.3,-1.3L1.3,-1.3Q1.7,0 1.3,1.3L-1.3,1.3Q-1.7,0 -1.3,-1.3Z" />
                <path android:fillColor="#FFEA4335" android:pathData="M-0.9,-1L0.7,-1Q0.9,-0.4 0.6,-0.1L-0.8,-0.1Q-1.1,-0.5 -0.9,-1Z" />
            </group>

            <!-- Fedora resting on the G: lifted and tipped from the middle of its brim -->
            <group android:name="hat_lift" android:translateX="24" android:translateY="13.4" android:rotation="-6">
                <group android:name="hat_squash" android:scaleX="1" android:scaleY="1">
                    <path android:fillColor="#FF4285F4" android:pathData="M-8.7,-1C-6.6,-0.9 -5,-1.3 0,-1.3C5,-1.3 6.6,-0.9 8.7,-1C8.3,0.9 -8.3,0.9 -8.7,-1Z" />
                    <path android:fillColor="#FF1967D2" android:pathData="M-8.7,-1C-7,0.15 7,0.15 8.7,-1C8.3,0.9 -8.3,0.9 -8.7,-1Z" />
                    <path android:fillColor="#FF4285F4" android:pathData="M-5.1,-0.7L-4.3,-5.3C-4.1,-6.3 -2.2,-6.7 0,-6C2.2,-6.7 4.1,-6.3 4.3,-5.3L5.1,-0.7C1.7,-0.1 -1.7,-0.1 -5.1,-0.7Z" />
                    <path android:fillColor="#FF1967D2" android:pathData="M1.7,-6.35C2.8,-6.6 4.1,-6.3 4.3,-5.3L5.1,-0.7C4.1,-0.5 3.2,-0.42 2.5,-0.38Z" />
                    <path android:fillColor="#FFFBBC04" android:pathData="M-4.82,-2.3C-1.7,-1.7 1.7,-1.7 4.82,-2.3L4.94,-0.95C1.7,-0.35 -1.7,-0.35 -4.94,-0.95Z" />
                    <path android:fillColor="#FFE37400" android:pathData="M2.5,-1.85C3.3,-1.95 4.1,-2.1 4.82,-2.3L4.94,-0.95C4.2,-0.8 3.4,-0.7 2.5,-0.62Z" />
                    <path android:fillColor="#FF34A853" android:pathData="M3.3,-1.9C4.8,-3.1 5.8,-4.7 5.4,-6.5C4.2,-5.4 3.3,-3.6 3.3,-1.9Z" />
                    <path android:pathData="M3.5,-2.2Q4.6,-3.8 5.3,-6.1" android:strokeColor="#FF188038" android:strokeLineCap="round" android:strokeWidth="0.35" />
                    <path android:pathData="M-3.7,-2.8L-3.4,-4.9" android:strokeAlpha="0.9" android:strokeColor="#FF8AB4F8" android:strokeLineCap="round" android:strokeWidth="0.6" />
                </group>
            </group>
        </vector>
    </aapt:attr>

    <!-- 4s loop: rest, squash, lift and tip, hover, drop, bounce, settle. -->
    <target android:name="hat_lift">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="4000" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="13.4" />
                    <keyframe android:fraction="0.36" android:value="13.4" />
                    <keyframe android:fraction="0.42" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="13.8" />
                    <keyframe android:fraction="0.54" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="9.6" />
                    <keyframe android:fraction="0.64" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="9.2" />
                    <keyframe android:fraction="0.73" android:interpolator="@android:interpolator/accelerate_quad" android:value="13.4" />
                    <keyframe android:fraction="0.79" android:interpolator="@android:interpolator/decelerate_quad" android:value="13.0" />
                    <keyframe android:fraction="0.85" android:interpolator="@android:interpolator/accelerate_quad" android:value="13.4" />
                    <keyframe android:fraction="1" android:value="13.4" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="-6" />
                    <keyframe android:fraction="0.36" android:value="-6" />
                    <keyframe android:fraction="0.42" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-4" />
                    <keyframe android:fraction="0.54" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="-16" />
                    <keyframe android:fraction="0.64" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-18" />
                    <keyframe android:fraction="0.73" android:interpolator="@android:interpolator/accelerate_quad" android:value="-6" />
                    <keyframe android:fraction="0.79" android:interpolator="@android:interpolator/decelerate_quad" android:value="-7.5" />
                    <keyframe android:fraction="0.85" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-6" />
                    <keyframe android:fraction="1" android:value="-6" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="hat_squash">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="4000" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.36" android:value="1" />
                    <keyframe android:fraction="0.42" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1.05" />
                    <keyframe android:fraction="0.48" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="0.96" />
                    <keyframe android:fraction="0.56" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1" />
                    <keyframe android:fraction="0.73" android:value="1" />
                    <keyframe android:fraction="0.76" android:interpolator="@android:interpolator/decelerate_quad" android:value="1.07" />
                    <keyframe android:fraction="0.81" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0.98" />
                    <keyframe android:fraction="0.87" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.36" android:value="1" />
                    <keyframe android:fraction="0.42" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0.9" />
                    <keyframe android:fraction="0.48" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="1.07" />
                    <keyframe android:fraction="0.56" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1" />
                    <keyframe android:fraction="0.73" android:value="1" />
                    <keyframe android:fraction="0.76" android:interpolator="@android:interpolator/decelerate_quad" android:value="0.88" />
                    <keyframe android:fraction="0.81" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1.04" />
                    <keyframe android:fraction="0.87" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <!-- The bow tie wiggles as the hat lands, then settles. -->
    <target android:name="bow_tie">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="4000" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.74" android:value="0" />
                    <keyframe android:fraction="0.78" android:interpolator="@android:interpolator/decelerate_quad" android:value="12" />
                    <keyframe android:fraction="0.83" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-8" />
                    <keyframe android:fraction="0.88" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="4" />
                    <keyframe android:fraction="0.93" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-1.5" />
                    <keyframe android:fraction="0.97" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="medal">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1800" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="rotation" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="-5" android:valueTo="5" android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="spark_1">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="1300" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="scaleX" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="2" android:valueTo="0.8" android:valueType="floatType" />
                <objectAnimator android:duration="1300" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="scaleY" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="2" android:valueTo="0.8" android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="spark_2">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="1700" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="scaleX" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="1.4" android:valueTo="0.6" android:valueType="floatType" />
                <objectAnimator android:duration="1700" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="scaleY" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="1.4" android:valueTo="0.6" android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="spark_3">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="1000" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="scaleX" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="1.5" android:valueTo="0.3" android:valueType="floatType" />
                <objectAnimator android:duration="1000" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="scaleY" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="1.5" android:valueTo="0.3" android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
