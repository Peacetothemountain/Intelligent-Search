            <!-- Two candy corns dropped under the G -->
            <group android:translateX="20" android:translateY="42" android:rotation="-28">
                <path android:fillColor="#FFF5A800"
                    android:pathData="M-1.3,0.6C-1.1,-0.4 -0.5,-1.7 0,-2.2C0.5,-1.7 1.1,-0.4 1.3,0.6C0.5,0.95 -0.5,0.95 -1.3,0.6Z" />
                <path android:fillColor="#FFF57C1F"
                    android:pathData="M-0.92,-0.25C-0.65,-1 -0.35,-1.7 0,-2.2C0.35,-1.7 0.65,-1 0.92,-0.25C0.3,-0.08 -0.3,-0.08 -0.92,-0.25Z" />
