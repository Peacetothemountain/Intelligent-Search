                <path android:fillColor="#FFF8B4C4"
                    android:pathData="M-3.25,-0.3a0.62,0.38 0,1 0,1.24 0a0.62,0.38 0,1 0,-1.24 0Z M1.65,-0.3a0.62,0.38 0,1 0,1.24 0a0.62,0.38 0,1 0,-1.24 0Z" />
