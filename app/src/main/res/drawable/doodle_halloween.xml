                    <keyframe android:fraction="0.26" android:interpolator="@android:interpolator/decelerate_quad" android:value="1.08" />
                    <keyframe android:fraction="0.36" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1" />
                    <keyframe android:fraction="0.4" android:interpolator="@android:interpolator/accelerate_quad" android:value="0.84" />
                    <keyframe android:fraction="0.46" android:interpolator="@android:interpolator/decelerate_quad" android:value="1.04" />
                    <keyframe android:fraction="0.52" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="42.4" />
                    <keyframe android:fraction="0.2" android:value="42.4" />
