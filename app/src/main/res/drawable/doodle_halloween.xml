                    android:pathData="M-0.45,-1.3C-0.3,-1.65 -0.15,-1.95 0,-2.2C0.15,-1.95 0.3,-1.65 0.45,-1.3C0.15,-1.2 -0.15,-1.2 -0.45,-1.3Z" />
