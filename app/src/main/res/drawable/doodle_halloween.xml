<?xml version="1.0" encoding="utf-8"?>
<!--
    Halloween: under a crescent moon a little bat flits over the G, a friendly ghost floats beside it waving and
    blinking, and a glowing jack-o'-lantern gives a happy hop and wobbles back to rest.

    Every doodle is a 48dp square drawn around the widget's own 24dp G, which spans 12 to 36 here and is left alone,
    so the doodle works with any G icon style. Colours read on light and dark pills alike. The animations loop; the
    static values are the first frame.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="48dp"
            android:height="48dp"
            android:viewportWidth="48"
            android:viewportHeight="48">

            <!-- Crescent moon, top right, with two craters -->
            <path android:fillColor="#FFFDD663" android:strokeColor="#FFF2A600" android:strokeWidth="0.5"
                android:pathData="M35.5,4.5A3.6,3.6 0,1 1,35.5,11.5A4.06,4.06 0,0 0,35.5,4.5Z" />
            <path android:fillColor="#FFF6C440"
                android:pathData="M37.6,7.2a0.55,0.55 0,1 0,1.1 0a0.55,0.55 0,1 0,-1.1 0Z M37.2,9.9a0.38,0.38 0,1 0,0.76 0a0.38,0.38 0,1 0,-0.76 0Z" />

            <!-- Twinkling stars -->
            <group android:name="star_a" android:translateX="30.5" android:translateY="3.6">
                <path android:fillColor="#FFFBBC04"
                    android:pathData="M0,-1.5Q0.22,-0.22 1.5,0Q0.22,0.22 0,1.5Q-0.22,0.22 -1.5,0Q-0.22,-0.22 0,-1.5Z" />
            </group>
            <group android:name="star_b" android:translateX="42.2" android:translateY="16.4" android:scaleX="0.7" android:scaleY="0.7">
                <path android:fillColor="#FFFBBC04"
                    android:pathData="M0,-1.5Q0.22,-0.22 1.5,0Q0.22,0.22 0,1.5Q-0.22,0.22 -1.5,0Q-0.22,-0.22 0,-1.5Z" />
            </group>

            <!-- Ghost, floating to the left of the G -->
            <group android:name="ghost" android:translateX="7" android:translateY="26.6">
                <group android:name="ghost_arm" android:pivotX="-3.9" android:pivotY="0">
                    <path android:fillColor="#FFFFFFFF" android:strokeColor="#FFA9AEC4" android:strokeWidth="0.5"
                        android:pathData="M-3.8,1C-4.9,0.8 -5.8,-0.3 -5.9,-1.5C-5.95,-2.3 -5,-2.6 -4.7,-1.9C-4.4,-1.2 -4.1,-1 -3.8,-1Z" />
                </group>
                <path android:fillColor="#FFFFFFFF"
                    android:pathData="M-4,-1.2C-4,-3.6 -2.2,-5.4 0,-5.4C2.2,-5.4 4,-3.6 4,-1.2L4.3,4.4C3.7,5.4 3.1,5.4 2.6,4.6C2.1,5.5 1.3,5.5 0.9,4.6C0.4,5.5 -0.4,5.5 -0.9,4.6C-1.3,5.5 -2.1,5.5 -2.6,4.6C-3.1,5.4 -3.7,5.4 -4.3,4.4Z" />
                <path android:fillColor="#FFDDE1EE"
