                <group android:name="bat_wing_right" android:pivotX="0.9" android:pivotY="0.4">
                    <path android:fillColor="#FF7444CF"
                        android:pathData="M0.9,0.2C1.9,-2 3.9,-2.9 5.2,-2.2C4.6,-1.5 4.4,-0.7 4.5,0.1C3.6,-0.3 2.9,0 2.5,0.7C2.1,0.2 1.5,0.3 0.9,0.9Z" />
                </group>
                <path android:fillColor="#FF9466EA"
                    android:pathData="M-1.5,0.4a1.5,1.7 0,1 0,3 0a1.5,1.7 0,1 0,-3 0Z M-1.35,-0.6L-1.15,-2.1L-0.35,-1.15Z M1.35,-0.6L1.15,-2.1L0.35,-1.15Z" />
                <path android:fillColor="#FF7A50D6"
                    android:pathData="M0.9,-0.6C1.4,-0.2 1.6,0.6 1.4,1.2C1.1,1.8 0.4,2.1 -0.2,2.1C0.7,1.4 1.1,0.3 0.9,-0.6Z" />
                <path android:fillColor="#FFFFFFFF"
                    android:pathData="M-1.05,0a0.42,0.42 0,1 0,0.84 0a0.42,0.42 0,1 0,-0.84 0Z M0.21,0a0.42,0.42 0,1 0,0.84 0a0.42,0.42 0,1 0,-0.84 0Z M-0.45,1.05L-0.25,1.55L-0.05,1.05Z M0.05,1.05L0.25,1.55L0.45,1.05Z" />
                <path android:fillColor="#FF3C4043"
                    android:pathData="M-0.75,0.08a0.2,0.2 0,1 0,0.4 0a0.2,0.2 0,1 0,-0.4 0Z M0.45,0.08a0.2,0.2 0,1 0,0.4 0a0.2,0.2 0,1 0,-0.4 0Z" />
            </group>
        </vector>
    </aapt:attr>

    <!-- 3.6s: the bat loops a lazy figure over the G, banking into its turns. -->
    <target android:name="bat">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="3600" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="translateX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="22" />
                    <keyframe android:fraction="0.25" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="27" />
                    <keyframe android:fraction="0.5" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="25" />
                    <keyframe android:fraction="0.75" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="19.5" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="22" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="7.4" />
                    <keyframe android:fraction="0.25" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="5.6" />
                    <keyframe android:fraction="0.5" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="8.6" />
                    <keyframe android:fraction="0.75" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="6" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="7.4" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.15" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="8" />
                    <keyframe android:fraction="0.4" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-6" />
                    <keyframe android:fraction="0.65" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-9" />
                    <keyframe android:fraction="0.88" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="6" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="bat_wing_left">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="360" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="scaleY"
                android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="1" android:valueTo="-0.45" android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="bat_wing_right">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="360" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="scaleY"
                android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="1" android:valueTo="-0.45" android:valueType="floatType" />
        </aapt:attr>
    </target>

    <!-- 3.6s: the ghost bobs twice, its sway trailing the bob, and waves once. -->
    <target android:name="ghost">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="3600" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="26.6" />
                    <keyframe android:fraction="0.25" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="25" />
                    <keyframe android:fraction="0.5" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="26.6" />
                    <keyframe android:fraction="0.75" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="25" />
