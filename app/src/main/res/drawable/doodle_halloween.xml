                    <keyframe android:fraction="0" android:value="-3" />
                    <keyframe android:fraction="0.08" android:interpolator="@android:interpolator/decelerate_quad" android:value="-4" />
                    <keyframe android:fraction="0.33" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="4" />
