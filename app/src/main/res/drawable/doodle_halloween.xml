                <path android:fillColor="#FFFFF4DC"
                    android:pathData="M-0.45,-1.3C-0.3,-1.65 -0.15,-1.95 0,-2.2C0.15,-1.95 0.3,-1.65 0.45,-1.3C0.15,-1.2 -0.15,-1.2 -0.45,-1.3Z" />
            </group>

            <!-- Jack-o'-lantern, bottom right; its pivot is the middle of its base -->
            <group android:name="pumpkin" android:translateX="37" android:translateY="42.4">
                <path android:fillColor="#FFD35A0A"
                    android:pathData="M-4.3,-3.2a2.4,3.2 0,1 0,4.8 0a2.4,3.2 0,1 0,-4.8 0Z M-0.5,-3.2a2.4,3.2 0,1 0,4.8 0a2.4,3.2 0,1 0,-4.8 0Z" />
                <path android:fillColor="#FFF27A1A"
                    android:pathData="M-4.1,-3.45a2.15,2.85 0,1 0,4.3 0a2.15,2.85 0,1 0,-4.3 0Z M-0.5,-3.45a2.15,2.85 0,1 0,4.3 0a2.15,2.85 0,1 0,-4.3 0Z" />
                <path android:fillColor="#FFE06810"
                    android:pathData="M-2.4,-3.2a2.4,3.2 0,1 0,4.8 0a2.4,3.2 0,1 0,-4.8 0Z" />
                <path android:fillColor="#FFFB8C2E"
                    android:pathData="M-2.4,-3.38a2.2,3 0,1 0,4.4 0a2.2,3 0,1 0,-4.4 0Z" />
                <path android:strokeColor="#FFFFC58A" android:strokeWidth="0.55" android:strokeLineCap="round"
                    android:pathData="M-3.4,-5.1C-3.8,-4.5 -3.95,-3.8 -3.85,-3.1" />
                <path android:fillColor="#FF4F7A28"
                    android:pathData="M-0.55,-6.1C-0.65,-7 -0.35,-7.9 0.35,-8.3L1.05,-7.8C0.55,-7.4 0.45,-6.8 0.55,-6.1Z" />
                <path android:strokeColor="#FF34A853" android:strokeWidth="0.45" android:strokeLineCap="round"
                    android:pathData="M0.6,-7C1.6,-7.1 2.4,-7.8 2.05,-8.6C1.8,-9.1 1.2,-8.9 1.35,-8.4" />
                <path android:fillColor="#FF8F3505"
                    android:pathData="M-2.3,-3.6L-0.75,-3.6L-1.25,-5.05Z M0.55,-3.6L2.1,-3.6L1.05,-5.05Z M-0.5,-2.85L0.3,-2.85L-0.1,-3.35Z M-2.5,-2.35C-1.4,-1.55 1.2,-1.55 2.3,-2.35C2,-0.75 -2.2,-0.75 -2.5,-2.35Z" />
