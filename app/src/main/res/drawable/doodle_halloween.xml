                    <path android:fillColor="#FFFFFFFF"
                        android:pathData="M-1.75,-2.05a0.22,0.22 0,1 0,0.44 0a0.22,0.22 0,1 0,-0.44 0Z M0.95,-2.05a0.22,0.22 0,1 0,0.44 0a0.22,0.22 0,1 0,-0.44 0Z" />
