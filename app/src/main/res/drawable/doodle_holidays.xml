<?xml version="1.0" encoding="utf-8"?>
<!-- Happy Holidays: a string of lights is draped over the G, its bulbs twinkling out of step, and the lid of a
     present beside it keeps hopping. See doodle_halloween.xml for the layout. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="48dp"
            android:height="48dp"
            android:viewportWidth="48"
            android:viewportHeight="48">

            <!-- The wire sags across the top and rests on the G's shoulder. -->
            <path
                android:pathData="M6,8Q19,20 32,8Q39.5,16 47,8"
                android:strokeColor="#FF80868B"
                android:strokeLineCap="round"
                android:strokeWidth="0.6" />

            <group android:translateX="11.2" android:translateY="11.6">
                <path android:fillColor="#FF5F6368" android:pathData="M-0.65,0L0.65,0L0.65,1.1L-0.65,1.1Z" />
                <path android:name="bulb_1" android:fillColor="#FFEA4335" android:pathData="M0,1C1.3,1.6 1.4,3.5 0,4.5C-1.4,3.5 -1.3,1.6 0,1Z" />
            </group>
            <group android:translateX="19" android:translateY="13.8">
                <path android:fillColor="#FF5F6368" android:pathData="M-0.65,0L0.65,0L0.65,1.1L-0.65,1.1Z" />
                <path android:name="bulb_2" android:fillColor="#FFFBBC04" android:pathData="M0,1C1.3,1.6 1.4,3.5 0,4.5C-1.4,3.5 -1.3,1.6 0,1Z" />
            </group>
            <group android:translateX="26.8" android:translateY="11.6">
                <path android:fillColor="#FF5F6368" android:pathData="M-0.65,0L0.65,0L0.65,1.1L-0.65,1.1Z" />
                <path android:name="bulb_3" android:fillColor="#FF34A853" android:pathData="M0,1C1.3,1.6 1.4,3.5 0,4.5C-1.4,3.5 -1.3,1.6 0,1Z" />
            </group>
            <group android:translateX="35.75" android:translateY="10.8">
                <path android:fillColor="#FF5F6368" android:pathData="M-0.65,0L0.65,0L0.65,1.1L-0.65,1.1Z" />
                <path android:name="bulb_4" android:fillColor="#FF4285F4" android:pathData="M0,1C1.3,1.6 1.4,3.5 0,4.5C-1.4,3.5 -1.3,1.6 0,1Z" />
            </group>
            <group android:translateX="44" android:translateY="10.3">
                <path android:fillColor="#FF5F6368" android:pathData="M-0.65,0L0.65,0L0.65,1.1L-0.65,1.1Z" />
                <path android:name="bulb_5" android:fillColor="#FFFA7B17" android:pathData="M0,1C1.3,1.6 1.4,3.5 0,4.5C-1.4,3.5 -1.3,1.6 0,1Z" />
            </group>

            <!-- Present -->
            <group
                android:translateX="41"
                android:translateY="38">
                <path
                    android:fillColor="#FFEA4335"
                    android:pathData="M-3.5,-1.5L3.5,-1.5L3.5,4L-3.5,4Z" />
                <path
                    android:fillColor="#FFFBBC04"
                    android:pathData="M-0.6,-1.5L0.6,-1.5L0.6,4L-0.6,4Z" />
                <group android:name="lid">
                    <path
                        android:fillColor="#FFC5221F"
                        android:pathData="M-4.2,-3.2L4.2,-3.2L4.2,-1.5L-4.2,-1.5Z" />
                    <path
                        android:fillColor="#FFFBBC04"
                        android:pathData="M-0.6,-3.2L0.6,-3.2L0.6,-1.5L-0.6,-1.5Z M0,-3.2C-1.6,-5.4 -3.4,-4.2 -1.7,-3.2Z M0,-3.2C1.6,-5.4 3.4,-4.2 1.7,-3.2Z" />
                </group>
            </group>
        </vector>
    </aapt:attr>

    <!-- Twinkling, each bulb at its own pace so they never blink together. -->
    <target android:name="bulb_1">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="900" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="fillAlpha" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="1" android:valueTo="0.35" android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="bulb_2">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1300" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="fillAlpha" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="0.4" android:valueTo="1" android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="bulb_3">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1100" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="fillAlpha" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="1" android:valueTo="0.4" android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="bulb_4">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1500" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="fillAlpha" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="0.35" android:valueTo="1" android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="bulb_5">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1000" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="fillAlpha" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="1" android:valueTo="0.35" android:valueType="floatType" />
        </aapt:attr>
    </target>

    <!-- The lid rests, then jumps twice, as if something inside can't wait. -->
    <target android:name="lid">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="2600" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.7" android:value="0" />
                    <keyframe android:fraction="0.76" android:interpolator="@android:interpolator/decelerate_quad" android:value="-2.6" />
                    <keyframe android:fraction="0.82" android:interpolator="@android:interpolator/accelerate_quad" android:value="0" />
                    <keyframe android:fraction="0.86" android:interpolator="@android:interpolator/decelerate_quad" android:value="-1.2" />
                    <keyframe android:fraction="0.9" android:interpolator="@android:interpolator/accelerate_quad" android:value="0" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.7" android:value="0" />
                    <keyframe android:fraction="0.76" android:value="-8" />
                    <keyframe android:fraction="0.82" android:value="0" />
                    <keyframe android:fraction="0.86" android:value="5" />
                    <keyframe android:fraction="0.9" android:value="0" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
