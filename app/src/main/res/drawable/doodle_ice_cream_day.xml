                </group>
            </group>
            <group
                android:name="cherry"
                android:rotation="0"
                android:scaleY="1"
                android:translateX="42.2"
                android:translateY="18.1">
                <path
                    android:pathData="M0.2,-1.6Q0.6,-3.4 2,-4.1"
                    android:strokeColor="#FF188038"
                    android:strokeLineCap="round"
                    android:strokeWidth="0.4" />
                <path
                    android:fillColor="#FFC5221F"
                    android:pathData="M-1.25,-0.9a1.25,1.25 0,1 0,2.5 0a1.25,1.25 0,1 0,-2.5 0Z" />
                <path
                    android:fillColor="#FFEA4335"
                    android:pathData="M-1.2,-1.05a1.05,1.05 0,1 0,2.1 0a1.05,1.05 0,1 0,-2.1 0Z" />
                <path
                    android:fillAlpha="0.75"
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M-0.85,-1.45a0.3,0.3 0,1 0,0.6 0a0.3,0.3 0,1 0,-0.6 0Z" />
            </group>

            <!-- Sparkles -->
            <path
                android:name="sparkle_1"
                android:fillAlpha="1"
                android:fillColor="#FFFBBC04"
                android:pathData="M36.8,15.299999999999999Q36.998,16.201999999999998 37.9,16.4Q36.998,16.598 36.8,17.5Q36.602,16.598 35.699999999999996,16.4Q36.602,16.201999999999998 36.8,15.299999999999999Z" />
            <path
                android:name="sparkle_2"
                android:fillAlpha="0.15"
                android:fillColor="#FFFBBC04"
                android:pathData="M10.6,19.700000000000003Q10.762,20.438000000000002 11.5,20.6Q10.762,20.762 10.6,21.5Q10.437999999999999,20.762 9.7,20.6Q10.437999999999999,20.438000000000002 10.6,19.700000000000003Z" />
        </vector>
    </aapt:attr>

    <!-- The cherry crouches, hops with a spin and lands; the scoops squash in turn and wobble back. -->
    <target android:name="cherry">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="3200"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="18.1" />
                    <keyframe android:fraction="0.24" android:value="18.1" />
                    <keyframe android:fraction="0.3" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="18.5" />
                    <keyframe android:fraction="0.4" android:interpolator="@android:interpolator/decelerate_quad" android:value="13.4" />
                    <keyframe android:fraction="0.5" android:interpolator="@android:interpolator/accelerate_quad" android:value="18.1" />
                    <keyframe android:fraction="0.54" android:interpolator="@android:interpolator/decelerate_quad" android:value="18.6" />
                    <keyframe android:fraction="0.62" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="18.1" />
                    <keyframe android:fraction="1" android:value="18.1" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.3" android:value="0" />
                    <keyframe android:fraction="0.5" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-360" />
                    <keyframe android:fraction="1" android:value="-360" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.24" android:value="1" />
                    <keyframe android:fraction="0.3" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="0.8" />
                    <keyframe android:fraction="0.36" android:interpolator="@android:interpolator/decelerate_quad" android:value="1.1" />
                    <keyframe android:fraction="0.46" android:value="1" />
                    <keyframe android:fraction="0.5" android:value="1" />
                    <keyframe android:fraction="0.54" android:interpolator="@android:interpolator/decelerate_quad" android:value="0.8" />
                    <keyframe android:fraction="0.62" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="scoop_top">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="3200"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.5" android:value="1" />
                    <keyframe android:fraction="0.56" android:interpolator="@android:interpolator/decelerate_quad" android:value="0.84" />
                    <keyframe android:fraction="0.65" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="1.06" />
                    <keyframe android:fraction="0.74" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.5" android:value="1" />
                    <keyframe android:fraction="0.56" android:interpolator="@android:interpolator/decelerate_quad" android:value="1.1" />
                    <keyframe android:fraction="0.65" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="0.97" />
                    <keyframe android:fraction="0.74" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="scoop_middle">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="3200"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.54" android:value="1" />
                    <keyframe android:fraction="0.6" android:interpolator="@android:interpolator/decelerate_quad" android:value="0.84" />
                    <keyframe android:fraction="0.69" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="1.06" />
                    <keyframe android:fraction="0.78" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.54" android:value="1" />
                    <keyframe android:fraction="0.6" android:interpolator="@android:interpolator/decelerate_quad" android:value="1.1" />
                    <keyframe android:fraction="0.69" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="0.97" />
                    <keyframe android:fraction="0.78" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="scoop_bottom">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="3200"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.58" android:value="1" />
                    <keyframe android:fraction="0.64" android:interpolator="@android:interpolator/decelerate_quad" android:value="0.84" />
                    <keyframe android:fraction="0.73" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="1.06" />
                    <keyframe android:fraction="0.82" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.58" android:value="1" />
                    <keyframe android:fraction="0.64" android:interpolator="@android:interpolator/decelerate_quad" android:value="1.1" />
                    <keyframe android:fraction="0.73" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="0.97" />
                    <keyframe android:fraction="0.82" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- The drip creeps down and lets go of a drop. -->
    <target android:name="drip">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="3200"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.45" />
                    <keyframe android:fraction="0.55" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="1" />
                    <keyframe android:fraction="0.66" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="0.4" />
                    <keyframe android:fraction="1" android:value="0.45" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="drop">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="3200"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.62" android:value="0" />
                    <keyframe android:fraction="0.64" android:interpolator="@android:interpolator/decelerate_quad" android:value="1" />
                    <keyframe android:fraction="0.84" android:value="1" />
                    <keyframe android:fraction="0.841" android:value="0" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.62" android:value="0" />
                    <keyframe android:fraction="0.64" android:interpolator="@android:interpolator/decelerate_quad" android:value="1" />
                    <keyframe android:fraction="0.84" android:value="1.2" />
                    <keyframe android:fraction="0.841" android:value="0" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="37.6" />
                    <keyframe android:fraction="0.64" android:value="37.6" />
                    <keyframe android:fraction="0.84" android:interpolator="@android:interpolator/accelerate_quad" android:value="50" />
                    <keyframe android:fraction="0.841" android:value="37.6" />
                    <keyframe android:fraction="1" android:value="37.6" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- The lolly gives a happy wiggle now and then. -->
    <target android:name="lolly">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="3200"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="-12" />
                    <keyframe android:fraction="0.66" android:value="-12" />
                    <keyframe android:fraction="0.72" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="-20" />
                    <keyframe android:fraction="0.78" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-4" />
                    <keyframe android:fraction="0.84" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-16" />
                    <keyframe android:fraction="0.9" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-10" />
                    <keyframe android:fraction="0.96" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="-12" />
                    <keyframe android:fraction="1" android:value="-12" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- Sparkles twinkle. -->
    <target android:name="sparkle_1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1600"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite"
                android:repeatMode="reverse">
                <propertyValuesHolder android:propertyName="fillAlpha" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0.1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="sparkle_2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1900"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite"
                android:repeatMode="reverse">
                <propertyValuesHolder android:propertyName="fillAlpha" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.15" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
