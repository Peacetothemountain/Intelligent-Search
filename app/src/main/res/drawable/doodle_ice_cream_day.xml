                        android:pathData="M40.9,19.6L41.9,19.6L41.7,20.5L41.1,20.5Z M43.4,18.9L44.2,19.5L43.6,20.1L43,19.5Z M41.5,17.1L42.4,17.4L42.2,17.9L41.4,17.6Z" />
