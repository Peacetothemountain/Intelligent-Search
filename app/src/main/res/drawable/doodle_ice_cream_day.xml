<?xml version="1.0" encoding="utf-8"?>
<!-- National Ice Cream Day: a cone of strawberry, mint and vanilla on the right wobbles like jelly when its cherry
     hops and lands, and drips a little, while an ice lolly wiggles on the left. See doodle_halloween.xml for the layout. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="48dp"
            android:height="48dp"
            android:viewportWidth="48"
            android:viewportHeight="48">

            <!-- Ice lolly -->
            <group
                android:name="lolly"
                android:rotation="-12"
                android:translateX="6.6"
                android:translateY="34.6">
                <path
                    android:fillColor="#FFB5713A"
                    android:pathData="M-0.6,-1L0.6,-1L0.6,3.2Q0,3.8 -0.6,3.2Z" />
                <path
                    android:fillColor="#FFE8710A"
                    android:pathData="M-2.7,-8.4Q-2.7,-11 0,-11Q2.7,-11 2.7,-8.4L2.7,-0.6Q2.7,0 2.1,0L-2.1,0Q-2.7,0 -2.7,-0.6Z" />
                <path
                    android:fillColor="#FFFA7B17"
                    android:pathData="M-2.7,-8.4Q-2.7,-11 0,-11Q1.8,-11 1.8,-8.4L1.8,0L-2.1,0Q-2.7,0 -2.7,-0.6Z" />
                <path
