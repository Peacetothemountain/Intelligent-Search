                    android:pathData="M-2.7,-3.6L2.7,-3.6L2.7,-0.6Q2.7,0 2.1,0L-2.1,0Q-2.7,0 -2.7,-0.6Z" />
                <path
                    android:fillAlpha="0.55"
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M-1.9,-8.6Q-1.9,-10 -0.9,-10.1L-0.9,-4.6L-1.9,-4.6Z" />
            </group>

            <!-- Cone -->
            <path
                android:fillColor="#FFE37400"
                android:pathData="M38.2,34.2L45.8,34.2L42.3,46.8Q42,47.3 41.7,46.8Z" />
            <path
                android:fillColor="#FFF9AB00"
                android:pathData="M38.2,34.2L43.6,34.2L42,47.2Q41.8,47.1 41.7,46.8Z" />
            <path
                android:pathData="M39.2,35.8L44.6,38.8 M39.9,38.4L43.9,40.6 M40.6,41L43.2,42.4 M44.9,35.8L39.5,38.8 M44.2,38.4L40.2,40.6 M43.5,41L40.9,42.4"
