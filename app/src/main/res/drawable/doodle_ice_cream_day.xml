                android:strokeWidth="0.35" />

            <!-- A drip running down the cone, and the drop that falls from it -->
            <group
                android:name="drop"
                android:scaleX="0"
                android:scaleY="0"
                android:translateX="39.4"
                android:translateY="37.6">
                <path
                    android:fillColor="#FFE52592"
                    android:pathData="M0,-0.9Q0.65,0 0.55,0.3A0.55,0.55 0,0 1,-0.55 0.3Q-0.65,0 0,-0.9Z" />
            </group>
            <group
                android:name="drip"
                android:scaleY="0.45"
                android:translateX="39.4"
                android:translateY="33.6">
                <path
                    android:fillColor="#FFFF8BCB"
                    android:pathData="M-0.65,0L0.65,0L0.65,3.2A0.65,0.65 0,0 1,-0.65 3.2Z" />
            </group>

            <!-- Scoops, bottom up, then the cherry -->
            <group
                android:name="scoop_bottom"
                android:scaleX="1"
                android:scaleY="1"
                android:translateX="42"
                android:translateY="33.6">
                <path
                    android:fillColor="#FFFF8BCB"
                    android:pathData="M-3.7,-3.33A3.7,3.7 0,0 1,3.7 -3.33Q3.885,0 2.035,-0.05Q1.11,0.6 0,-0.05Q-1.295,0.5 -2.22,-0.05Q-3.885,0 -3.7,-3.33Z" />
                <path
                    android:fillAlpha="0.55"
                    android:fillColor="#FFE52592"
                    android:pathData="M-3.626,-2.22Q0,-0.555 3.626,-2.22Q3.885,0 2.035,-0.05Q1.11,0.6 0,-0.05Q-1.295,0.5 -2.22,-0.05Q-3.885,0 -3.626,-2.22Z" />
                <path
                    android:fillAlpha="0.6"
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M-2.886,-4.625a1.406,0.6 0,1 0,2.812 0a1.406,0.6 0,1 0,-2.812 0Z" />
            </group>
            <group
                android:name="scoop_middle"
                android:scaleX="1"
                android:scaleY="1"
                android:translateX="42"
                android:translateY="27.6">
                <path
                    android:fillColor="#FF81C995"
                    android:pathData="M-3.45,-3.105A3.45,3.45 0,0 1,3.45 -3.105Q3.623,0 1.898,-0.05Q1.035,0.6 0,-0.05Q-1.208,0.5 -2.07,-0.05Q-3.623,0 -3.45,-3.105Z" />
                <path
                    android:fillAlpha="0.55"
                    android:fillColor="#FF34A853"
                    android:pathData="M-3.381,-2.07Q0,-0.517 3.381,-2.07Q3.623,0 1.898,-0.05Q1.035,0.6 0,-0.05Q-1.208,0.5 -2.07,-0.05Q-3.623,0 -3.381,-2.07Z" />
                <path
                    android:fillAlpha="0.6"
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M-2.691,-4.313a1.311,0.55 0,1 0,2.622 0a1.311,0.55 0,1 0,-2.622 0Z" />
            </group>
            <group
                android:name="scoop_top"
                android:scaleX="1"
                android:scaleY="1"
                android:translateX="42"
                android:translateY="21.9">
                <path
                    android:fillColor="#FFFEEFC3"
                    android:pathData="M-3.2,-2.88A3.2,3.2 0,0 1,3.2 -2.88Q3.36,0 1.76,-0.05Q0.96,0.6 0,-0.05Q-1.12,0.5 -1.92,-0.05Q-3.36,0 -3.2,-2.88Z" />
                <path
                    android:fillAlpha="0.55"
                    android:fillColor="#FFFDD663"
                    android:pathData="M-3.136,-1.92Q0,-0.48 3.136,-1.92Q3.36,0 1.76,-0.05Q0.96,0.6 0,-0.05Q-1.12,0.5 -1.92,-0.05Q-3.36,0 -3.136,-1.92Z" />
                <path
                    android:fillAlpha="0.6"
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M-2.496,-4a1.216,0.5 0,1 0,2.432 0a1.216,0.5 0,1 0,-2.432 0Z" />
                <group
                    android:translateX="-42"
                    android:translateY="-21.9">
                    <path
