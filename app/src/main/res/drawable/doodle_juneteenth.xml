<?xml version="1.0" encoding="utf-8"?>
<!-- Juneteenth: a celebration of freedom. After the Juneteenth flag, a bright star glows inside a turning red
     burst beside the G over a new horizon, and red, gold and green fireworks bloom one after another around it. See
     doodle_halloween.xml for the layout. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="48dp"
            android:height="48dp"
            android:viewportWidth="48"
            android:viewportHeight="48">

            <!-- New horizon -->
            <path
                android:fillColor="#FF1967D2"
                android:pathData="M31.4,48Q38.6,42 48.5,41.8L48.5,48Z" />
            <path
                android:fillColor="#FFC5221F"
                android:pathData="M32.8,48Q39.6,43 48.5,42.9L48.5,48Z" />
            <path
                android:fillColor="#FFEA4335"
                android:pathData="M33.6,48Q40.2,43.6 48.5,43.5L48.5,48Z" />

            <!-- Fireworks -->
            <group
                android:name="burst_green"
                android:scaleX="1.011"
                android:scaleY="1.011"
                android:translateX="7.6"
                android:translateY="22.4">
                <path
                    android:name="burst_green_rays"
                    android:pathData="M2.2,0L4.2,0 M1.905,1.1L3.637,2.1 M1.1,1.905L2.1,3.637 M0,2.2L0,4.2 M-1.1,1.905L-2.1,3.637 M-1.905,1.1L-3.637,2.1 M-2.2,0L-4.2,0 M-1.905,-1.1L-3.637,-2.1 M-1.1,-1.905L-2.1,-3.637 M0,-2.2L0,-4.2 M1.1,-1.905L2.1,-3.637 M1.905,-1.1L3.637,-2.1"
                    android:strokeAlpha="1"
                    android:strokeColor="#FF34A853"
                    android:strokeLineCap="round"
                    android:strokeWidth="0.55" />
                <path
                    android:fillColor="#FFFBBC04"
                    android:pathData="M-0.6,0a0.6,0.6 0,1 0,1.2 0a0.6,0.6 0,1 0,-1.2 0Z M0.806,0.65a0.32,0.32 0,1 0,0.64 0a0.32,0.32 0,1 0,-0.64 0Z M-0.32,1.3a0.32,0.32 0,1 0,0.64 0a0.32,0.32 0,1 0,-0.64 0Z M-1.446,0.65a0.32,0.32 0,1 0,0.64 0a0.32,0.32 0,1 0,-0.64 0Z M-1.446,-0.65a0.32,0.32 0,1 0,0.64 0a0.32,0.32 0,1 0,-0.64 0Z M-0.32,-1.3a0.32,0.32 0,1 0,0.64 0a0.32,0.32 0,1 0,-0.64 0Z M0.806,-0.65a0.32,0.32 0,1 0,0.64 0a0.32,0.32 0,1 0,-0.64 0Z" />
            </group>
            <group
                android:name="burst_gold"
                android:scaleX="0"
                android:scaleY="0"
                android:translateX="19.4"
                android:translateY="5.4">
                <path
                    android:name="burst_gold_rays"
                    android:pathData="M2.2,0L4.2,0 M1.905,1.1L3.637,2.1 M1.1,1.905L2.1,3.637 M0,2.2L0,4.2 M-1.1,1.905L-2.1,3.637 M-1.905,1.1L-3.637,2.1 M-2.2,0L-4.2,0 M-1.905,-1.1L-3.637,-2.1 M-1.1,-1.905L-2.1,-3.637 M0,-2.2L0,-4.2 M1.1,-1.905L2.1,-3.637 M1.905,-1.1L3.637,-2.1"
                    android:strokeAlpha="1"
                    android:strokeColor="#FFFBBC04"
                    android:strokeLineCap="round"
                    android:strokeWidth="0.55" />
                <path
                    android:fillColor="#FFEA4335"
                    android:pathData="M-0.6,0a0.6,0.6 0,1 0,1.2 0a0.6,0.6 0,1 0,-1.2 0Z M0.806,0.65a0.32,0.32 0,1 0,0.64 0a0.32,0.32 0,1 0,-0.64 0Z M-0.32,1.3a0.32,0.32 0,1 0,0.64 0a0.32,0.32 0,1 0,-0.64 0Z M-1.446,0.65a0.32,0.32 0,1 0,0.64 0a0.32,0.32 0,1 0,-0.64 0Z M-1.446,-0.65a0.32,0.32 0,1 0,0.64 0a0.32,0.32 0,1 0,-0.64 0Z M-0.32,-1.3a0.32,0.32 0,1 0,0.64 0a0.32,0.32 0,1 0,-0.64 0Z M0.806,-0.65a0.32,0.32 0,1 0,0.64 0a0.32,0.32 0,1 0,-0.64 0Z" />
            </group>
            <group
                android:name="burst_red"
                android:scaleX="0"
                android:scaleY="0"
                android:translateX="43.6"
                android:translateY="27.4">
                <path
                    android:name="burst_red_rays"
                    android:pathData="M2.2,0L4.2,0 M1.905,1.1L3.637,2.1 M1.1,1.905L2.1,3.637 M0,2.2L0,4.2 M-1.1,1.905L-2.1,3.637 M-1.905,1.1L-3.637,2.1 M-2.2,0L-4.2,0 M-1.905,-1.1L-3.637,-2.1 M-1.1,-1.905L-2.1,-3.637 M0,-2.2L0,-4.2 M1.1,-1.905L2.1,-3.637 M1.905,-1.1L3.637,-2.1"
                    android:strokeAlpha="1"
                    android:strokeColor="#FFEA4335"
                    android:strokeLineCap="round"
                    android:strokeWidth="0.55" />
                <path
                    android:fillColor="#FF34A853"
                    android:pathData="M-0.6,0a0.6,0.6 0,1 0,1.2 0a0.6,0.6 0,1 0,-1.2 0Z M0.806,0.65a0.32,0.32 0,1 0,0.64 0a0.32,0.32 0,1 0,-0.64 0Z M-0.32,1.3a0.32,0.32 0,1 0,0.64 0a0.32,0.32 0,1 0,-0.64 0Z M-1.446,0.65a0.32,0.32 0,1 0,0.64 0a0.32,0.32 0,1 0,-0.64 0Z M-1.446,-0.65a0.32,0.32 0,1 0,0.64 0a0.32,0.32 0,1 0,-0.64 0Z M-0.32,-1.3a0.32,0.32 0,1 0,0.64 0a0.32,0.32 0,1 0,-0.64 0Z M0.806,-0.65a0.32,0.32 0,1 0,0.64 0a0.32,0.32 0,1 0,-0.64 0Z" />
            </group>

            <!-- Star and burst -->
            <path
                android:name="star_glow"
                android:fillAlpha="0.7"
                android:pathData="M31,12a9,9 0,1 0,18 0a9,9 0,1 0,-18 0Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="radial"
                        android:centerX="40"
                        android:centerY="12"
                        android:gradientRadius="9"
                        android:startColor="#99FDE293"
                        android:endColor="#00FDE293" />
                </aapt:attr>
            </path>
            <group
                android:name="nova"
                android:rotation="0"
                android:translateX="40"
                android:translateY="12">
                <path
                    android:pathData="M0,-6.4L1.113,-4.153L3.2,-5.543L3.041,-3.041L5.543,-3.2L4.153,-1.113L6.4,0L4.153,1.113L5.543,3.2L3.041,3.041L3.2,5.543L1.113,4.153L0,6.4L-1.113,4.153L-3.2,5.543L-3.041,3.041L-5.543,3.2L-4.153,1.113L-6.4,0L-4.153,-1.113L-5.543,-3.2L-3.041,-3.041L-3.2,-5.543L-1.113,-4.153Z"
                    android:strokeColor="#FFEA4335"
                    android:strokeLineJoin="round"
                    android:strokeWidth="0.7" />
            </group>
            <group
                android:name="star"
                android:scaleX="1"
                android:scaleY="1"
                android:translateX="40"
                android:translateY="12">
                <path
                    android:fillColor="#FF1967D2"
                    android:pathData="M0,-3.25L0.864,-0.939L3.329,-0.832L1.398,0.704L2.057,3.082L0,1.72L-2.057,3.082L-1.398,0.704L-3.329,-0.832L-0.864,-0.939Z" />
                <path
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M0,-3L0.741,-1.019L2.853,-0.927L1.198,0.389L1.763,2.427L0,1.26L-1.763,2.427L-1.198,0.389L-2.853,-0.927L-0.741,-1.019Z" />
            </group>
        </vector>
    </aapt:attr>

    <!-- The burst turns slowly around the star, which pulses gently, glowing. -->
    <target android:name="nova">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="8000"
                android:interpolator="@android:interpolator/linear"
                android:propertyName="rotation"
                android:repeatCount="infinite"
                android:valueFrom="0"
                android:valueTo="30"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="star">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1800"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite"
                android:repeatMode="reverse">
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1.12" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1.12" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="star_glow">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1800"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite"
                android:repeatMode="reverse">
                <propertyValuesHolder android:propertyName="fillAlpha" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.7" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- Fireworks bloom, drift and fade in turn. -->
    <target android:name="burst_green">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="4200"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1.011" />
                    <keyframe android:fraction="0.2" android:value="1.12" />
                    <keyframe android:fraction="0.201" android:value="0" />
                    <keyframe android:fraction="0.86" android:value="0" />
                    <keyframe android:fraction="0.861" android:value="0" />
                    <keyframe android:fraction="0.98" android:interpolator="@android:interpolator/decelerate_quad" android:value="1" />
                    <keyframe android:fraction="1" android:value="1.011" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1.011" />
                    <keyframe android:fraction="0.2" android:value="1.12" />
                    <keyframe android:fraction="0.201" android:value="0" />
                    <keyframe android:fraction="0.86" android:value="0" />
                    <keyframe android:fraction="0.861" android:value="0" />
                    <keyframe android:fraction="0.98" android:interpolator="@android:interpolator/decelerate_quad" android:value="1" />
                    <keyframe android:fraction="1" android:value="1.011" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="burst_green_rays">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="4200"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="strokeAlpha" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.2" android:interpolator="@android:interpolator/accelerate_quad" android:value="0" />
                    <keyframe android:fraction="0.201" android:value="1" />
                    <keyframe android:fraction="0.86" android:value="1" />
                    <keyframe android:fraction="0.861" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="burst_gold">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="4200"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.53" android:value="0" />
                    <keyframe android:fraction="0.531" android:value="0" />
                    <keyframe android:fraction="0.65" android:interpolator="@android:interpolator/decelerate_quad" android:value="1" />
                    <keyframe android:fraction="0.87" android:value="1.12" />
                    <keyframe android:fraction="0.871" android:value="0" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.53" android:value="0" />
                    <keyframe android:fraction="0.531" android:value="0" />
                    <keyframe android:fraction="0.65" android:interpolator="@android:interpolator/decelerate_quad" android:value="1" />
                    <keyframe android:fraction="0.87" android:value="1.12" />
                    <keyframe android:fraction="0.871" android:value="0" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="burst_gold_rays">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="4200"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="strokeAlpha" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.53" android:value="1" />
                    <keyframe android:fraction="0.531" android:value="1" />
                    <keyframe android:fraction="0.67" android:value="1" />
                    <keyframe android:fraction="0.87" android:interpolator="@android:interpolator/accelerate_quad" android:value="0" />
                    <keyframe android:fraction="0.871" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="burst_red">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="4200"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.2" android:value="0" />
                    <keyframe android:fraction="0.201" android:value="0" />
                    <keyframe android:fraction="0.32" android:interpolator="@android:interpolator/decelerate_quad" android:value="1" />
                    <keyframe android:fraction="0.54" android:value="1.12" />
                    <keyframe android:fraction="0.541" android:value="0" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.2" android:value="0" />
                    <keyframe android:fraction="0.201" android:value="0" />
                    <keyframe android:fraction="0.32" android:interpolator="@android:interpolator/decelerate_quad" android:value="1" />
                    <keyframe android:fraction="0.54" android:value="1.12" />
                    <keyframe android:fraction="0.541" android:value="0" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="burst_red_rays">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="4200"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="strokeAlpha" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.2" android:value="1" />
                    <keyframe android:fraction="0.201" android:value="1" />
                    <keyframe android:fraction="0.34" android:value="1" />
                    <keyframe android:fraction="0.54" android:interpolator="@android:interpolator/accelerate_quad" android:value="0" />
                    <keyframe android:fraction="0.541" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
