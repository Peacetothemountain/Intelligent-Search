            </group>
        </vector>
    </aapt:attr>

    <!-- A squash to wind up, a hop with a little spin, a squashy landing and a rest. -->
    <target android:name="crown">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="3600"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="12.4" />
                    <keyframe android:fraction="0.2" android:value="12.4" />
                    <keyframe android:fraction="0.27" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="12.8" />
                    <keyframe android:fraction="0.38" android:interpolator="@android:interpolator/decelerate_quad" android:value="8.6" />
                    <keyframe android:fraction="0.49" android:interpolator="@android:interpolator/accelerate_quad" android:value="12.4" />
                    <keyframe android:fraction="0.53" android:interpolator="@android:interpolator/decelerate_quad" android:value="12.7" />
                    <keyframe android:fraction="0.6" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="12.4" />
                    <keyframe android:fraction="1" android:value="12.4" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="-14" />
                    <keyframe android:fraction="0.2" android:value="-14" />
                    <keyframe android:fraction="0.27" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="-10" />
                    <keyframe android:fraction="0.38" android:interpolator="@android:interpolator/decelerate_quad" android:value="4" />
                    <keyframe android:fraction="0.49" android:interpolator="@android:interpolator/accelerate_quad" android:value="-16" />
                    <keyframe android:fraction="0.58" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="-13" />
                    <keyframe android:fraction="0.66" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="-14" />
                    <keyframe android:fraction="1" android:value="-14" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.2" android:value="1" />
                    <keyframe android:fraction="0.27" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="0.82" />
                    <keyframe android:fraction="0.32" android:interpolator="@android:interpolator/decelerate_quad" android:value="1.1" />
                    <keyframe android:fraction="0.42" android:value="1" />
                    <keyframe android:fraction="0.49" android:value="1" />
                    <keyframe android:fraction="0.53" android:interpolator="@android:interpolator/decelerate_quad" android:value="0.84" />
                    <keyframe android:fraction="0.62" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="1.04" />
                    <keyframe android:fraction="0.7" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.2" android:value="1" />
                    <keyframe android:fraction="0.27" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="1.12" />
                    <keyframe android:fraction="0.32" android:interpolator="@android:interpolator/decelerate_quad" android:value="0.94" />
                    <keyframe android:fraction="0.42" android:value="1" />
                    <keyframe android:fraction="0.49" android:value="1" />
                    <keyframe android:fraction="0.53" android:interpolator="@android:interpolator/decelerate_quad" android:value="1.1" />
                    <keyframe android:fraction="0.62" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="0.98" />
                    <keyframe android:fraction="0.7" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- Balloons bob and lean, out of step with each other. -->
