                <path
                    android:fillColor="#FF4285F4"
                    android:fillType="evenOdd"
                    android:pathData="M-3.1,0a3.1,3.1 0,1 0,6.2 0a3.1,3.1 0,1 0,-6.2 0Z M-1.1,0a1.1,1.1 0,1 0,2.2 0a1.1,1.1 0,1 0,-2.2 0Z" />
                <path
                    android:fillColor="#FF8AB4F8"
                    android:pathData="M-2.1,-1.6a0.9,0.5 0,1 0,1.8 0a0.9,0.5 0,1 0,-1.8 0Z" />
            </group>
            <group
                android:name="gear_small"
                android:rotation="25.714"
                android:translateX="9.45"
                android:translateY="29.05">
                <path
                    android:fillColor="#FFC5221F"
                    android:fillType="evenOdd"
                    android:pathData="M2.182,-0.55L2.969,-0.429L2.969,0.429L2.182,0.55A2.25,2.25 0,0 1,1.79,1.363L1.79,1.363L2.187,2.054L1.516,2.589L0.931,2.049A2.25,2.25 0,0 1,0.05,2.249L0.05,2.249L-0.242,2.99L-1.079,2.799L-1.021,2.005A2.25,2.25 0,0 1,-1.727,1.442L-1.727,1.442L-2.489,1.675L-2.861,0.901L-2.204,0.451A2.25,2.25 0,0 1,-2.204,-0.451L-2.204,-0.451L-2.861,-0.901L-2.489,-1.675L-1.727,-1.442A2.25,2.25 0,0 1,-1.021,-2.005L-1.021,-2.005L-1.079,-2.799L-0.242,-2.99L0.05,-2.249A2.25,2.25 0,0 1,0.931,-2.049L0.931,-2.049L1.516,-2.589L2.187,-2.054L1.79,-1.363A2.25,2.25 0,0 1,2.182,-0.55Z M-0.7,0a0.7,0.7 0,1 0,1.4 0a0.7,0.7 0,1 0,-1.4 0Z" />
                <path
                    android:fillColor="#FFEA4335"
                    android:fillType="evenOdd"
                    android:pathData="M-1.85,0a1.85,1.85 0,1 0,3.7 0a1.85,1.85 0,1 0,-3.7 0Z M-0.7,0a0.7,0.7 0,1 0,1.4 0a0.7,0.7 0,1 0,-1.4 0Z" />
                <path
                    android:fillColor="#FFF28B82"
                    android:pathData="M-1.25,-1a0.55,0.3 0,1 0,1.1 0a0.55,0.3 0,1 0,-1.1 0Z" />
            </group>

            <!-- Nut and wrench -->
            <group
                android:name="nut"
                android:rotation="0"
                android:scaleX="1.4"
                android:scaleY="1.4"
                android:translateX="40.4"
                android:translateY="41.4">
                <path
                    android:fillColor="#FF80868B"
                    android:pathData="M1.472,0.85L0,1.7L-1.472,0.85L-1.472,-0.85L0,-1.7L1.472,-0.85Z" />
                <path
                    android:fillColor="#FFBDC1C6"
                    android:pathData="M-0.75,0a0.75,0.75 0,1 0,1.5 0a0.75,0.75 0,1 0,-1.5 0Z" />
            </group>
            <group
                android:name="wrench"
                android:rotation="-20"
                android:scaleX="1.4"
                android:scaleY="1.4"
                android:translateX="40.4"
                android:translateY="41.4">
                <path
                    android:fillColor="#FF5F6368"
                    android:pathData="M0.9,-0.75L8.6,-0.75Q9.4,0 8.6,0.75L0.9,0.75Z" />
                <path
                    android:fillColor="#FF80868B"
                    android:pathData="M0.9,-0.75L8.6,-0.75Q9.1,-0.4 9,0L0.9,0Z" />
                <path
                    android:pathData="M-1.6,-1.6A2.3,2.3 0,1 1,-1.6 1.6"
