                <path
                    android:pathData="M-0.4,-2.1A2.1,2.1 0,0 1,1.8 -1"
                    android:strokeColor="#FF9AA0A6"
                    android:strokeLineCap="round"
                    android:strokeWidth="0.4" />
            </group>
            <path
                android:name="shine"
                android:fillAlpha="0"
                android:fillColor="#FFFBBC04"
                android:pathData="M46.4,34.3Q46.598,35.202 47.5,35.4Q46.598,35.598 46.4,36.5Q46.202,35.598 45.3,35.4Q46.202,35.202 46.4,34.3Z M34.6,37.4Q34.744,38.056 35.4,38.2Q34.744,38.344 34.6,39Q34.456,38.344 33.8,38.2Q34.456,38.056 34.6,37.4Z" />

            <!-- Hard hat on the G -->
            <group
                android:name="hat"
                android:rotation="-8"
                android:translateX="24.4"
                android:translateY="12.8">
                <path
                    android:fillColor="#FFF29900"
                    android:pathData="M-5.6,0.2Q-5.6,-0.6 -4.8,-0.6L4.8,-0.6Q5.6,-0.6 5.6,0.2Q5.6,0.6 4.8,0.6L-4.8,0.6Q-5.6,0.6 -5.6,0.2Z" />
                <path
                    android:fillColor="#FFFBBC04"
                    android:pathData="M-4.2,-0.4C-4.2,-4.2 -2.4,-6 0,-6C2.4,-6 4.2,-4.2 4.2,-0.4Z" />
                <path
                    android:fillColor="#FFF29900"
                    android:pathData="M1.6,-0.4C2,-3 1.6,-5 0.6,-5.95C2.7,-5.7 4.2,-3.9 4.2,-0.4Z" />
                <path
                    android:fillColor="#FFFDD663"
                    android:pathData="M-0.7,-0.4L-0.7,-5.9Q0,-6.05 0.7,-5.9L0.7,-0.4Z" />
                <path
                    android:fillAlpha="0.6"
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M-3.4,-1.6Q-3.2,-3.8 -1.8,-4.8Q-2.6,-3.4 -2.7,-1.6Z" />
            </group>
        </vector>
    </aapt:attr>

    <!-- The gears turn together, tooth by tooth. -->
    <target android:name="gear_big">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="6000"
                android:interpolator="@android:interpolator/linear"
                android:propertyName="rotation"
                android:repeatCount="infinite"
                android:valueFrom="0"
                android:valueTo="360"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="gear_small">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="6000"
                android:interpolator="@android:interpolator/linear"
                android:propertyName="rotation"
                android:repeatCount="infinite"
                android:valueFrom="25.714"
                android:valueTo="-488.571"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <!-- The wrench pulls round, swings back for another bite and pulls again, then rests. -->
    <target android:name="wrench">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="3600"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="-20" />
                    <keyframe android:fraction="0.12" android:value="-20" />
                    <keyframe android:fraction="0.24" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="25" />
                    <keyframe android:fraction="0.3" android:value="25" />
                    <keyframe android:fraction="0.38" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-20" />
                    <keyframe android:fraction="0.42" android:value="-20" />
                    <keyframe android:fraction="0.54" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="25" />
                    <keyframe android:fraction="0.62" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="22" />
                    <keyframe android:fraction="0.72" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-20" />
                    <keyframe android:fraction="1" android:value="-20" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="nut">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="3600"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.12" android:value="0" />
                    <keyframe android:fraction="0.24" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="30" />
                    <keyframe android:fraction="0.42" android:value="30" />
                    <keyframe android:fraction="0.54" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="60" />
                    <keyframe android:fraction="1" android:value="60" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="shine">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="3600"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="fillAlpha" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.54" android:value="0" />
                    <keyframe android:fraction="0.6" android:interpolator="@android:interpolator/decelerate_quad" android:value="1" />
                    <keyframe android:fraction="0.8" android:interpolator="@android:interpolator/accelerate_quad" android:value="0" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- The G nods under its hat. -->
    <target android:name="hat">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="3600"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="-8" />
                    <keyframe android:fraction="0.62" android:value="-8" />
                    <keyframe android:fraction="0.7" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="-14" />
                    <keyframe android:fraction="0.78" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="-3" />
                    <keyframe android:fraction="0.86" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="-10" />
                    <keyframe android:fraction="0.94" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="-8" />
                    <keyframe android:fraction="1" android:value="-8" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="12.8" />
                    <keyframe android:fraction="0.62" android:value="12.8" />
                    <keyframe android:fraction="0.7" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="12.2" />
                    <keyframe android:fraction="0.78" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="13" />
                    <keyframe android:fraction="0.86" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="12.8" />
                    <keyframe android:fraction="1" android:value="12.8" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
