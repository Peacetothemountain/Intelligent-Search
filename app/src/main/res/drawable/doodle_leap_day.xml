<?xml version="1.0" encoding="utf-8"?>
<!-- Leap Day: a frog crouches on a lily pad, leaps over the G to the other pad, and hops back out of sight to do it
     again. See doodle_halloween.xml for the layout. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="48dp"
            android:height="48dp"
            android:viewportWidth="48"
            android:viewportHeight="48">

            <path
                android:fillColor="#FF1E8E3E"
                android:pathData="M4.6,40.6a4.4,1.5 0,1 0,8.8 0a4.4,1.5 0,1 0,-8.8 0Z M35.6,40.6a4.4,1.5 0,1 0,8.8 0a4.4,1.5 0,1 0,-8.8 0Z" />

            <!-- The frog, feet at y 3.5 (its pivot) so it squashes onto them. -->
            <group
                android:name="frog"
                android:pivotY="3.5"
                android:translateX="9"
                android:translateY="36">
                <path
                    android:fillColor="#FF1E8E3E"
                    android:pathData="M-4.2,3.4a1.5,0.9 0,1 0,3 0a1.5,0.9 0,1 0,-3 0Z M1.2,3.4a1.5,0.9 0,1 0,3 0a1.5,0.9 0,1 0,-3 0Z" />
                <path
                    android:fillColor="#FF34A853"
                    android:pathData="M-3.6,1a3.6,2.6 0,1 0,7.2 0a3.6,2.6 0,1 0,-7.2 0Z M-3.2,-1.4a1.4,1.4 0,1 0,2.8 0a1.4,1.4 0,1 0,-2.8 0Z M0.4,-1.4a1.4,1.4 0,1 0,2.8 0a1.4,1.4 0,1 0,-2.8 0Z" />
                <path
                    android:fillColor="#FFA8DAB5"
                    android:pathData="M-2.2,2a2.2,1.2 0,1 0,4.4 0a2.2,1.2 0,1 0,-4.4 0Z" />
                <path
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M-2.65,-1.5a0.85,0.85 0,1 0,1.7 0a0.85,0.85 0,1 0,-1.7 0Z M0.95,-1.5a0.85,0.85 0,1 0,1.7 0a0.85,0.85 0,1 0,-1.7 0Z" />
                <path
                    android:fillColor="#FF202124"
                    android:pathData="M-2,-1.4a0.45,0.45 0,1 0,0.9 0a0.45,0.45 0,1 0,-0.9 0Z M1.6,-1.4a0.45,0.45 0,1 0,0.9 0a0.45,0.45 0,1 0,-0.9 0Z" />
                <path
                    android:pathData="M-1.3,0.5Q0,1.3 1.3,0.5"
                    android:strokeColor="#FF0D652D"
                    android:strokeLineCap="round"
                    android:strokeWidth="0.45" />
            </group>
        </vector>
    </aapt:attr>

    <!-- 4s: crouch, leap (up fast, easing over the top, down onto the far pad), sit, slip away, reappear. -->
    <target android:name="frog">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="4000"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="translateX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="9" />
                    <keyframe android:fraction="0.2" android:value="9" />
                    <keyframe android:fraction="0.5" android:value="40" />
                    <keyframe android:fraction="0.86" android:value="40" />
                    <keyframe android:fraction="0.9" android:value="9" />
                    <keyframe android:fraction="1" android:value="9" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="36" />
                    <keyframe android:fraction="0.2" android:value="36" />
                    <keyframe android:fraction="0.35" android:interpolator="@android:interpolator/decelerate_quad" android:value="6" />
                    <keyframe android:fraction="0.5" android:interpolator="@android:interpolator/accelerate_quad" android:value="36" />
                    <keyframe android:fraction="1" android:value="36" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.2" android:value="0" />
                    <keyframe android:fraction="0.3" android:value="-12" />
                    <keyframe android:fraction="0.42" android:value="12" />
                    <keyframe android:fraction="0.5" android:value="0" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.14" android:value="1" />
                    <keyframe android:fraction="0.18" android:value="1.12" />
                    <keyframe android:fraction="0.21" android:value="0.92" />
                    <keyframe android:fraction="0.3" android:value="1" />
                    <keyframe android:fraction="0.48" android:value="1" />
                    <keyframe android:fraction="0.51" android:value="1.14" />
                    <keyframe android:fraction="0.56" android:value="1" />
                    <keyframe android:fraction="0.8" android:value="1" />
                    <keyframe android:fraction="0.86" android:value="0" />
                    <keyframe android:fraction="0.9" android:value="0" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.14" android:value="1" />
                    <keyframe android:fraction="0.18" android:value="0.8" />
                    <keyframe android:fraction="0.21" android:value="1.12" />
                    <keyframe android:fraction="0.3" android:value="1" />
                    <keyframe android:fraction="0.48" android:value="1" />
                    <keyframe android:fraction="0.51" android:value="0.8" />
                    <keyframe android:fraction="0.56" android:value="1" />
                    <keyframe android:fraction="0.8" android:value="1" />
                    <keyframe android:fraction="0.86" android:value="0" />
                    <keyframe android:fraction="0.9" android:value="0" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
