                    <keyframe android:fraction="0.4" android:value="44.6" />
                    <keyframe android:fraction="0.46" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="44.8" />
                    <keyframe android:fraction="0.55" android:interpolator="@android:interpolator/decelerate_quad" android:value="42" />
                    <keyframe android:fraction="0.64" android:interpolator="@android:interpolator/accelerate_quad" android:value="44.6" />
