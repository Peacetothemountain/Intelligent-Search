<?xml version="1.0" encoding="utf-8"?>
<!-- Martin Luther King Jr. Day: a quiet scene of hope. A dove carrying an olive branch glides gently above the
     G while the sun rises softly on the right, sending motes of light drifting up, and two small lights glow on the
     left. See doodle_halloween.xml for the layout. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="48dp"
            android:height="48dp"
            android:viewportWidth="48"
            android:viewportHeight="48">

            <!-- Rising sun -->
            <path
                android:name="sun_glow"
                android:fillAlpha="1"
                android:pathData="M30,45a11,11 0,1 0,22 0a11,11 0,1 0,-22 0Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="radial"
                        android:centerX="41"
                        android:centerY="45"
                        android:gradientRadius="11"
                        android:startColor="#99FBBC04"
                        android:endColor="#00FBBC04" />
                </aapt:attr>
            </path>
            <group
                android:name="sun"
                android:translateX="41"
                android:translateY="46">
                <group
                    android:name="sun_rays"
                    android:rotation="0">
                    <path
                        android:fillColor="#FFFDD663"
                        android:pathData="M-0.7,-6.4L0,-9.4L0.7,-6.4Z M2.594,-5.893L4.7,-8.141L3.806,-5.193Z M5.193,-3.806L8.141,-4.7L5.893,-2.594Z M6.4,-0.7L9.4,0L6.4,0.7Z M5.893,2.594L8.141,4.7L5.193,3.806Z M3.806,5.193L4.7,8.141L2.594,5.893Z M0.7,6.4L0,9.4L-0.7,6.4Z M-2.594,5.893L-4.7,8.141L-3.806,5.193Z M-5.193,3.806L-8.141,4.7L-5.893,2.594Z M-6.4,0.7L-9.4,0L-6.4,-0.7Z M-5.893,-2.594L-8.141,-4.7L-5.193,-3.806Z M-3.806,-5.193L-4.7,-8.141L-2.594,-5.893Z" />
                </group>
                <path
                    android:fillColor="#FFF9AB00"
                    android:pathData="M-5.2,0.3a5.2,5.2 0,1 0,10.4 0a5.2,5.2 0,1 0,-10.4 0Z" />
                <path
                    android:fillColor="#FFFBBC04"
                    android:pathData="M-5,0a5,5 0,1 0,10 0a5,5 0,1 0,-10 0Z" />
                <path
                    android:fillAlpha="0.9"
                    android:fillColor="#FFFDE293"
                    android:pathData="M-3,-2a1.3,1.3 0,1 0,2.6 0a1.3,1.3 0,1 0,-2.6 0Z" />
            </group>

            <!-- Motes of light rising from the sun -->
            <group
                android:name="mote_1"
                android:scaleX="0"
                android:scaleY="0"
                android:translateX="37.2"
                android:translateY="40">
                <path
                    android:fillColor="#FFFBBC04"
                    android:pathData="M0,-0.9Q0.162,-0.162 0.9,0Q0.162,0.162 0,0.9Q-0.162,0.162 -0.9,0Q-0.162,-0.162 0,-0.9Z" />
            </group>
            <group
                android:name="mote_2"
                android:scaleX="0.943"
                android:scaleY="0.943"
                android:translateX="43.4"
                android:translateY="32.52">
                <path
                    android:fillColor="#FFFBBC04"
                    android:pathData="M0,-0.9Q0.162,-0.162 0.9,0Q0.162,0.162 0,0.9Q-0.162,0.162 -0.9,0Q-0.162,-0.162 0,-0.9Z" />
            </group>
            <group
                android:name="mote_3"
                android:scaleX="0.471"
                android:scaleY="0.471"
                android:translateX="46.4"
                android:translateY="25.26">
                <path
                    android:fillColor="#FFFBBC04"
                    android:pathData="M0,-0.9Q0.162,-0.162 0.9,0Q0.162,0.162 0,0.9Q-0.162,0.162 -0.9,0Q-0.162,-0.162 0,-0.9Z" />
            </group>

            <!-- Lights on the left -->
            <path
                android:name="light_1"
                android:fillAlpha="1"
                android:fillColor="#FFFBBC04"
                android:pathData="M6,18.9Q6.198,19.802 7.1,20Q6.198,20.198 6,21.1Q5.802,20.198 4.9,20Q5.802,19.802 6,18.9Z" />
            <path
                android:name="light_2"
                android:fillAlpha="0.25"
                android:fillColor="#FFFBBC04"
                android:pathData="M9.4,29.6Q9.544,30.256 10.2,30.4Q9.544,30.544 9.4,31.2Q9.256,30.544 8.6,30.4Q9.256,30.256 9.4,29.6Z" />

            <!-- Dove -->
            <group
                android:name="dove"
                android:rotation="0"
                android:scaleX="1.15"
                android:scaleY="1.15"
                android:translateX="30"
                android:translateY="8">
                <path
                    android:pathData="M4.9,-0.9Q6,-0.6 6.9,0.4"
                    android:strokeColor="#FF188038"
                    android:strokeLineCap="round"
                    android:strokeWidth="0.35" />
                <path
                    android:fillColor="#FF34A853"
                    android:pathData="M5.6,-0.75C5.585,-1.39 6.134,-1.981 6.697,-1.932C6.648,-1.368 6.099,-0.777 5.6,-0.75Z M6.2,-0.4C6.807,-0.195 7.174,0.522 6.935,1.035C6.422,0.796 6.055,0.078 6.2,-0.4Z M6.8,0.3C7.347,-0.033 8.133,0.147 8.372,0.659C7.859,0.898 7.073,0.719 6.8,0.3Z" />
                <path
                    android:fillColor="#FFBDC1C6"
                    android:pathData="M4.3,-0.65C4,-1.45 2.9,-1.55 2.3,-0.85C1.7,-0.15 1.5,0.15 0.5,0.25C-1.2,0.35 -2.6,0.55 -3.6,-0.15L-5,-0.65L-4.4,0.65L-5.2,1.45L-3.5,1.35C-2,2.25 1,2.35 2.6,1.25C3.4,0.65 3.9,0.05 4.3,-0.65Z" />
                <path
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M4.3,-0.9C4,-1.7 2.9,-1.8 2.3,-1.1C1.7,-0.4 1.5,-0.1 0.5,0C-1.2,0.1 -2.6,0.3 -3.6,-0.4L-5,-0.9L-4.4,0.4L-5.2,1.2L-3.5,1.1C-2,2 1,2.1 2.6,1C3.4,0.4 3.9,-0.2 4.3,-0.9Z" />
                <path
                    android:fillColor="#FFE8EAED"
                    android:pathData="M-3.5,1.1C-2,2 1,2.1 2.6,1C3.4,0.4 3.9,-0.2 4.3,-0.9C3.6,0 2.4,0.9 0.6,1.2C-1,1.4 -2.4,1.2 -3.5,1.1Z" />
                <path
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M2.35,-1.25a0.95,0.95 0,1 0,1.9 0a0.95,0.95 0,1 0,-1.9 0Z" />
                <path
                    android:fillColor="#FFFBBC04"
                    android:pathData="M4.15,-1.3L5.2,-0.95L4.15,-0.7Z" />
                <path
                    android:fillColor="#FF5F6368"
                    android:pathData="M3.42,-1.4a0.18,0.18 0,1 0,0.36 0a0.18,0.18 0,1 0,-0.36 0Z" />
                <group
                    android:name="wing"
                    android:pivotX="0.4"
                    android:pivotY="-0.2"
                    android:rotation="0">
                    <path
                        android:fillColor="#FFBDC1C6"
                        android:pathData="M0.6,0.1C-0.4,-2.4 -2.6,-3.8 -4.6,-4C-3.6,-2.6 -2.8,-1.2 -1.6,0Z" />
                    <path
                        android:fillColor="#FFFFFFFF"
                        android:pathData="M0.6,-0.1C-0.4,-2.6 -2.6,-4 -4.6,-4.2C-3.6,-2.8 -2.8,-1.4 -1.6,-0.2Z" />
                    <path
                        android:fillColor="#FFE8EAED"
                        android:pathData="M-0.5,-0.2C-1.2,-1.6 -2.4,-2.8 -4.6,-4.2C-3.6,-2.8 -2.8,-1.4 -1.6,-0.2Z" />
                </group>
            </group>
        </vector>
    </aapt:attr>

    <!-- The dove glides slowly to and fro, rising and falling on the air. -->
    <target android:name="dove">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="5200"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="translateX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="30" />
                    <keyframe android:fraction="0.5" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="26.5" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="30" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="8" />
                    <keyframe android:fraction="0.25" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="6.8" />
                    <keyframe android:fraction="0.5" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="8.4" />
                    <keyframe android:fraction="0.75" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="7" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="8" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.25" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-4" />
                    <keyframe android:fraction="0.5" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="2" />
                    <keyframe android:fraction="0.75" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-3" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- It beats its wings in slow, easy strokes, with a glide between. -->
    <target android:name="wing">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="2600"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.15" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-28" />
                    <keyframe android:fraction="0.3" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="12" />
                    <keyframe android:fraction="0.45" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-24" />
                    <keyframe android:fraction="0.6" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- The sun breathes up and down and its rays turn slowly. -->
    <target android:name="sun">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="6000"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite"
                android:repeatMode="reverse">
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="46" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="44.6" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="sun_rays">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="9000"
                android:interpolator="@android:interpolator/linear"
                android:propertyName="rotation"
                android:repeatCount="infinite"
                android:valueFrom="0"
                android:valueTo="30"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="sun_glow">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="3000"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite"
                android:repeatMode="reverse">
                <propertyValuesHolder android:propertyName="fillAlpha" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0.6" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- Motes of light drift up and fade, one after another. -->
    <target android:name="mote_1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="4800"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="40" />
                    <keyframe android:fraction="1" android:value="18" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.3" android:interpolator="@android:interpolator/decelerate_quad" android:value="1" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_quad" android:value="0" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.3" android:interpolator="@android:interpolator/decelerate_quad" android:value="1" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_quad" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="mote_2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="4800"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="32.52" />
                    <keyframe android:fraction="0.66" android:value="18" />
                    <keyframe android:fraction="0.661" android:value="40" />
                    <keyframe android:fraction="1" android:value="32.52" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.943" />
                    <keyframe android:fraction="0.66" android:interpolator="@android:interpolator/accelerate_quad" android:value="0" />
                    <keyframe android:fraction="0.661" android:value="0" />
                    <keyframe android:fraction="0.96" android:interpolator="@android:interpolator/decelerate_quad" android:value="1" />
                    <keyframe android:fraction="1" android:value="0.943" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.943" />
                    <keyframe android:fraction="0.66" android:interpolator="@android:interpolator/accelerate_quad" android:value="0" />
                    <keyframe android:fraction="0.661" android:value="0" />
                    <keyframe android:fraction="0.96" android:interpolator="@android:interpolator/decelerate_quad" android:value="1" />
                    <keyframe android:fraction="1" android:value="0.943" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="mote_3">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="4800"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="25.26" />
                    <keyframe android:fraction="0.33" android:value="18" />
                    <keyframe android:fraction="0.331" android:value="40" />
                    <keyframe android:fraction="1" android:value="25.26" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.471" />
                    <keyframe android:fraction="0.33" android:interpolator="@android:interpolator/accelerate_quad" android:value="0" />
                    <keyframe android:fraction="0.331" android:value="0" />
                    <keyframe android:fraction="0.63" android:interpolator="@android:interpolator/decelerate_quad" android:value="1" />
                    <keyframe android:fraction="1" android:value="0.471" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.471" />
                    <keyframe android:fraction="0.33" android:interpolator="@android:interpolator/accelerate_quad" android:value="0" />
                    <keyframe android:fraction="0.331" android:value="0" />
                    <keyframe android:fraction="0.63" android:interpolator="@android:interpolator/decelerate_quad" android:value="1" />
                    <keyframe android:fraction="1" android:value="0.471" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- The small lights glow softly in turn. -->
    <target android:name="light_1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="2400"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite"
                android:repeatMode="reverse">
                <propertyValuesHolder android:propertyName="fillAlpha" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0.25" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="light_2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="2400"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite"
                android:repeatMode="reverse">
                <propertyValuesHolder android:propertyName="fillAlpha" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.25" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
