            <group android:name="mini_b" android:translateX="39.6" android:translateY="32" android:scaleX="0" android:scaleY="0">
                <path android:fillColor="#FFF06292" android:pathData="M0,1.5C-0.5,1.1 -1.65,0.35 -1.65,-0.5C-1.65,-1.1 -1.2,-1.5 -0.75,-1.5C-0.4,-1.5 -0.125,-1.3 0,-1C0.125,-1.3 0.4,-1.5 0.75,-1.5C1.2,-1.5 1.65,-1.1 1.65,-0.5C1.65,0.35 0.5,1.1 0,1.5Z" />
