                </group>

                <!-- Paper cone: light front, shaded right side, folded-back rim -->
                <path android:fillColor="#FF8AB4F8" android:pathData="M36.7,38.2L47.4,38.2L42.6,47L41.6,47Z" />
                <path android:fillColor="#FF669DF6" android:pathData="M42.4,38.2L47.4,38.2L42.6,47L42.2,47Z" />
                <path android:fillColor="#FF4285F4" android:pathData="M36.4,37.6Q42,38.6 47.7,37.6L47.3,38.9Q42,39.8 36.8,38.9Z" />
                <!-- Ribbon bow -->
                <path android:fillColor="#FFFBBC04" android:pathData="M42.1,43.4C40.6,42.1 39.3,42.5 39.5,43.5C39.7,44.5 41,44.3 42.1,43.4Z M42.1,43.4C43.6,42.1 44.9,42.5 44.7,43.5C44.5,44.5 43.2,44.3 42.1,43.4Z M41.9,43.6L40.9,45.6L41.7,45.3L42.1,43.8Z M42.3,43.6L43.3,45.6L42.5,45.3L42.1,43.8Z" />
                <path android:fillColor="#FFE37400" android:pathData="M41.5,43.4a0.6,0.6 0,1 0,1.2 0a0.6,0.6 0,1 0,-1.2 0Z" />
            </group>
        </vector>
    </aapt:attr>

    <!-- 4s loop. The bouquet sways once; each head trails the sway a little. -->
    <target android:name="bunch">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="4000" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="-2.5" />
                    <keyframe android:fraction="0.5" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="2.5" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-2.5" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="tulip_1">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="4000" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.25" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-4" />
                    <keyframe android:fraction="0.5" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                    <keyframe android:fraction="0.75" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="4" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="tulip_2">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="4000" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.05" android:interpolator="@android:interpolator/decelerate_quad" android:value="0" />
                    <keyframe android:fraction="0.3" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-3" />
                    <keyframe android:fraction="0.55" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                    <keyframe android:fraction="0.8" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="3" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_quad" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="tulip_3">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="4000" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.25" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-5" />
                    <keyframe android:fraction="0.5" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                    <keyframe android:fraction="0.75" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="5" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- The little hearts take turns: each grows out of the bouquet, drifts up and shrinks into the big heart. -->
    <target android:name="mini_a">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="4000" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="21.2" />
                    <keyframe android:fraction="0.2" android:value="14" />
                    <keyframe android:fraction="0.22" android:value="32" />
                    <keyframe android:fraction="0.7" android:value="32" />
                    <keyframe android:fraction="1" android:value="21.2" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="translateX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="41.2" />
                    <keyframe android:fraction="0.1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="40.3" />
                    <keyframe android:fraction="0.2" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="40" />
                    <keyframe android:fraction="0.7" android:value="42.6" />
                    <keyframe android:fraction="0.82" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="43.4" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="41.2" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.1" android:value="1" />
                    <keyframe android:fraction="0.2" android:interpolator="@android:interpolator/accelerate_quad" android:value="0" />
                    <keyframe android:fraction="0.7" android:value="0" />
                    <keyframe android:fraction="0.8" android:interpolator="@android:interpolator/overshoot" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.1" android:value="1" />
                    <keyframe android:fraction="0.2" android:interpolator="@android:interpolator/accelerate_quad" android:value="0" />
