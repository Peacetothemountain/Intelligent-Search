                    <keyframe android:fraction="0.17" android:value="1" />
                    <keyframe android:fraction="0.21" android:interpolator="@android:interpolator/decelerate_quad" android:value="1.16" />
                    <keyframe android:fraction="0.28" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0.95" />
                    <keyframe android:fraction="0.34" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1.04" />
                    <keyframe android:fraction="0.4" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1" />
                    <keyframe android:fraction="0.67" android:value="1" />
                    <keyframe android:fraction="0.71" android:interpolator="@android:interpolator/decelerate_quad" android:value="1.16" />
                    <keyframe android:fraction="0.78" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0.95" />
                    <keyframe android:fraction="0.84" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1.04" />
                    <keyframe android:fraction="0.9" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- Sparkles twinkle out of step with one another. -->
    <target android:name="spark_1">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="1400" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="scaleX" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="2.4" android:valueTo="1.1" android:valueType="floatType" />
                <objectAnimator android:duration="1400" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="scaleY" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="2.4" android:valueTo="1.1" android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="spark_2">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="1100" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="scaleX" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="1.8" android:valueTo="0.7" android:valueType="floatType" />
                <objectAnimator android:duration="1100" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="scaleY" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="1.8" android:valueTo="0.7" android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="spark_3">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="1700" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="scaleX" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="1.3" android:valueTo="1.9" android:valueType="floatType" />
                <objectAnimator android:duration="1700" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="scaleY" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="1.3" android:valueTo="1.9" android:valueType="floatType" />
