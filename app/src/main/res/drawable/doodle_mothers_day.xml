                </group>
                <group android:name="tulip_3" android:translateX="45.8" android:translateY="33.6" android:pivotY="1.6">
                    <path android:fillColor="#FFF29900" android:pathData="M-1.9,-1.7L-1.9,0C-1.9,2.1 1.9,2.1 1.9,0L1.9,-1.7L1,-0.8L0,-2.2L-1,-0.8Z" />
                    <path android:fillColor="#FFFBBC04" android:pathData="M-1.15,0.2C-1.15,-1 -0.5,-1.9 0,-2.4C0.5,-1.9 1.15,-1 1.15,0.2C1.15,1.6 -1.15,1.6 -1.15,0.2Z" />
