                <path android:fillColor="#FF34A853" android:pathData="M40.8,39C38.6,38.8 36.8,37.4 36.3,35.5C38.3,35.7 40.1,36.9 40.8,39Z M43.4,39C45.6,38.8 47.4,37.4 47.9,35.5C45.9,35.7 44.1,36.9 43.4,39Z" />
