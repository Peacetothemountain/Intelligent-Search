                <path android:fillAlpha="0.85" android:fillColor="#FFFCE4EC" android:pathData="M-2.75,-1.25C-2.75,-2 -2.2,-2.5 -1.6,-2.5C-1.25,-2.5 -1.1,-2.25 -1.35,-2.05C-1.85,-1.8 -2.15,-1.5 -2.3,-1.05C-2.45,-0.75 -2.75,-0.85 -2.75,-1.25Z" />
            </group>

            <!-- Little hearts that float up out of the bouquet -->
            <group android:name="mini_a" android:translateX="41.2" android:translateY="21.2" android:scaleX="1" android:scaleY="1">
                <path android:fillColor="#FFEA4335" android:pathData="M0,1.5C-0.5,1.1 -1.65,0.35 -1.65,-0.5C-1.65,-1.1 -1.2,-1.5 -0.75,-1.5C-0.4,-1.5 -0.125,-1.3 0,-1C0.125,-1.3 0.4,-1.5 0.75,-1.5C1.2,-1.5 1.65,-1.1 1.65,-0.5C1.65,0.35 0.5,1.1 0,1.5Z" />
