        <vector android:width="48dp" android:height="48dp" android:viewportWidth="48" android:viewportHeight="48">

            <!-- Sparkles on the left -->
            <group android:name="spark_1" android:translateX="8.4" android:translateY="13.4" android:scaleX="2.4" android:scaleY="2.4">
                <path android:fillColor="#FFF06292" android:pathData="M0,-1Q0.24,-0.24 1,0Q0.24,0.24 0,1Q-0.24,0.24 -1,0Q-0.24,-0.24 0,-1Z" />
            </group>
            <group android:name="spark_2" android:translateX="5.4" android:translateY="31.5" android:scaleX="1.8" android:scaleY="1.8">
                <path android:fillColor="#FFFBBC04" android:pathData="M0,-1Q0.24,-0.24 1,0Q0.24,0.24 0,1Q-0.24,0.24 -1,0Q-0.24,-0.24 0,-1Z" />
            </group>
            <group android:name="spark_3" android:translateX="15" android:translateY="5.6" android:scaleX="1.3" android:scaleY="1.3">
                <path android:fillColor="#FFA142F4" android:pathData="M0,-1Q0.24,-0.24 1,0Q0.24,0.24 0,1Q-0.24,0.24 -1,0Q-0.24,-0.24 0,-1Z" />
            </group>

