<?xml version="1.0" encoding="utf-8"?>
<!-- Talk Like a Pirate Day: the G wears a pirate hat that it tips in greeting, its feather trailing behind; a parrot
     on a treasure chest bobs and flaps, and a little ship rocks over rolling waves. See doodle_halloween.xml for the
     layout. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="48dp" android:height="48dp" android:viewportWidth="48" android:viewportHeight="48">

            <!-- Parrot perched on the chest, facing the G; its pivot is its feet -->
            <group android:name="parrot" android:translateX="11.2" android:translateY="36.9">
                <path android:fillColor="#FF4285F4" android:strokeColor="#FF1967D2" android:strokeWidth="0.3" android:strokeLineJoin="round"
                    android:pathData="M-1.2,-1.6L-3,3L-1.9,3.3L-0.1,-0.9Z" />
                <path android:fillColor="#FFEA4335"
                    android:pathData="M0.2,-7.6C2.2,-7.6 2.9,-5.8 2.6,-4.2C2.3,-2.4 1.4,-0.6 -0.2,0C-1.6,-0.6 -2.2,-2.8 -1.9,-4.6C-1.6,-6.4 -1,-7.6 0.2,-7.6Z" />
                <path android:fillColor="#FFC5221F"
                    android:pathData="M2.6,-4.4C2.3,-2.4 1.4,-0.6 -0.2,0C1,-1.4 1.8,-3 2.6,-4.4Z" />
                <group android:name="parrot_wing" android:pivotX="-0.7" android:pivotY="-4.6">
                    <path android:fillColor="#FF4285F4"
                        android:pathData="M-0.6,-4.8C0.9,-4.6 1.4,-2.8 0.6,-1.2C0.1,-0.4 -0.8,0.2 -1.4,0.4C-1.5,-1.4 -1.6,-3.6 -0.6,-4.8Z" />
                    <path android:fillColor="#FFFBBC04"
                        android:pathData="M-0.6,-4.8C0.6,-4.7 1.2,-3.8 1.1,-3.1C0.2,-3.3 -0.6,-3.3 -1.3,-3C-1.3,-3.7 -1.1,-4.3 -0.6,-4.8Z" />
                </group>
                <path android:fillColor="#FFFFFFFF"
                    android:pathData="M0.15,-6.3a0.8,0.8 0,1 0,1.6 0a0.8,0.8 0,1 0,-1.6 0Z" />
                <path android:fillColor="#FF3C4043"
                    android:pathData="M0.7,-6.3a0.38,0.4 0,1 0,0.76 0a0.38,0.4 0,1 0,-0.76 0Z" />
                <path android:fillColor="#FFFFE6A8" android:strokeColor="#FFB0875A" android:strokeWidth="0.3" android:strokeLineJoin="round"
                    android:pathData="M2.1,-6.6C3.3,-6.7 3.8,-5.8 3.4,-4.8C3.1,-5.3 2.7,-5.5 2.2,-5.4Z" />
                <path android:fillColor="#FF5F6368"
                    android:pathData="M2.2,-5.4C2.6,-5.4 2.9,-5.1 2.9,-4.7C2.5,-4.6 2.2,-4.9 2.2,-5.4Z" />
                <path android:strokeColor="#FF80868B" android:strokeWidth="0.45" android:strokeLineCap="round"
                    android:pathData="M-0.6,-0.3L-0.9,0.4 M0.4,-0.4L0.5,0.4" />
            </group>

            <!-- Treasure chest, bottom left, with a couple of coins beside it -->
            <group android:translateX="12.6" android:translateY="41.8">
                <path android:fillColor="#FFA0673F"
                    android:pathData="M-3.7,-3L3.7,-3L3.7,-0.4Q3.7,0 3.3,0L-3.3,0Q-3.7,0 -3.7,-0.4Z" />
                <path android:fillColor="#FF7E4E2E"
                    android:pathData="M1.9,-3L3.7,-3L3.7,-0.4Q3.7,0 3.3,0L1.9,0Z" />
                <path android:fillColor="#FFB97A4C"
                    android:pathData="M-3.9,-2.9C-3.9,-5.6 3.9,-5.6 3.9,-2.9Z" />
                <path android:fillColor="#FF8E5A36"
                    android:pathData="M1.6,-5C3,-4.7 3.9,-4 3.9,-2.9L1.9,-2.9C2,-3.6 1.9,-4.4 1.6,-5Z" />
                <path android:fillColor="#FFFBBC04" android:strokeColor="#FFE37400" android:strokeWidth="0.3"
                    android:pathData="M-2.8,-4.6L-2,-4.85L-2,0L-2.8,0Z M2,-4.85L2.8,-4.6L2.8,0L2,0Z M-3.9,-3.25L3.9,-3.25L3.9,-2.65L-3.9,-2.65Z M-0.75,-3.4L0.75,-3.4L0.75,-1.6L-0.75,-1.6Z" />
                <path android:fillColor="#FF7E4E2E"
                    android:pathData="M-0.22,-2.6a0.22,0.22 0,1 0,0.44 0a0.22,0.22 0,1 0,-0.44 0Z M-0.12,-2.5L0.12,-2.5L0.12,-2L-0.12,-2Z" />
                <path android:fillColor="#FFFBBC04" android:strokeColor="#FFE37400" android:strokeWidth="0.35"
                    android:pathData="M4.4,-0.55a1,0.55 0,1 0,2 0a1,0.55 0,1 0,-2 0Z M4.9,-1.3a0.95,0.5 0,1 0,1.9 0a0.95,0.5 0,1 0,-1.9 0Z" />
            </group>
            <group android:name="coin_glint" android:translateX="19.6" android:translateY="38.9" android:scaleX="0.8" android:scaleY="0.8">
                <path android:fillColor="#FFFBBC04"
                    android:pathData="M0,-1.5Q0.22,-0.22 1.5,0Q0.22,0.22 0,1.5Q-0.22,0.22 -1.5,0Q-0.22,-0.22 0,-1.5Z" />
            </group>

            <!-- Ship on a patch of sea, bottom right -->
            <path android:fillColor="#FF1A73E8"
                android:pathData="M28.4,42.2C28.6,41 39.6,40.4 40.4,41C40.2,42.6 37.6,44.2 34.4,44.4C31.4,44.5 28.6,43.6 28.4,42.2Z" />
            <group android:name="ship" android:translateX="34.6" android:translateY="41.6" android:rotation="-4">
                <path android:strokeColor="#FF6D4C41" android:strokeWidth="0.55"
                    android:pathData="M0,-1.8L0,-10.6" />
                <group android:name="ship_flag" android:translateY="-10.3">
                    <path android:fillColor="#FFEA4335"
                        android:pathData="M0,-0.4L3,0.1L0,0.65Z" />
                </group>
                <path android:fillColor="#FFFFFFFF" android:strokeColor="#FFB7BDC6" android:strokeWidth="0.35" android:strokeLineJoin="round"
                    android:pathData="M-3.4,-8.8L3.4,-8.8C3.8,-6.8 3.6,-4.6 3,-3.1C1,-2.6 -1,-2.6 -3,-3.1C-3.6,-4.6 -3.8,-6.8 -3.4,-8.8Z" />
                <path android:fillColor="#FFDDE3EC"
                    android:pathData="M1.3,-8.6L3.2,-8.6C3.6,-6.8 3.5,-4.7 2.85,-3.3C2.3,-3.1 1.7,-3 1.1,-2.95C1.8,-4.7 1.9,-6.9 1.3,-8.6Z" />
                <path android:strokeColor="#FF8D6E63" android:strokeWidth="0.5" android:strokeLineCap="round"
                    android:pathData="M-3.8,-8.8L3.8,-8.8" />
                <path android:fillColor="#FF9C6644"
                    android:pathData="M-4.8,-2L4.8,-2L3.3,1.1Q3.1,1.4 2.7,1.4L-2.7,1.4Q-3.1,1.4 -3.3,1.1Z" />
                <path android:fillColor="#FF7A4A30"
                    android:pathData="M-4.1,-0.4L4.1,-0.4L3.3,1.1Q3.1,1.4 2.7,1.4L-2.7,1.4Q-3.1,1.4 -3.3,1.1Z" />
                <path android:strokeColor="#FFFBBC04" android:strokeWidth="0.45"
                    android:pathData="M-4.45,-1.25L4.45,-1.25" />
            </group>
            <group>
                <clip-path android:pathData="M28.4,42.2C28.6,41 39.6,40.4 40.4,41C40.2,42.6 37.6,44.2 34.4,44.4C31.4,44.5 28.6,43.6 28.4,42.2Z" />
                <group android:name="waves">
                    <path android:fillColor="#FF4285F4" android:strokeColor="#FFAECBFA" android:strokeWidth="0.5" android:strokeLineCap="round"
                        android:pathData="M25,42.5Q26.5,41.7 28,42.5T31,42.5T34,42.5T37,42.5T40,42.5T43,42.5T46,42.5L46,46L25,46Z" />
                </group>
            </group>

            <!-- Pirate hat on top of the G; its pivot is the middle of its brim -->
            <group android:name="hat" android:translateX="24" android:translateY="13.6">
                <group android:name="hat_feather" android:translateX="4.6" android:translateY="-4.4">
                    <path android:fillColor="#FFEA4335" android:strokeColor="#FFC5221F" android:strokeWidth="0.35" android:strokeLineJoin="round"
                        android:pathData="M0,0C1.2,-2.4 3.8,-3.6 5.4,-3.1C4.4,-2.6 3.8,-1.8 3.4,-1.2C2.6,-1.3 1.8,-0.6 1.2,0.4Z" />
                    <path android:strokeColor="#FFC5221F" android:strokeWidth="0.3" android:strokeLineCap="round"
                        android:pathData="M0.4,0C1.6,-1.4 3.2,-2.4 4.8,-2.9" />
                </group>
                <path android:fillColor="#FF855640"
                    android:pathData="M-9,1.6C-7.5,-2 -4.5,-7 0,-7C4.5,-7 7.5,-2 9,1.6C6,-0.6 3,-1 0,-1C-3,-1 -6,-0.6 -9,1.6Z" />
                <path android:fillColor="#FF63402F"
                    android:pathData="M2.6,-6.6C5.6,-5.4 7.8,-1.8 9,1.6C7.8,0.5 6.5,-0.2 5.2,-0.5C5.1,-3 4.2,-5.2 2.6,-6.6Z" />
                <path android:strokeColor="#FFA97A5E" android:strokeWidth="0.45" android:strokeLineCap="round"
                    android:pathData="M-5.6,-3.4C-4.6,-5 -3.2,-6 -1.8,-6.3" />
                <path android:strokeColor="#FFFBBC04" android:strokeWidth="0.55" android:strokeLineCap="round"
                    android:pathData="M-8,0.7C-5.5,-1.1 -2.8,-1.6 0,-1.6C2.8,-1.6 5.5,-1.1 8,0.7" />
                <path android:strokeColor="#FFFFFFFF" android:strokeWidth="0.55" android:strokeLineCap="round"
                    android:pathData="M-1.8,-2.3L1.8,-4.5 M-1.8,-4.5L1.8,-2.3" />
                <path android:fillColor="#FFFFFFFF"
                    android:pathData="M-1.15,-4.5a1.15,1.05 0,1 0,2.3 0a1.15,1.05 0,1 0,-2.3 0Z M-0.65,-3.8L0.65,-3.8L0.65,-3.1L-0.65,-3.1Z" />
                <path android:fillColor="#FF63402F"
                    android:pathData="M-0.75,-4.55a0.32,0.32 0,1 0,0.64 0a0.32,0.32 0,1 0,-0.64 0Z M0.11,-4.55a0.32,0.32 0,1 0,0.64 0a0.32,0.32 0,1 0,-0.64 0Z" />
            </group>
        </vector>
    </aapt:attr>

    <!-- 3.6s: rest; dip; lift and tip the hat; hold; put it back with a little overshoot. -->
    <target android:name="hat">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="3600" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.46" android:value="0" />
                    <keyframe android:fraction="0.52" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="3" />
                    <keyframe android:fraction="0.62" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="-13" />
                    <keyframe android:fraction="0.72" android:value="-13" />
                    <keyframe android:fraction="0.81" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="3" />
                    <keyframe android:fraction="0.88" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="13.6" />
                    <keyframe android:fraction="0.46" android:value="13.6" />
                    <keyframe android:fraction="0.52" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="14" />
                    <keyframe android:fraction="0.62" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="11.4" />
                    <keyframe android:fraction="0.72" android:value="11.4" />
                    <keyframe android:fraction="0.8" android:interpolator="@android:interpolator/accelerate_quad" android:value="13.6" />
                    <keyframe android:fraction="0.84" android:interpolator="@android:interpolator/decelerate_quad" android:value="13.2" />
                    <keyframe android:fraction="0.88" android:interpolator="@android:interpolator/accelerate_quad" android:value="13.6" />
                    <keyframe android:fraction="1" android:value="13.6" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="hat_feather">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="3600" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.5" android:value="0" />
                    <keyframe android:fraction="0.56" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-6" />
                    <keyframe android:fraction="0.67" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="16" />
                    <keyframe android:fraction="0.75" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-4" />
                    <keyframe android:fraction="0.85" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-12" />
                    <keyframe android:fraction="0.92" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="4" />
                    <keyframe android:fraction="0.98" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- 3.6s: the parrot nods twice, rests, then stretches up and flaps. -->
    <target android:name="parrot">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="3600" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.08" android:value="0" />
                    <keyframe android:fraction="0.13" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="10" />
                    <keyframe android:fraction="0.18" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-2" />
                    <keyframe android:fraction="0.23" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="10" />
                    <keyframe android:fraction="0.3" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.66" android:value="1" />
                    <keyframe android:fraction="0.7" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0.9" />
                    <keyframe android:fraction="0.75" android:interpolator="@android:interpolator/decelerate_quad" android:value="1.08" />
                    <keyframe android:fraction="0.86" android:value="1.08" />
                    <keyframe android:fraction="0.92" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0.97" />
                    <keyframe android:fraction="0.97" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="parrot_wing">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="3600" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.74" android:value="0" />
                    <keyframe android:fraction="0.77" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-55" />
                    <keyframe android:fraction="0.8" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-10" />
                    <keyframe android:fraction="0.83" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-55" />
                    <keyframe android:fraction="0.88" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="coin_glint">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="3600" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.8" />
                    <keyframe android:fraction="0.1" android:interpolator="@android:interpolator/accelerate_quad" android:value="0" />
                    <keyframe android:fraction="0.5" android:value="0" />
                    <keyframe android:fraction="0.6" android:interpolator="@android:interpolator/decelerate_quad" android:value="1.1" />
                    <keyframe android:fraction="0.72" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0.8" />
                    <keyframe android:fraction="1" android:value="0.8" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.8" />
                    <keyframe android:fraction="0.1" android:interpolator="@android:interpolator/accelerate_quad" android:value="0" />
                    <keyframe android:fraction="0.5" android:value="0" />
                    <keyframe android:fraction="0.6" android:interpolator="@android:interpolator/decelerate_quad" android:value="1.1" />
                    <keyframe android:fraction="0.72" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0.8" />
                    <keyframe android:fraction="1" android:value="0.8" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.5" android:value="0" />
                    <keyframe android:fraction="0.72" android:interpolator="@android:interpolator/decelerate_quad" android:value="90" />
                    <keyframe android:fraction="1" android:value="90" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- The ship rocks twice and bobs three times a loop; the pennant flutters. -->
    <target android:name="ship">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="900" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="rotation"
                    android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="-4" android:valueTo="4" android:valueType="floatType" />
                <objectAnimator android:duration="600" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="translateY"
                    android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="41.6" android:valueTo="42.1" android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="ship_flag">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="300" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="scaleX"
                android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="1" android:valueTo="0.72" android:valueType="floatType" />
        </aapt:attr>
    </target>
    <!-- The waves repeat every 3 units, so sliding them that far loops. -->
    <target android:name="waves">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1200" android:interpolator="@android:interpolator/linear" android:propertyName="translateX"
                android:repeatCount="infinite" android:valueFrom="0" android:valueTo="-3" android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
