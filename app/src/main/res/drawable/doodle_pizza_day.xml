                    <keyframe android:fraction="0.56" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1.08" />
                    <keyframe android:fraction="0.66" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1" />
                    <keyframe android:fraction="0.68" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0.88" />
