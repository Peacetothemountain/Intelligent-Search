            <objectAnimator android:duration="3600" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="translateX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="42.4" />
                    <keyframe android:fraction="0.2" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="42.4" />
                    <keyframe android:fraction="0.34" android:interpolator="@android:interpolator/accelerate_quad" android:value="41" />
                    <keyframe android:fraction="0.72" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="41" />
                    <keyframe android:fraction="0.88" android:interpolator="@android:interpolator/decelerate_quad" android:value="42.6" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="42.4" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="32.4" />
                    <keyframe android:fraction="0.1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="32" />
