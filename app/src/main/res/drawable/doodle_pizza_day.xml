                <propertyValuesHolder android:propertyName="strokeAlpha" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.3" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1" />
                    <keyframe android:fraction="0.598" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                    <keyframe android:fraction="0.6" android:interpolator="@android:interpolator/linear" android:value="0" />
                    <keyframe android:fraction="0.9" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1" />
