                <path android:fillColor="#FFEA4335" android:strokeColor="#FFC5221F" android:strokeWidth="0.4" android:pathData="M-2.3,-2a2.3,2 0,1 0,4.6 0a2.3,2 0,1 0,-4.6 0Z" />
