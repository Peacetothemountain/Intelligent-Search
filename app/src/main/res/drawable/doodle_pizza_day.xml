<?xml version="1.0" encoding="utf-8"?>
<!-- National Pizza Day: a slice lifts off a hot pizza beside the G on a stretchy string of cheese, drops back and lifts
     again; steam curls up, and a tomato hops along by a drifting basil leaf.
     See doodle_halloween.xml for the layout. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="48dp" android:height="48dp" android:viewportWidth="48" android:viewportHeight="48">

            <!-- Plate and pizza -->
            <path android:fillColor="#FFF8F9FA" android:strokeColor="#FFBDC1C6" android:strokeWidth="0.4" android:pathData="M34.5,37.6a6.5,6.5 0,1 0,13 0a6.5,6.5 0,1 0,-13 0Z" />
            <group android:translateX="41" android:translateY="37.6">
                <path android:fillColor="#FFE6B57E" android:strokeColor="#FFC98A4B" android:strokeWidth="0.4" android:strokeLineJoin="round" android:pathData="M0,0L3.45,-4.41A5.6,5.6 0,1 1 -2.1,-5.19Z" />
