                    <keyframe android:fraction="0.34" android:interpolator="@android:interpolator/accelerate_quad" android:value="37.6" />
                    <keyframe android:fraction="0.37" android:interpolator="@android:interpolator/decelerate_quad" android:value="37.2" />
                    <keyframe android:fraction="0.4" android:interpolator="@android:interpolator/accelerate_quad" android:value="37.6" />
                    <keyframe android:fraction="0.72" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="37.6" />
                    <keyframe android:fraction="0.75" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="37.9" />
                    <keyframe android:fraction="0.88" android:interpolator="@android:interpolator/decelerate_quad" android:value="31.9" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="32.4" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="-10" />
                    <keyframe android:fraction="0.1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-12" />
                    <keyframe android:fraction="0.2" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-10" />
                    <keyframe android:fraction="0.34" android:interpolator="@android:interpolator/accelerate_quad" android:value="0" />
                    <keyframe android:fraction="0.72" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                    <keyframe android:fraction="0.88" android:interpolator="@android:interpolator/decelerate_quad" android:value="-12" />
                    <keyframe android:fraction="1" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-10" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="cheese">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="3600" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="trimPathEnd" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.2" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1" />
                    <keyframe android:fraction="0.32" android:interpolator="@android:interpolator/accelerate_quad" android:value="0" />
                    <keyframe android:fraction="0.76" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
