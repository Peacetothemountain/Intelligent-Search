<?xml version="1.0" encoding="utf-8"?>
<!-- First day of summer: a sun in sunglasses shines above the G, its rays turning, while a beach ball bounces
     beside it. See doodle_halloween.xml for the layout. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="48dp"
            android:height="48dp"
            android:viewportWidth="48"
            android:viewportHeight="48">

            <!-- Rays: eight, so turning an eighth of the way round loops seamlessly. -->
            <group
                android:name="rays"
                android:translateX="40"
                android:translateY="9">
                <path
                    android:pathData="M0,-5.4L0,-7.4 M0,5.4L0,7.4 M-5.4,0L-7.4,0 M5.4,0L7.4,0 M3.82,-3.82L5.23,-5.23 M-3.82,-3.82L-5.23,-5.23 M3.82,3.82L5.23,5.23 M-3.82,3.82L-5.23,5.23"
                    android:strokeColor="#FFFBBC04"
                    android:strokeLineCap="round"
                    android:strokeWidth="1.2" />
            </group>
            <group
                android:translateX="40"
                android:translateY="9">
                <path
                    android:fillColor="#FFFBBC04"
                    android:pathData="M-4,0a4,4 0,1 0,8 0a4,4 0,1 0,-8 0Z" />
                <path
                    android:fillColor="#FF3C4043"
                    android:pathData="M-3.2,-1.1L-0.4,-1.1L-0.6,0.5Q-1.8,1.5 -3,0.5Z M0.4,-1.1L3.2,-1.1L3,0.5Q1.8,1.5 0.6,0.5Z" />
                <path
                    android:pathData="M-0.5,-0.9L0.5,-0.9 M-1.4,1.9Q0,2.9 1.4,1.9"
                    android:strokeColor="#FF3C4043"
                    android:strokeLineCap="round"
                    android:strokeWidth="0.45" />
            </group>

            <!-- Beach ball: its shadow shrinks as it rises. -->
            <path
                android:name="shadow"
                android:fillAlpha="0.35"
                android:fillColor="#FF80868B"
                android:pathData="M39.6,43.6a2.4,0.6 0,1 0,4.8 0a2.4,0.6 0,1 0,-4.8 0Z" />
            <group
                android:name="ball"
                android:pivotY="3"
                android:translateX="42"
                android:translateY="40">
                <path
                    android:fillColor="#FFEA4335"
                    android:pathData="M-3,0a3,3 0,1 0,6 0a3,3 0,1 0,-6 0Z" />
                <path
                    android:fillColor="#FF4285F4"
                    android:pathData="M0,-3A3,3 0,0 1,0 3C1.6,1.5 1.6,-1.5 0,-3Z" />
                <path
                    android:fillColor="#FFFBBC04"
                    android:pathData="M0,-3C1.4,-1.5 1.4,1.5 0,3C-1.4,1.5 -1.4,-1.5 0,-3Z" />
                <path
                    android:fillAlpha="0.6"
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M-2.2,-1a0.7,0.5 0,1 0,1.4 0a0.7,0.5 0,1 0,-1.4 0Z" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="rays">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="2400" android:interpolator="@android:interpolator/linear" android:propertyName="rotation" android:repeatCount="infinite" android:valueFrom="0" android:valueTo="45" android:valueType="floatType" />
                <objectAnimator android:duration="1200" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="scaleX" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="1" android:valueTo="1.12" android:valueType="floatType" />
                <objectAnimator android:duration="1200" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="scaleY" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="1" android:valueTo="1.12" android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <!-- 1.1s bounce: squashed on landing, up and over, back down. -->
    <target android:name="ball">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1100" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="40" />
                    <keyframe android:fraction="0.1" android:value="40" />
                    <keyframe android:fraction="0.5" android:interpolator="@android:interpolator/decelerate_quad" android:value="33" />
                    <keyframe android:fraction="0.9" android:interpolator="@android:interpolator/accelerate_quad" android:value="40" />
                    <keyframe android:fraction="1" android:value="40" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.82" />
                    <keyframe android:fraction="0.1" android:value="0.82" />
                    <keyframe android:fraction="0.2" android:value="1.06" />
                    <keyframe android:fraction="0.8" android:value="1.03" />
                    <keyframe android:fraction="0.9" android:value="1" />
                    <keyframe android:fraction="1" android:value="0.82" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1.14" />
                    <keyframe android:fraction="0.1" android:value="1.14" />
                    <keyframe android:fraction="0.2" android:value="0.96" />
                    <keyframe android:fraction="0.8" android:value="0.98" />
                    <keyframe android:fraction="0.9" android:value="1" />
                    <keyframe android:fraction="1" android:value="1.14" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.1" android:value="0" />
                    <keyframe android:fraction="0.9" android:value="-360" />
                    <keyframe android:fraction="1" android:value="-360" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="shadow">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1100" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="fillAlpha" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.35" />
                    <keyframe android:fraction="0.1" android:value="0.35" />
                    <keyframe android:fraction="0.5" android:interpolator="@android:interpolator/decelerate_quad" android:value="0.12" />
                    <keyframe android:fraction="0.9" android:interpolator="@android:interpolator/accelerate_quad" android:value="0.35" />
                    <keyframe android:fraction="1" android:value="0.35" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
