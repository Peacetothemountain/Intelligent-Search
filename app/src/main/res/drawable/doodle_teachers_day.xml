<?xml version="1.0" encoding="utf-8"?>
<!-- World Teachers' Day: a shiny apple sits on top of the G with a little worm who ducks inside and pops back out;
     a pencil writes a red tick beside a stack of books and a gold star sticker pops for the good work, under an
     "A+". See doodle_halloween.xml for the layout. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="48dp" android:height="48dp" android:viewportWidth="48" android:viewportHeight="48">

            <!-- A+ in red marker, left -->
            <path android:strokeColor="#FFEA4335" android:strokeWidth="0.9" android:strokeLineCap="round" android:strokeLineJoin="round"
                android:pathData="M4.8,22.2L7,16.2L9.2,22.2 M5.7,20L8.3,20 M11.1,17.9L11.1,20.9 M9.6,19.4L12.6,19.4" />

            <!-- Gold star sticker, top right -->
            <group android:name="star" android:translateX="36.6" android:translateY="9.4">
                <path android:fillColor="#FFFBBC04" android:strokeColor="#FFF29900" android:strokeWidth="0.45" android:strokeLineJoin="round"
                    android:pathData="M0,-2.6L0.67,-0.91L2.47,-0.8L1.08,0.34L1.53,2.1L0,1.12L-1.53,2.1L-1.08,0.34L-2.47,-0.8L-0.67,-0.91Z" />
                <path android:fillColor="#FFFDE293"
                    android:pathData="M-0.2,-1.5L0.25,-0.6L-0.6,-0.55Z" />
            </group>

            <!-- Stack of books, bottom left -->
            <group android:translateX="14" android:translateY="41">
                <path android:fillColor="#FF4285F4"
                    android:pathData="M-4.2,-1Q-4.2,-1.3 -3.9,-1.3L4.2,-1.3L4.2,1.3L-3.9,1.3Q-4.2,1.3 -4.2,1Z" />
                <path android:fillColor="#FF1967D2"
                    android:pathData="M-4.2,0.45L4.2,0.45L4.2,1.3L-3.9,1.3Q-4.2,1.3 -4.2,1Z" />
                <path android:fillColor="#FFFFF6E0" android:strokeColor="#FFE6D3AE" android:strokeWidth="0.25"
                    android:pathData="M2.9,-0.85L4.5,-0.85L4.5,0.85L2.9,0.85Z" />
                <path android:strokeColor="#FFAECBFA" android:strokeWidth="0.35"
                    android:pathData="M-3.1,-0.9L-3.1,0.35 M-2.5,-0.9L-2.5,0.35" />
            </group>
            <group android:translateX="14.2" android:translateY="38.4" android:rotation="-4">
                <path android:fillColor="#FF34A853"
                    android:pathData="M-3.7,-0.9Q-3.7,-1.2 -3.4,-1.2L3.7,-1.2L3.7,1.2L-3.4,1.2Q-3.7,1.2 -3.7,0.9Z" />
                <path android:fillColor="#FF188038"
                    android:pathData="M-3.7,0.4L3.7,0.4L3.7,1.2L-3.4,1.2Q-3.7,1.2 -3.7,0.9Z" />
                <path android:fillColor="#FFFFF6E0" android:strokeColor="#FFE6D3AE" android:strokeWidth="0.25"
                    android:pathData="M-4,-0.8L-2.5,-0.8L-2.5,0.8L-4,0.8Z" />
            </group>
            <group android:translateX="13.8" android:translateY="36.1" android:rotation="5">
                <path android:fillColor="#FFFBBC04"
                    android:pathData="M-3.2,-0.85Q-3.2,-1.1 -2.95,-1.1L3.2,-1.1L3.2,1.1L-2.95,1.1Q-3.2,1.1 -3.2,0.85Z" />
                <path android:fillColor="#FFE8A000"
                    android:pathData="M-3.2,0.35L3.2,0.35L3.2,1.1L-2.95,1.1Q-3.2,1.1 -3.2,0.85Z" />
                <path android:fillColor="#FFFFF6E0" android:strokeColor="#FFE6D3AE" android:strokeWidth="0.25"
                    android:pathData="M2,-0.75L3.45,-0.75L3.45,0.75L2,0.75Z" />
                <path android:fillColor="#FFEA4335"
                    android:pathData="M-1.4,1L-0.6,1L-0.6,2.6L-1,2.2L-1.4,2.6Z" />
            </group>

            <!-- The tick the pencil writes -->
            <path android:name="tick" android:strokeColor="#FFEA4335" android:strokeWidth="0.95" android:strokeLineCap="round" android:strokeLineJoin="round"
                android:pathData="M31.5,39.6L34,42.2L39.6,36" />

            <!-- Pencil; its origin is the tip and it points down and left -->
            <group android:name="pencil" android:translateX="39.9" android:translateY="35.6">
                <group android:rotation="-52">
                    <path android:fillColor="#FFF6D7A7"
                        android:pathData="M0.2,-0.15L1.9,-0.85L1.9,0.85L0.2,0.15Q0,0 0.2,-0.15Z" />
                    <path android:fillColor="#FF5F6368"
                        android:pathData="M0.2,-0.15L0.75,-0.38L0.75,0.38L0.2,0.15Q0,0 0.2,-0.15Z" />
                    <path android:fillColor="#FFFBBC04"
                        android:pathData="M1.9,-0.85L7.6,-0.85L7.6,0.85L1.9,0.85Z" />
                    <path android:fillColor="#FFE8A000"
                        android:pathData="M1.9,0.25L7.6,0.25L7.6,0.85L1.9,0.85Z" />
                    <path android:fillColor="#FFBDC1C6" android:strokeColor="#FF9AA0A6" android:strokeWidth="0.2"
                        android:pathData="M7.6,-0.9L8.5,-0.9L8.5,0.9L7.6,0.9Z" />
                    <path android:fillColor="#FFF28B82"
                        android:pathData="M8.5,-0.85L9.2,-0.85Q9.6,-0.85 9.6,-0.45L9.6,0.45Q9.6,0.85 9.2,0.85L8.5,0.85Z" />
                </group>
            </group>

            <!-- Apple on top of the G; its pivot is the middle of its base -->
            <group android:name="apple" android:translateX="24" android:translateY="12.9">
                <path android:strokeColor="#FF6D4C41" android:strokeWidth="0.6" android:strokeLineCap="round"
                    android:pathData="M0,-5.3C0,-6.2 0.3,-6.9 0.8,-7.3" />
                <path android:fillColor="#FF34A853"
                    android:pathData="M0.4,-6.4C1.2,-7.6 2.8,-7.8 3.6,-7.2C2.8,-6.2 1.4,-5.9 0.4,-6.4Z" />
                <path android:fillColor="#FF188038"
                    android:pathData="M0.4,-6.4C1.6,-6.7 2.6,-6.9 3.6,-7.2C2.8,-6.2 1.4,-5.9 0.4,-6.4Z" />
                <path android:fillColor="#FFEA4335"
                    android:pathData="M0,-5.4C-1.2,-6.2 -3.6,-6.2 -3.6,-3.3C-3.6,-1 -2,0.2 -1,0.2C-0.5,0.2 -0.3,0 0,0C0.3,0 0.5,0.2 1,0.2C2,0.2 3.6,-1 3.6,-3.3C3.6,-6.2 1.2,-6.2 0,-5.4Z" />
                <path android:fillColor="#FFC5221F"
                    android:pathData="M1.6,-5.9C3,-5.6 3.6,-4.6 3.6,-3.3C3.6,-1 2,0.2 1,0.2C2.2,-1 2.8,-3.6 1.6,-5.9Z" />
                <path android:strokeColor="#FFFFFFFF" android:strokeAlpha="0.75" android:strokeWidth="0.6" android:strokeLineCap="round"
                    android:pathData="M-2.5,-4.6C-2.85,-4.1 -3,-3.5 -2.9,-2.9" />
                <path android:fillColor="#FF8C1D18"
                    android:pathData="M1.05,-3.1a0.6,0.55 0,1 0,1.2 0a0.6,0.55 0,1 0,-1.2 0Z" />
                <!-- The worm pops out of its hole; its pivot is the hole -->
                <group android:name="worm" android:translateX="1.65" android:translateY="-3.1" android:rotation="10">
                    <path android:fillColor="#FF81C995" android:strokeColor="#FF34A853" android:strokeWidth="0.3"
                        android:pathData="M-0.45,0.2C-0.5,-0.6 -0.2,-1.3 0.4,-1.7L1,-1.2C0.5,-0.9 0.4,-0.4 0.45,0.2Z" />
                    <path android:fillColor="#FF81C995" android:strokeColor="#FF34A853" android:strokeWidth="0.3"
                        android:pathData="M-0.15,-2.05a0.95,0.9 0,1 0,1.9 0a0.95,0.9 0,1 0,-1.9 0Z" />
                    <path android:fillColor="#FF3C4043"
                        android:pathData="M0.55,-2.25a0.2,0.24 0,1 0,0.4 0a0.2,0.24 0,1 0,-0.4 0Z M1.1,-2.25a0.2,0.24 0,1 0,0.4 0a0.2,0.24 0,1 0,-0.4 0Z" />
                </group>
            </group>
        </vector>
    </aapt:attr>

    <!-- 3.6s: rest; the tick fades as the pencil lifts back to the start; it writes the tick; a flourish; rest. -->
    <target android:name="pencil">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="3600" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="translateX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="39.9" />
                    <keyframe android:fraction="0.12" android:value="39.9" />
                    <keyframe android:fraction="0.24" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="32.3" />
                    <keyframe android:fraction="0.3" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="31.5" />
                    <keyframe android:fraction="0.4" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="34" />
                    <keyframe android:fraction="0.56" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="39.6" />
                    <keyframe android:fraction="0.62" android:interpolator="@android:interpolator/decelerate_quad" android:value="40.6" />
                    <keyframe android:fraction="0.7" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="39.9" />
                    <keyframe android:fraction="1" android:value="39.9" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="35.6" />
                    <keyframe android:fraction="0.12" android:value="35.6" />
                    <keyframe android:fraction="0.24" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="38.4" />
                    <keyframe android:fraction="0.3" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="39.6" />
                    <keyframe android:fraction="0.4" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="42.2" />
                    <keyframe android:fraction="0.56" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="36" />
                    <keyframe android:fraction="0.62" android:interpolator="@android:interpolator/decelerate_quad" android:value="34.4" />
                    <keyframe android:fraction="0.7" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="35.6" />
                    <keyframe android:fraction="1" android:value="35.6" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.3" android:value="0" />
                    <keyframe android:fraction="0.4" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-6" />
                    <keyframe android:fraction="0.56" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="5" />
                    <keyframe android:fraction="0.62" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-4" />
                    <keyframe android:fraction="0.72" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="tick">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="3600" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="strokeAlpha" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.12" android:value="1" />
                    <keyframe android:fraction="0.2" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                    <keyframe android:fraction="0.29" android:value="0" />
                    <keyframe android:fraction="0.3" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="trimPathEnd" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.2" android:value="1" />
                    <keyframe android:fraction="0.21" android:value="0" />
                    <keyframe android:fraction="0.3" android:value="0" />
                    <keyframe android:fraction="0.4" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0.3" />
                    <keyframe android:fraction="0.56" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- The gold star pops as the tick is finished. -->
    <target android:name="star">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="3600" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.56" android:value="1" />
                    <keyframe android:fraction="0.6" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0.8" />
                    <keyframe android:fraction="0.66" android:interpolator="@android:interpolator/decelerate_quad" android:value="1.3" />
                    <keyframe android:fraction="0.76" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0.95" />
                    <keyframe android:fraction="0.82" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.56" android:value="1" />
                    <keyframe android:fraction="0.6" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0.8" />
                    <keyframe android:fraction="0.66" android:interpolator="@android:interpolator/decelerate_quad" android:value="1.3" />
                    <keyframe android:fraction="0.76" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0.95" />
                    <keyframe android:fraction="0.82" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.6" android:value="0" />
                    <keyframe android:fraction="0.8" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="72" />
                    <keyframe android:fraction="1" android:value="72" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- 3.6s: the worm looks about, ducks into the apple (which rocks), and pops back out with a bounce. -->
    <target android:name="worm">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="3600" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.16" android:value="1" />
                    <keyframe android:fraction="0.22" android:interpolator="@android:interpolator/accelerate_quad" android:value="0" />
                    <keyframe android:fraction="0.66" android:value="0" />
                    <keyframe android:fraction="0.72" android:interpolator="@android:interpolator/decelerate_quad" android:value="1.15" />
                    <keyframe android:fraction="0.78" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.16" android:value="1" />
                    <keyframe android:fraction="0.22" android:interpolator="@android:interpolator/accelerate_quad" android:value="0" />
                    <keyframe android:fraction="0.66" android:value="0" />
                    <keyframe android:fraction="0.72" android:interpolator="@android:interpolator/decelerate_quad" android:value="1.15" />
                    <keyframe android:fraction="0.78" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="10" />
                    <keyframe android:fraction="0.05" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-12" />
                    <keyframe android:fraction="0.12" android:value="-12" />
                    <keyframe android:fraction="0.16" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="10" />
                    <keyframe android:fraction="0.82" android:value="10" />
                    <keyframe android:fraction="0.87" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="30" />
                    <keyframe android:fraction="0.93" android:value="30" />
                    <keyframe android:fraction="0.98" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="10" />
                    <keyframe android:fraction="1" android:value="10" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="apple">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="3600" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.2" android:value="0" />
                    <keyframe android:fraction="0.25" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="6" />
                    <keyframe android:fraction="0.31" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-4" />
                    <keyframe android:fraction="0.37" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="2" />
                    <keyframe android:fraction="0.43" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                    <keyframe android:fraction="0.68" android:value="0" />
                    <keyframe android:fraction="0.72" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="-3" />
                    <keyframe android:fraction="0.78" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="1.5" />
                    <keyframe android:fraction="0.84" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
