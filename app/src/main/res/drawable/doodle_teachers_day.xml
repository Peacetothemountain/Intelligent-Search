<?xml version="1.0" encoding="utf-8"?>
<!-- World Teachers' Day: an apple sits rocking on top of the G while a pencil underlines beside it.
     See doodle_halloween.xml for the layout. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="48dp" android:height="48dp" android:viewportWidth="48" android:viewportHeight="48">

            <!-- Apple on the G's top edge, rocking on its base -->
            <group android:name="apple" android:pivotY="4.4" android:translateX="24" android:translateY="8.6">
                <path android:pathData="M0,0L0.4,-1.8" android:strokeColor="#FF5D4037" android:strokeLineCap="round" android:strokeWidth="0.5" />
                <path android:fillColor="#FF34A853" android:pathData="M0.4,-1.4C1.4,-2.6 2.8,-2.6 3.2,-2C2.4,-1.2 1.4,-1 0.4,-1.4Z" />
                <path android:fillColor="#FFEA4335" android:pathData="M0,-0.2C-2.4,-2 -4.4,0 -3.6,2.6C-3,4.6 -1.4,5 0,4.4C1.4,5 3,4.6 3.6,2.6C4.4,0 2.4,-2 0,-0.2Z" />
                <path android:fillAlpha="0.5" android:fillColor="#FFFFFFFF" android:pathData="M-2.6,1a0.5,0.9 0,1 0,1 0a0.5,0.9 0,1 0,-1 0Z" />
            </group>

            <!-- The line the pencil writes -->
            <path android:name="line" android:pathData="M34,44C35.5,41.6 36.5,41.6 37.4,43.4C38.4,45.4 39.6,45 40.4,43C41.2,41.2 42.4,41.4 43.2,43.2C43.8,44.6 45,44.4 46,42.8" android:strokeColor="#FF4285F4" android:strokeLineCap="round" android:strokeLineJoin="round" android:strokeWidth="0.7" />

            <!-- Pencil, tip at its origin -->
            <group android:name="pencil" android:translateX="46" android:translateY="42.8">
                <path android:fillColor="#FFFBBC04" android:pathData="M1.2,-2.4L6,-7.2L7.2,-6L2.4,-1.2Z" />
                <path android:fillColor="#FFF3D9B1" android:pathData="M0,0L1.2,-2.4L2.4,-1.2Z" />
                <path android:fillColor="#FF3C4043" android:pathData="M0,0L0.5,-1L1,-0.5Z" />
                <path android:fillColor="#FFF28B82" android:pathData="M6,-7.2L7.2,-6L8,-6.8L6.8,-8Z" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="apple">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1500" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="rotation" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="-7" android:valueTo="7" android:valueType="floatType" />
        </aapt:attr>
    </target>

    <!-- 3s: the pencil writes the line left to right, then it's wiped and the pencil goes back. -->
    <target android:name="line">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="3000" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="trimPathEnd" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.2" android:value="1" />
                    <keyframe android:fraction="0.25" android:value="0" />
                    <keyframe android:fraction="0.3" android:value="0" />
                    <keyframe android:fraction="0.9" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="pencil">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="3000" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="translateX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="46" />
                    <keyframe android:fraction="0.2" android:value="46" />
                    <keyframe android:fraction="0.3" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="34" />
                    <keyframe android:fraction="0.9" android:value="46" />
                    <keyframe android:fraction="1" android:value="46" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="42.8" />
                    <keyframe android:fraction="0.2" android:value="42.8" />
                    <keyframe android:fraction="0.3" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="44" />
                    <keyframe android:fraction="0.4" android:value="41.8" />
                    <keyframe android:fraction="0.47" android:value="44.6" />
                    <keyframe android:fraction="0.57" android:value="41.6" />
                    <keyframe android:fraction="0.66" android:value="44" />
                    <keyframe android:fraction="0.75" android:value="41.8" />
                    <keyframe android:fraction="0.82" android:value="44.2" />
                    <keyframe android:fraction="0.9" android:value="42.8" />
                    <keyframe android:fraction="1" android:value="42.8" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
