<?xml version="1.0" encoding="utf-8"?>
<!-- Thanksgiving: a turkey beside the G fans its tail feathers and bobs its head, and an autumn leaf drifts down
     on the other side. See doodle_halloween.xml for the layout. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="48dp" android:height="48dp" android:viewportWidth="48" android:viewportHeight="48">

            <!-- Leaf -->
            <group android:name="leaf" android:translateX="8" android:translateY="14">
                <group android:name="leaf_swing" android:rotation="20">
                    <path android:fillColor="#FFE8710A" android:pathData="M0,-2.6C1.5,-1.8 2.1,0 1.3,1.5C0.8,2.3 0.3,2.4 0,2.8C-0.3,2.4 -0.8,2.3 -1.3,1.5C-2.1,0 -1.5,-1.8 0,-2.6Z" />
                    <path android:pathData="M0,-1.8L0,3.5" android:strokeColor="#FFB31412" android:strokeLineCap="round" android:strokeWidth="0.35" />
                </group>
            </group>

            <group android:translateX="41" android:translateY="41">
                <!-- Tail feathers, fanned about the body's centre -->
                <group android:name="fan" android:pivotY="0">
                    <group android:rotation="-64">
                        <path android:fillColor="#FF34A853" android:pathData="M0,0C-1.4,-1.5 -1.4,-5.6 0,-6.6C1.4,-5.6 1.4,-1.5 0,0Z" />
                    </group>
                    <group android:rotation="-32">
                        <path android:fillColor="#FFFBBC04" android:pathData="M0,0C-1.4,-1.5 -1.4,-5.6 0,-6.6C1.4,-5.6 1.4,-1.5 0,0Z" />
                    </group>
                    <group android:rotation="0">
                        <path android:fillColor="#FFEA4335" android:pathData="M0,0C-1.4,-1.5 -1.4,-5.6 0,-6.6C1.4,-5.6 1.4,-1.5 0,0Z" />
                    </group>
                    <group android:rotation="32">
                        <path android:fillColor="#FFFBBC04" android:pathData="M0,0C-1.4,-1.5 -1.4,-5.6 0,-6.6C1.4,-5.6 1.4,-1.5 0,0Z" />
                    </group>
                    <group android:rotation="64">
                        <path android:fillColor="#FF4285F4" android:pathData="M0,0C-1.4,-1.5 -1.4,-5.6 0,-6.6C1.4,-5.6 1.4,-1.5 0,0Z" />
                    </group>
                </group>
                <path android:fillColor="#FF8D6E63" android:pathData="M-3,1a3,2.8 0,1 0,6 0a3,2.8 0,1 0,-6 0Z" />
                <path android:fillColor="#FFFA7B17" android:pathData="M-1.4,3.6L-1.8,4.8 M1.4,3.6L1.8,4.8" android:strokeColor="#FFFA7B17" android:strokeLineCap="round" android:strokeWidth="0.5" />
                <group android:name="head" android:pivotY="0">
                    <path android:fillColor="#FFA1887F" android:pathData="M-1.5,-1.6a1.5,1.6 0,1 0,3 0a1.5,1.6 0,1 0,-3 0Z" />
                    <path android:fillColor="#FF202124" android:pathData="M-0.85,-2a0.3,0.3 0,1 0,0.6 0a0.3,0.3 0,1 0,-0.6 0Z M0.25,-2a0.3,0.3 0,1 0,0.6 0a0.3,0.3 0,1 0,-0.6 0Z" />
                    <path android:fillColor="#FFFBBC04" android:pathData="M-0.5,-1.4L0.5,-1.4L0,-0.6Z" />
                    <path android:fillColor="#FFEA4335" android:pathData="M0.2,-0.9C0.8,-0.6 0.8,0.4 0.3,0.6C0,0.2 0,-0.4 0.2,-0.9Z" />
                </group>
            </group>
        </vector>
    </aapt:attr>

    <!-- 2.4s: the tail fans out wide and settles, the head bobs. -->
    <target android:name="fan">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="2400" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.5" android:value="1" />
                    <keyframe android:fraction="0.62" android:interpolator="@android:interpolator/overshoot" android:value="1.18" />
                    <keyframe android:fraction="0.85" android:value="1.18" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.5" android:value="1" />
                    <keyframe android:fraction="0.62" android:interpolator="@android:interpolator/overshoot" android:value="1.12" />
                    <keyframe android:fraction="0.85" android:value="1.12" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="head">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="2400" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.1" android:value="0.6" />
                    <keyframe android:fraction="0.2" android:value="0" />
                    <keyframe android:fraction="0.3" android:value="0.6" />
                    <keyframe android:fraction="0.4" android:value="0" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.1" android:value="-8" />
                    <keyframe android:fraction="0.2" android:value="0" />
                    <keyframe android:fraction="0.3" android:value="8" />
                    <keyframe android:fraction="0.4" android:value="0" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="leaf">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="4200" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="translateY" android:valueFrom="2" android:valueTo="40" android:valueType="floatType" />
                <propertyValuesHolder android:propertyName="translateX" android:valueFrom="11" android:valueTo="7" android:valueType="floatType" />
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.08" android:value="1" />
                    <keyframe android:fraction="0.88" android:value="1" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.08" android:value="1" />
                    <keyframe android:fraction="0.88" android:value="1" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="leaf_swing">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="1050" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="rotation" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="-30" android:valueTo="30" android:valueType="floatType" />
                <objectAnimator android:duration="1050" android:interpolator="@android:interpolator/accelerate_decelerate" android:propertyName="translateX" android:repeatCount="infinite" android:repeatMode="reverse" android:valueFrom="1.6" android:valueTo="-1.6" android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
