                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.2" android:value="1" />
                    <keyframe android:fraction="0.34" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="0.55" />
                    <keyframe android:fraction="0.44" android:value="0.55" />
                    <keyframe android:fraction="0.5" android:interpolator="@android:interpolator/decelerate_quad" android:value="1.1" />
                    <keyframe android:fraction="0.56" android:interpolator="@android:interpolator/accelerate_decelerate" android:value="0.97" />
