<?xml version="1.0" encoding="utf-8"?>
<!-- Valentine's Day: a heart beats at the G's shoulder while small hearts float up beside it.
     See doodle_halloween.xml for how doodles are laid out. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="48dp"
            android:height="48dp"
            android:viewportWidth="48"
            android:viewportHeight="48">

            <!-- Floating hearts start hidden; each grows in at the bottom, rises and shrinks away at the top. -->
            <group
                android:name="float_1"
                android:scaleX="0"
                android:scaleY="0"
                android:translateX="41"
                android:translateY="42">
                <path
                    android:fillColor="#FFE52592"
                    android:pathData="M0,3.6C-1.2,2.6 -4,0.8 -4,-1.2C-4,-2.6 -2.9,-3.6 -1.8,-3.6C-1,-3.6 -0.3,-3.1 0,-2.4C0.3,-3.1 1,-3.6 1.8,-3.6C2.9,-3.6 4,-2.6 4,-1.2C4,0.8 1.2,2.6 0,3.6Z" />
            </group>
            <group
                android:name="float_2"
                android:scaleX="0"
                android:scaleY="0"
                android:translateX="45"
                android:translateY="42">
                <path
                    android:fillColor="#FFEA4335"
                    android:pathData="M0,3.6C-1.2,2.6 -4,0.8 -4,-1.2C-4,-2.6 -2.9,-3.6 -1.8,-3.6C-1,-3.6 -0.3,-3.1 0,-2.4C0.3,-3.1 1,-3.6 1.8,-3.6C2.9,-3.6 4,-2.6 4,-1.2C4,0.8 1.2,2.6 0,3.6Z" />
            </group>
            <group
                android:name="float_3"
                android:scaleX="0"
                android:scaleY="0"
                android:translateX="39"
                android:translateY="42">
                <path
                    android:fillColor="#FFFF63B8"
                    android:pathData="M0,3.6C-1.2,2.6 -4,0.8 -4,-1.2C-4,-2.6 -2.9,-3.6 -1.8,-3.6C-1,-3.6 -0.3,-3.1 0,-2.4C0.3,-3.1 1,-3.6 1.8,-3.6C2.9,-3.6 4,-2.6 4,-1.2C4,0.8 1.2,2.6 0,3.6Z" />
            </group>

            <!-- The beating heart -->
            <group
                android:name="heart"
                android:translateX="38.5"
                android:translateY="10.5">
                <path
                    android:fillColor="#FFEA4335"
                    android:pathData="M0,3.6C-1.2,2.6 -4,0.8 -4,-1.2C-4,-2.6 -2.9,-3.6 -1.8,-3.6C-1,-3.6 -0.3,-3.1 0,-2.4C0.3,-3.1 1,-3.6 1.8,-3.6C2.9,-3.6 4,-2.6 4,-1.2C4,0.8 1.2,2.6 0,3.6Z" />
                <path
                    android:fillAlpha="0.7"
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M-3,-1.6a0.8,1.1 0,1 0,1.6 0a0.8,1.1 0,1 0,-1.6 0Z" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="heart">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1400"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder
                    android:propertyName="scaleX"
                    android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.12" android:value="1.2" />
                    <keyframe android:fraction="0.24" android:value="1" />
                    <keyframe android:fraction="0.36" android:value="1.14" />
                    <keyframe android:fraction="0.5" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
                <propertyValuesHolder
                    android:propertyName="scaleY"
                    android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.12" android:value="1.2" />
                    <keyframe android:fraction="0.24" android:value="1" />
                    <keyframe android:fraction="0.36" android:value="1.14" />
                    <keyframe android:fraction="0.5" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="float_1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="3000"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder
                    android:propertyName="translateY"
                    android:valueFrom="42"
                    android:valueTo="4"
                    android:valueType="floatType" />
                <propertyValuesHolder
                    android:propertyName="translateX"
                    android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="41" />
                    <keyframe android:fraction="0.3" android:value="43" />
                    <keyframe android:fraction="0.65" android:value="40" />
                    <keyframe android:fraction="1" android:value="42" />
                </propertyValuesHolder>
                <propertyValuesHolder
                    android:propertyName="scaleX"
                    android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.15" android:value="0.5" />
                    <keyframe android:fraction="0.75" android:value="0.45" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
                <propertyValuesHolder
                    android:propertyName="scaleY"
                    android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.15" android:value="0.5" />
                    <keyframe android:fraction="0.75" android:value="0.45" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="float_2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="3000"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite"
                android:startOffset="1000">
                <propertyValuesHolder
                    android:propertyName="translateY"
                    android:valueFrom="42"
                    android:valueTo="4"
                    android:valueType="floatType" />
                <propertyValuesHolder
                    android:propertyName="translateX"
                    android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="45" />
                    <keyframe android:fraction="0.35" android:value="43" />
                    <keyframe android:fraction="0.7" android:value="45.5" />
                    <keyframe android:fraction="1" android:value="44" />
                </propertyValuesHolder>
                <propertyValuesHolder
                    android:propertyName="scaleX"
                    android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.15" android:value="0.4" />
                    <keyframe android:fraction="0.75" android:value="0.35" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
                <propertyValuesHolder
                    android:propertyName="scaleY"
                    android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.15" android:value="0.4" />
                    <keyframe android:fraction="0.75" android:value="0.35" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="float_3">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="3000"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite"
                android:startOffset="2000">
                <propertyValuesHolder
                    android:propertyName="translateY"
                    android:valueFrom="42"
                    android:valueTo="4"
                    android:valueType="floatType" />
                <propertyValuesHolder
                    android:propertyName="translateX"
                    android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="39" />
                    <keyframe android:fraction="0.3" android:value="41" />
                    <keyframe android:fraction="0.6" android:value="38.5" />
                    <keyframe android:fraction="1" android:value="40.5" />
                </propertyValuesHolder>
                <propertyValuesHolder
                    android:propertyName="scaleX"
                    android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.15" android:value="0.32" />
                    <keyframe android:fraction="0.75" android:value="0.3" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
                <propertyValuesHolder
                    android:propertyName="scaleY"
                    android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.15" android:value="0.32" />
                    <keyframe android:fraction="0.75" android:value="0.3" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
