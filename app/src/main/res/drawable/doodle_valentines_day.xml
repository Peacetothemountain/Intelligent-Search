<?xml version="1.0" encoding="utf-8"?>
<!--
    Valentine's Day: a love letter by the G wriggles, flips open and lets out three little hearts that float up past the G
    into a big glossy heart, which swells with each one and beats; then the letter closes and all rests. A rose sways on
    the other side. One 3.6s loop.

    See doodle_halloween.xml for the layout: a 48x48 viewport around the widget's own G (12..36), which isn't drawn here.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="48dp" android:height="48dp" android:viewportWidth="48" android:viewportHeight="48">
            <group android:name="spark_1" android:scaleX="1" android:scaleY="1" android:translateX="18" android:translateY="5.5">
                <path android:fillColor="#FFFF63B8" android:pathData="M0,-1.3Q0.29,-0.29 1.3,0Q0.29,0.29 0,1.3Q-0.29,0.29 -1.3,0Q-0.29,-0.29 0,-1.3Z" />
            </group>
            <group android:name="spark_2" android:scaleX="0.5" android:scaleY="0.5" android:translateX="4.6" android:translateY="21">
