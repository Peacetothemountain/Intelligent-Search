                <group android:name="flap" android:pivotY="-2.8" android:scaleY="-1">
                    <path android:fillColor="#FFF48FB1" android:strokeColor="#FFE8608F" android:strokeWidth="0.45" android:strokeLineJoin="round" android:pathData="M-3.8,-2.75L3.8,-2.75L0.6,0.2Q0,0.65 -0.6,0.2Z" />
