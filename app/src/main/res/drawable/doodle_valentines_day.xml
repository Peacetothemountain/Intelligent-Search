                <path android:fillColor="#FF34A853" android:pathData="M9.6,40.4C11.6,39.2 13.4,39.6 14,40.4C12.6,41.6 10.8,41.6 9.6,40.4Z M8.5,36.6C6.8,35.4 5,35.6 4.4,36.4C5.8,37.6 7.4,37.6 8.5,36.6Z" />
                <path android:strokeColor="#FF188038" android:strokeWidth="0.3" android:strokeLineCap="round" android:pathData="M9.8,40.5Q11.8,40.2 13.4,40.4 M8.3,36.6Q6.4,36.2 4.9,36.4" />
                <path android:fillColor="#FFC5221F" android:pathData="M4.8,29.6a2.6,2.6 0,1 0,5.2,0a2.6,2.6 0,1 0,-5.2,0Z" />
                <path android:fillColor="#FFEA4335" android:pathData="M4.8,29.4C4.8,32 6.2,33 7.4,33C8.6,33 10,32 10,29.4C9,30.4 5.8,30.4 4.8,29.4Z" />
                <path android:strokeColor="#FFA50E0E" android:strokeAlpha="0.8" android:strokeWidth="0.4" android:strokeLineCap="round" android:pathData="M7.6,29.6C6.8,29.4 6.8,28.4 7.6,28.3C8.6,28.2 8.9,29.6 8.2,30.3C7.4,31 5.9,30.5 5.9,29.2C5.9,27.9 7.2,27.2 8.4,27.5" />
            </group>

            <!-- The love letter, its flap hinged on the top edge (a scaleY flip opens it) -->
            <group android:name="envelope" android:pivotX="0" android:pivotY="2.8" android:rotation="-8" android:translateX="35.2" android:translateY="40.4">
                <path android:fillColor="#FFFCE4EC" android:strokeColor="#FFE8608F" android:strokeWidth="0.5" android:pathData="M-3.6,-2.8L3.6,-2.8Q4,-2.8 4,-2.4L4,2.4Q4,2.8 3.6,2.8L-3.6,2.8Q-4,2.8 -4,2.4L-4,-2.4Q-4,-2.8 -3.6,-2.8Z" />
