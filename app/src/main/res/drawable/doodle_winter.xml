    <!-- 6s: the snowman waves, tilting its head, then rests and blinks twice. -->
    <target android:name="arm">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="6000" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.1" android:value="0" />
                    <keyframe android:fraction="0.16" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="-30" />
                    <keyframe android:fraction="0.23" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="6" />
                    <keyframe android:fraction="0.3" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="-30" />
                    <keyframe android:fraction="0.37" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="6" />
                    <keyframe android:fraction="0.44" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="-12" />
                    <keyframe android:fraction="0.52" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="0" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="head">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="6000" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.1" android:value="0" />
                    <keyframe android:fraction="0.18" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="7" />
                    <keyframe android:fraction="0.44" android:value="7" />
                    <keyframe android:fraction="0.54" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="-2" />
                    <keyframe android:fraction="0.6" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="0" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="eyes">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="6000" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.72" android:value="1" />
                    <keyframe android:fraction="0.735" android:value="0.1" />
                    <keyframe android:fraction="0.75" android:value="1" />
                    <keyframe android:fraction="0.79" android:value="1" />
                    <keyframe android:fraction="0.805" android:value="0.1" />
                    <keyframe android:fraction="0.82" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- The scarf end flaps in the breeze. -->
    <target android:name="scarf_tail">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1100" android:interpolator="@android:interpolator/accelerate_decelerate" android:repeatCount="infinite" android:repeatMode="reverse">
                <propertyValuesHolder android:propertyName="rotation" android:valueFrom="-4" android:valueTo="12" android:valueType="floatType" />
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
