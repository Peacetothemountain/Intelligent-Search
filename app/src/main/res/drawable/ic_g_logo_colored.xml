<?xml version="1.0" encoding="utf-8"?>
<!--
    Modern 2025/2026 Google G logo — Official fluid multi-color gradient design.
    Replaces the legacy flat solid color blocks with seamless gradient transitions
    between Google Blue (#4285F4), Google Green (#34A853), Google Yellow (#FBBC05), and Google Red (#EA4335).
    ViewBox: 24x24 standard vector viewport.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

  <!-- Blue segment: right horizontal bar + vertical right arc blending into green at bottom-right and red at top-right -->
  <path
      android:pathData="M22.56,12.25C22.56,11.47 22.49,10.72 22.36,10L12,10L12,14.26L17.92,14.26C17.66,15.63 16.88,16.79 15.71,17.57L15.71,20.34L19.28,20.34C21.36,18.42 22.56,15.6 22.56,12.25Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="linear"
          android:startX="12"
          android:startY="10"
          android:endX="22.56"
          android:endY="19.5">
        <item android:color="#4285F4" android:offset="0.0" />
        <item android:color="#3B7EE8" android:offset="0.65" />
        <item android:color="#34A853" android:offset="1.0" />
      </gradient>
    </aapt:attr>
  </path>

  <!-- Green segment: bottom arc blending from blue on the right through vibrant green to yellow on the left -->
  <path
      android:pathData="M12,23C14.97,23 17.46,22.02 19.28,20.34L15.71,17.57C14.73,18.23 13.48,18.63 12,18.63C9.14,18.63 6.71,16.7 5.84,14.1L2.18,14.1L2.18,16.94C3.99,20.53 7.7,23 12,23Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="linear"
          android:startX="19.28"
          android:startY="19.5"
          android:endX="2.18"
          android:endY="15.5">
        <item android:color="#4285F4" android:offset="0.0" />
        <item android:color="#34A853" android:offset="0.35" />
        <item android:color="#66BB6A" android:offset="0.75" />
        <item android:color="#FBBC05" android:offset="1.0" />
      </gradient>
    </aapt:attr>
  </path>

  <!-- Yellow segment: left arc blending from green at bottom through pure yellow to red at top-left -->
  <path
      android:pathData="M5.84,14.09C5.62,13.43 5.5,12.73 5.5,12C5.5,11.27 5.62,10.57 5.84,9.91L5.84,7.07L2.18,7.07C1.43,8.55 1,10.22 1,12C1,13.78 1.43,15.45 2.18,16.93L5.84,14.09Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="linear"
          android:startX="4"
          android:startY="16.93"
          android:endX="4"
          android:endY="7.07">
        <item android:color="#34A853" android:offset="0.0" />
        <item android:color="#FBBC05" android:offset="0.45" />
        <item android:color="#F29900" android:offset="0.8" />
        <item android:color="#EA4335" android:offset="1.0" />
      </gradient>
    </aapt:attr>
  </path>

  <!-- Red segment: top arc blending from yellow on upper-left through vibrant red to blue at top-right -->
  <path
      android:pathData="M12,5.38C13.62,5.38 15.06,5.94 16.21,7.02L19.36,3.87C17.45,2.09 14.97,1 12,1C7.7,1 3.99,3.47 2.18,7.07L5.84,9.91C6.71,7.31 9.14,5.38 12,5.38Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="linear"
          android:startX="2.18"
          android:startY="7.07"
          android:endX="19.36"
          android:endY="3.87">
        <item android:color="#FBBC05" android:offset="0.0" />
        <item android:color="#EA4335" android:offset="0.38" />
        <item android:color="#E53935" android:offset="0.72" />
        <item android:color="#4285F4" android:offset="1.0" />
      </gradient>
    </aapt:attr>
  </path>

</vector>
