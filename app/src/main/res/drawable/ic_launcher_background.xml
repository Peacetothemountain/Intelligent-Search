<?xml version="1.0" encoding="utf-8"?>
<!--
  Intelligent Search launcher background in the wallpaper's Material You colors, light or dark with the system theme
  (colors in values/ and values-night/). Engineered by NG Designs.
  The 72 dp visible plate sits centered in the 108 dp layer: a tinted plate, a deeper edge, then the halftone light
  rising from the bottom. The edge and halftone are white alpha masks (drawable-nodpi, and drawable-night-nodpi for
  the dark theme's lighter strengths) that Android tints, so the shapes stay exact while the colors follow the
  wallpaper. The halftone is two masks, the deep tone under the soft one, which together blend from the deep tone at
  the bottom to the soft tone higher up.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.4333"
                android:gradientRadius="44.64dp"
                android:startColor="@color/ic_launcher_plate_center"
                android:centerColor="@color/ic_launcher_plate_center"
                android:endColor="@color/ic_launcher_plate_edge" />
        </shape>
    </item>
    <item>
        <bitmap
            android:src="@drawable/ic_launcher_ring"
            android:filter="true"
            android:tint="@color/ic_launcher_edge"
            android:tintMode="src_in" />
    </item>
    <item>
        <bitmap
            android:src="@drawable/ic_launcher_dots_deep"
            android:filter="true"
            android:tint="@color/ic_launcher_dot_deep"
            android:tintMode="src_in" />
    </item>
    <item>
        <bitmap
            android:src="@drawable/ic_launcher_dots_soft"
            android:filter="true"
            android:tint="@color/ic_launcher_dot_soft"
            android:tintMode="src_in" />
    </item>
</layer-list>
