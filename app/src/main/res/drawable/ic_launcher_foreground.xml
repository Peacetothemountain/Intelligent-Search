<?xml version="1.0" encoding="utf-8"?>
<!--
  Intelligent Search launcher foreground: the search bar's lens and sparkle, on the halftone plate drawn by
  ic_launcher_background, in the wallpaper's Material You colors (values/ and values-night/). Engineered by NG Designs.
  108 x 108 dp canvas. The mark is drawn in the search icons' 24-unit box (SearchIconPaths), scaled to 56% of the
  72 dp visible plate (40.3 dp, inside the 66 dp safe zone) and nudged right and up so the lens and sparkle together
  sit centered. The lens is one true circle (center 10.5,10.5, radius 6.5) open from 300 to 45 degrees, with the
  handle starting exactly on it; the sparkle runs through the theme's primary tones with a bright band across it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="35.0496"
        android:translateY="33.0336"
        android:scaleX="1.68"
        android:scaleY="1.68">
        <path
            android:strokeColor="@color/ic_launcher_lens"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:pathData="M15.0962,15.0962 A6.5,6.5 0 1,1 13.75,4.8708" />
        <path
            android:strokeColor="@color/ic_launcher_lens"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:pathData="M15.0962,15.0962 L20,20" />
        <path android:pathData="M18,0.5 C18,4 21,6.5 24,6.5 C21,6.5 18,9 18,12.5 C18,9 15,6.5 12,6.5 C15,6.5 18,4 18,0.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="12"
                    android:startY="0.5"
                    android:endX="24"
                    android:endY="12.5">
                    <item android:offset="0" android:color="@color/ic_launcher_star_0" />
                    <item android:offset="0.5" android:color="@color/ic_launcher_star_1" />
                    <item android:offset="0.62" android:color="@color/ic_launcher_star_2" />
                    <item android:offset="1" android:color="@color/ic_launcher_star_3" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
