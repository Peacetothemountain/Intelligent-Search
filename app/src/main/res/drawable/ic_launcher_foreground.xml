<?xml version="1.0" encoding="utf-8"?>
<!--
  Intelligent Search launcher foreground: the search bar's lens and sparkle, on the halftone plate drawn by
  ic_launcher_background. Engineered by NG Designs.
  108 x 108 dp canvas. The mark is drawn in the search icons' 24-unit box (SearchIconPaths), scaled to 56% of the
  72 dp visible plate (40.3 dp, inside the 66 dp safe zone) and nudged right and up so the lens and sparkle together
  sit centered. The lens is one true circle (center 10.5,10.5, radius 6.5) open from 300 to 45 degrees, with the
  handle starting exactly on it; the sparkle runs from light blue at its far tip to deep blue beside the lens.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="35.0496"
        android:translateY="33.0336"
        android:scaleX="1.68"
        android:scaleY="1.68">
        <path
            android:strokeColor="#FF2F3237"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:pathData="M15.0962,15.0962 A6.5,6.5 0 1,1 13.75,4.8708" />
        <path
            android:strokeColor="#FF2F3237"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:pathData="M15.0962,15.0962 L20,20" />
        <path android:pathData="M18,0.5 C18,4 21,6.5 24,6.5 C21,6.5 18,9 18,12.5 C18,9 15,6.5 12,6.5 C15,6.5 18,4 18,0.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="23"
                    android:startY="1.5"
                    android:endX="13.5"
                    android:endY="10.5">
                    <item android:offset="0" android:color="#FF8FB2FF" />
                    <item android:offset="0.4" android:color="#FF5283F5" />
                    <item android:offset="0.75" android:color="#FF2A5BD8" />
                    <item android:offset="1" android:color="#FF163C9C" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
