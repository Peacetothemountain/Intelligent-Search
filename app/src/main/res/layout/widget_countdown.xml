<?xml version="1.0" encoding="utf-8"?>
<!--
    The countdown widget: the days left in large type over what they lead to ("12" over "days to Halloween"), on the
    theme's surface. Both lines shrink to fit (auto-size), so nothing is cut at large text sizes or in a small cell.
    Colours are set when the widget is drawn, for the light or dark theme (CountdownWidgetProvider).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/countdown_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_countdown_widget"
        android:scaleType="fitXY"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/countdown_number"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:gravity="center"
            android:fontFamily="@font/google_sans_flex"
            android:textFontWeight="500"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="64sp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/countdown_caption"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:gravity="center_horizontal|top"
            android:fontFamily="@font/google_sans_flex"
            android:maxLines="2"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="16sp"
            android:importantForAccessibility="no" />
    </LinearLayout>
</FrameLayout>
