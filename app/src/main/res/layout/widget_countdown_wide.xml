<?xml version="1.0" encoding="utf-8"?>
<!--
    The countdown widget wide and two rows high: the days left as the hero on the left, and beside it "days", the
    event's name and its date. The backdrop is the search bar's, set by the provider as for the other sizes
    (CountdownWidgetProvider).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/countdown_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="noHideDescendants">

        <ImageView
            android:id="@+id/countdown_outline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/bg_widget_r32"
            android:scaleType="fitXY"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/countdown_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            android:src="@drawable/bg_widget_r24"
            android:scaleType="fitXY"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/countdown_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:padding="24dp"
        android:importantForAccessibility="noHideDescendants">

        <TextView
            android:id="@+id/countdown_hero"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:gravity="center"
            android:fontFamily="@font/google_sans_flex"
            android:textFontWeight="500"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeMaxTextSize="160sp"
            android:autoSizeStepGranularity="2sp"
            android:importantForAccessibility="no" />

        <!-- Shown instead of the hero until the widget is set up. -->
        <ImageView
            android:id="@+id/countdown_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_countdown_event"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/countdown_unit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans_flex"
                android:textFontWeight="500"
                android:textSize="14sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/countdown_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/google_sans_flex"
                android:textFontWeight="500"
                android:textSize="20sp"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:ellipsize="end"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/countdown_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/google_sans_flex"
                android:textFontWeight="400"
                android:textSize="14sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
