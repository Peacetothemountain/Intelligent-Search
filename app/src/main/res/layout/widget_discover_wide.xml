<?xml version="1.0" encoding="utf-8"?>
<!--
    The Discover widget wide and two rows high: "UP NEXT" and how soon, the next event large, then when, where and
    when to leave, and the weather in a strip underneath. The event's name takes the room the rest leaves; on a short
    cell or with large text the provider hides the weather strip first, then the line under the name, so the name
    always has room for two lines (DiscoverWidgetModel.wideRoom). The backdrop is the search bar's, set by the provider
    as for the other sizes (DiscoverWidgetProvider).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/discover_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="noHideDescendants">

        <ImageView
            android:id="@+id/discover_outline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/bg_widget_r32"
            android:scaleType="fitXY"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/discover_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            android:src="@drawable/bg_widget_r24"
            android:scaleType="fitXY"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/discover_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:importantForAccessibility="noHideDescendants">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/discover_top"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/google_sans_flex"
                android:textFontWeight="600"
                android:textSize="12sp"
                android:letterSpacing="0.06"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:importantForAccessibility="no" />

            <!-- How soon the event starts, shown in its last hour. -->
            <TextView
                android:id="@+id/discover_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_widget_r8"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:fontFamily="@font/google_sans_flex"
                android:textFontWeight="500"
                android:textSize="12sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:visibility="gone"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- The event's name: as large as the room between the label and the lines under it allows. -->
        <TextView
            android:id="@+id/discover_headline"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:gravity="start|center_vertical"
            android:fontFamily="@font/google_sans_flex"
            android:textFontWeight="400"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeMaxTextSize="22sp"
            android:autoSizeStepGranularity="2sp"
            android:importantForAccessibility="no" />

        <!-- When, where, and when to leave. The place gives way first, so the times are never cut off. -->
        <LinearLayout
            android:id="@+id/discover_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/discover_meta_before"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans_flex"
                android:textFontWeight="400"
                android:textSize="14sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/discover_meta_place"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/google_sans_flex"
                android:textFontWeight="400"
                android:textSize="14sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/discover_meta_after"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans_flex"
                android:textFontWeight="400"
                android:textSize="14sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- The weather strip: the dot, then "63° Clear · H 68° · Rain around 8 PM". -->
        <LinearLayout
            android:id="@+id/discover_weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_widget_r16"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/discover_dot"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/bg_widget_r8"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/discover_weather_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans_flex"
                android:textFontWeight="400"
                android:textSize="14sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
