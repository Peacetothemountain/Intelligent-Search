<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <!-- Centered capsule container matching Android 12-17 corner rounding (56dp standard height) -->
    <LinearLayout
        android:id="@android:id/background"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/search_bar_background"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <!-- Doodle Touch Target & Animation Flipper (48dp x 48dp accessible touch target) -->
        <FrameLayout
            android:id="@+id/doodle_touch_target"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/widget_talkback_google_logo">
            
            <AdapterViewFlipper
                android:id="@+id/doodle_flipper"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:autoStart="true"
                android:flipInterval="100" />
                
        </FrameLayout>

        <!-- Search Text / Hint -->
        <TextView
            android:id="@+id/doodle_search_text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/widget_search_description"
            android:textColor="@android:color/darker_gray"
            android:textSize="16sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/widget_search_description" />

        <!-- Microphone Button (48dp x 48dp accessible touch target, 24dp icon) -->
        <ImageView
            android:id="@+id/doodle_mic_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/widget_talkback_voice_search" />

        <!-- Camera / Lens Button (48dp x 48dp accessible touch target, 24dp icon) -->
        <ImageView
            android:id="@+id/doodle_camera_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_camera"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/widget_talkback_lens" />

    </LinearLayout>

    <!-- Invisible stub IDs to satisfy SearchWidgetProvider references safely without impacting UI -->
    <ImageView
        android:id="@+id/widget_outer_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/widget_pill_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:importantForAccessibility="no">
        <ImageView
            android:id="@+id/widget_pill_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no" />
        <ImageView
            android:id="@+id/widget_g_logo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no" />
        <ImageView
            android:id="@+id/widget_voice_search"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no" />
        <ImageView
            android:id="@+id/widget_lens_search"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no" />
        <ImageView
            android:id="@+id/widget_shortcut_2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no" />
        <ImageView
            android:id="@+id/widget_shortcut_3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no" />
        <ImageView
            android:id="@+id/widget_action_search"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_sound_search"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:importantForAccessibility="no">
        <ImageView
            android:id="@+id/widget_sound_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no" />
        <ImageView
            android:id="@+id/widget_sound_icon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no" />
    </FrameLayout>

</FrameLayout>
