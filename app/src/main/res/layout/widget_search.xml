<?xml version="1.0" encoding="utf-8"?>
<!--
    Material Design Widget layout with dual-layer accent rim effect.
    Outer ImageView provides the accent-tinted border rim.
    Inner ImageViews provide the dark pill and circle backgrounds.
    Matches 1:1 with Widget Customization preview in SettingsScreens.kt.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <!-- Centered capsule container matching 1:1 preview (64dp total height: 48dp pill + 8dp top/bottom outer shell rim) -->
    <FrameLayout
        android:id="@android:id/background"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="center">

        <!-- Outer rim capsule (accent-tinted border, 32dp corner radius) -->
        <ImageView
            android:id="@+id/widget_outer_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/bg_outer_capsule"
            android:scaleType="fitXY"
            android:importantForAccessibility="no" />

        <!-- Inner content row (insets 8dp to expose accent rim all around matching preview) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Search pill (48dp height matching preview) -->
            <FrameLayout
                android:id="@+id/widget_pill_container"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/widget_search_description">

                <!-- Pill dark background -->
                <ImageView
                    android:id="@+id/widget_pill_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/bg_search_pill_material"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no" />

                <!-- Pill content -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false"
                    android:clipToPadding="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <!-- Google G logo: a 24dp G inside a 48dp slot that reaches into the padding around it, so the
                         G sits where it always has and a doodle (see Occasion) has room to play around it. -->
                    <FrameLayout
                        android:id="@+id/widget_g_slot"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="-12dp"
                        android:layout_marginEnd="-12dp">

                        <ImageView
                            android:id="@+id/widget_g_logo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp"
                            android:src="@drawable/ic_g_logo"
                            android:scaleType="fitCenter"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="@string/widget_talkback_google_logo" />

                        <FrameLayout
                            android:id="@+id/widget_doodle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <!-- Spacer -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:importantForAccessibility="no"
                        android:text="" />

                    <!-- Microphone (24dp) -->
                    <ImageView
                        android:id="@+id/widget_voice_search"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_mic"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/widget_talkback_voice_search"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Shortcut 1 (Lens Search, 24dp, 16dp spacing) -->
                    <ImageView
                        android:id="@+id/widget_lens_search"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/ic_camera"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/widget_talkback_lens"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Shortcut 2 (24dp, 16dp spacing) -->
                    <ImageView
                        android:id="@+id/widget_shortcut_2"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/ic_camera"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        android:contentDescription="@string/widget_talkback_lens"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Shortcut 3 (24dp, 16dp spacing) -->
                    <ImageView
                        android:id="@+id/widget_shortcut_3"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/ic_camera"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        android:contentDescription="@string/widget_talkback_lens"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Action Search (24dp, 16dp spacing) -->
                    <ImageView
                        android:id="@+id/widget_action_search"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/ic_lens_action"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        android:contentDescription="@string/widget_talkback_voice_search"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>
            </FrameLayout>

            <!-- Circle action button (48dp x 48dp matching 48dp pill height and 8dp gap in preview) -->
            <FrameLayout
                android:id="@+id/widget_sound_search"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/widget_talkback_search_action">

                <ImageView
                    android:id="@+id/widget_sound_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/bg_circle_button"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/widget_sound_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_search_lens_expressive"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />

            </FrameLayout>

        </LinearLayout>
    </FrameLayout>
</FrameLayout>
