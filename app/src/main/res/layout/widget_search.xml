<?xml version="1.0" encoding="utf-8"?>
<!--
    Material Design Widget layout with dual-layer accent rim effect.
    The backdrop holds the bar's backgrounds: the accent-tinted rim, and the pill and circle over it.
    The bar row above it holds the G, the mic, the shortcuts and the circle's icon, with no backgrounds of its own.
    Matches 1:1 with Widget Customization preview in WidgetSettingsScreen.kt.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="0dp">

    <!-- Centered capsule container matching 1:1 preview (64dp total height: 48dp pill + 8dp top/bottom outer shell rim;
         the provider sets the height and rim for the chosen outline). It clips to its own bounds, which tells the
         launcher the widget draws its own corners, so the launcher doesn't round it again and cut them off. -->
    <!-- The parent isn't redundant: it fills the launcher's cell and centres this fixed-height capsule in it, which the
         capsule can't do as the root (a widget's root always fills the cell). -->
    <FrameLayout
        android:id="@android:id/background"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:clipToOutline="true"
        tools:ignore="UselessParent">

        <!-- The backdrop: the bar's backgrounds as one group, which the provider fades at once by the bar's
             Transparency, so the pill and circle aren't painted twice where they sit over the rim. Its row is laid
             out exactly as the bar row below (the provider gives both the same padding, and shows the circle with the
             circle button), so each background lies under the button it backs. -->
        <FrameLayout
            android:id="@+id/widget_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="noHideDescendants">

            <!-- Outer rim capsule (accent-tinted border, 32dp corner radius) -->
            <ImageView
                android:id="@+id/widget_outer_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/bg_outer_capsule"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/widget_backdrop_row"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <!-- Pill dark background, under the search pill -->
                <ImageView
                    android:id="@+id/widget_pill_background"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/bg_search_pill_material"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no" />

                <!-- Circle background, under the circle action button -->
                <ImageView
                    android:id="@+id/widget_sound_background"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/bg_circle_button"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </FrameLayout>

        <!-- Inner content row (insets 8dp to expose accent rim all around matching preview) -->
        <LinearLayout
            android:id="@+id/widget_bar_row"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Search pill (48dp height matching preview); its background is the backdrop's pill. The tap target
                 holds the content row rather than being it: the row's spacer is weighted, and a weighted row
                 directly inside this weighted pill would be measured twice over (NestedWeights). -->
            <FrameLayout
                android:id="@+id/widget_pill_container"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/widget_search_description"
                tools:ignore="UselessParent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false"
                    android:clipToPadding="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="4dp">

                    <!-- Google G logo: a 24dp G inside a 48dp slot that reaches into the padding around it, so the
                         G sits where it always has and a doodle (see Occasion) has room to play around it. -->
                    <FrameLayout
                        android:id="@+id/widget_g_slot"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="-12dp"
                        android:layout_marginEnd="-12dp">

                        <ImageView
                            android:id="@+id/widget_g_logo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp"
                            android:src="@drawable/ic_g_logo"
                            android:scaleType="fitCenter"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="@string/widget_talkback_google_logo" />

                        <FrameLayout
                            android:id="@+id/widget_doodle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <!-- Spacer -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:importantForAccessibility="no"
                        android:text="" />

                    <!-- The mic and shortcuts: 24dp icons 40dp apart, each in a 48dp touch target. The targets
                         overlap their neighbours by 8dp, and the row's end padding is 4dp (it was 16dp) to make
                         room for the last target's 12dp padding, so every icon sits where it did when the targets
                         were the icons alone. -->

                    <!-- Microphone -->
                    <ImageView
                        android:id="@+id/widget_voice_search"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="12dp"
                        android:src="@drawable/ic_mic"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/widget_talkback_voice_search"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Shortcut 1 (Lens Search) -->
                    <ImageView
                        android:id="@+id/widget_lens_search"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="-8dp"
                        android:padding="12dp"
                        android:src="@drawable/ic_camera"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/widget_talkback_lens"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Shortcut 2 -->
                    <ImageView
                        android:id="@+id/widget_shortcut_2"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="-8dp"
                        android:padding="12dp"
                        android:src="@drawable/ic_camera"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        android:contentDescription="@string/widget_talkback_lens"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Shortcut 3 -->
                    <ImageView
                        android:id="@+id/widget_shortcut_3"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="-8dp"
                        android:padding="12dp"
                        android:src="@drawable/ic_camera"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        android:contentDescription="@string/widget_talkback_lens"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>
            </FrameLayout>

            <!-- Circle action button (48dp x 48dp matching 48dp pill height and 8dp gap in preview); its background
                 is the backdrop's circle -->
            <FrameLayout
                android:id="@+id/widget_sound_search"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/widget_talkback_search_action">

                <ImageView
                    android:id="@+id/widget_sound_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_search_lens_expressive"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />

            </FrameLayout>

        </LinearLayout>
    </FrameLayout>
</LinearLayout>
