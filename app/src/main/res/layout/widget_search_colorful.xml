<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:padding="0dp">

    <!-- Outer rim capsule -->
    <ImageView
        android:id="@+id/widget_outer_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_outer_capsule"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <FrameLayout
            android:id="@+id/widget_pill_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/widget_pill_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/bg_search_pill"
                android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:id="@+id/widget_g_logo"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_g_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="Google" />

                <FrameLayout
                    android:id="@+id/widget_doodle_container"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center_vertical" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="" />

                <ImageView
                    android:id="@+id/widget_voice_search"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_mic"
                    android:scaleType="fitCenter"
                    android:contentDescription="Voice Search"
                    android:clickable="true"
                    android:focusable="true" />

                <ImageView
                    android:id="@+id/widget_lens_search"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="32dp"
                    android:src="@drawable/ic_camera"
                    android:scaleType="fitCenter"
                    android:contentDescription="Google Lens"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true" />

                <ImageView
                    android:id="@+id/widget_gemini_search"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="18dp"
                    android:src="@drawable/ic_gemini"
                    android:scaleType="fitCenter"
                    android:contentDescription="Gemini"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>
        </FrameLayout>

    </LinearLayout>
</FrameLayout>
