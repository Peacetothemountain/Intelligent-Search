<?xml version="1.0" encoding="utf-8"?>
<!--
  No monochrome layer on purpose: with themed icons on, the launcher would swap the icon for a flat two-tone glyph.
  The icon already follows the wallpaper's Material You colors in light and dark, so it is shown as drawn.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MonochromeLauncherIcon">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
