<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15+ (API 35+) Modern Edge-to-Edge Theme Overrides -->
    <style name="Theme.IntelligentSearch.Overlay" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Recents screenshots are off, so Android draws the Recents card from these when its live preview ends;
             Material's lavender status bar color would show as a lavender header on it. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Text drawn by Android's own views in the app's windows is Google Sans Flex too, like the Compose text. -->
        <item name="android:fontFamily">@font/google_sans_flex</item>
        <item name="fontFamily">@font/google_sans_flex</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@style/Theme.IntelligentSearch.Animation.None</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:ambientShadowAlpha">0</item>
        <item name="android:spotShadowAlpha">0</item>
        <item name="android:windowSplashScreenBackground">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/transparent_splash</item>
    </style>

    <style name="Theme.IntelligentSearch.Overlay.Widget" parent="Theme.IntelligentSearch.Overlay">
        <item name="android:windowElevation">0dp</item>
        <item name="android:windowSplashScreenBackground">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/transparent_splash</item>
    </style>

    <!-- The home screen's search bar opens the overlay see-through (no wallpaper yet): its blur fades in over the home
         screen instead of the home screen vanishing in one frame. MainActivity brings the wallpaper in once the blur
         is full. -->
    <style name="Theme.IntelligentSearch.Overlay.WidgetLaunch" parent="Theme.IntelligentSearch.Overlay.Widget">
        <item name="android:windowShowWallpaper">false</item>
    </style>

    <style name="Theme.IntelligentSearch.Overlay.Launcher" parent="Theme.IntelligentSearch.Overlay">
        <item name="android:windowElevation">0dp</item>
        <item name="android:windowSplashScreenBackground">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/transparent_splash</item>
    </style>
</resources>
