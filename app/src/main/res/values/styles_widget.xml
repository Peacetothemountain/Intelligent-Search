<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The doodle player over the widget's G. Starts from the plain platform ProgressBar style so the launcher's theme
        can't tint the art; fills the G's 48dp slot; hidden from TalkBack, which reads the G's description instead.
    -->
    <style name="WidgetDoodle" parent="@android:style/Widget.ProgressBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:maxWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:maxHeight">48dp</item>
        <item name="android:indeterminate">true</item>
        <item name="android:indeterminateOnly">true</item>
        <item name="android:mirrorForRtl">false</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
    </style>

    <!--
        A doodle that is drawn mirrored where the home screen reads right to left. There the G sits at the bar's right
        end, and art drawn for the left end's curve would reach past the right end's; mirrored, it fits the same way.
        For doodles that read the same either way round. One with digits, letters or a music note keeps its plain
        style and has a layout-ldrtl layout instead (see doodle_glyphs_scale_x).
    -->
    <style name="WidgetDoodle.Mirrored">
        <item name="android:mirrorForRtl">true</item>
    </style>

    <!--
        The horizontal scale of the digits, letters and notes inside a doodle: 1 here, and -1 where the home screen
        reads right to left (values-ldrtl), where that doodle's layout-ldrtl layout draws it mirrored. Turned over a
        second time, about their own middle, they read the right way round in their mirrored place.
    -->
    <item name="doodle_glyphs_scale_x" type="dimen" format="float">1</item>
</resources>
