<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind the first frame, in the wallpaper's neutral tone, so launch never flashes. Compose draws
         the rest. -->
    <style name="Theme.Search" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/system_neutral1_10</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
