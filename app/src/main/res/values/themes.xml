<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind the first frame: ink, so a dark launch never flashes white. Compose draws the rest. -->
    <style name="Theme.Search" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="ink">#0F1012</color>
</resources>
