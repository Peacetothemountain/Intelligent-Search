<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.IntelligentSearch.Animation">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>
    <!-- Android's own Material theme, the one Material Components' theme was built on. Every screen is drawn with
         Compose, so the window needs nothing from that library, and its theme kept hundreds of its view styles and
         drawables in the app. The dark version is in values-night. -->
    <style name="Platform.IntelligentSearch" parent="@android:style/Theme.Material.Light.NoActionBar" />
    <style name="Theme.IntelligentSearch" parent="Platform.IntelligentSearch">
        <!-- Text drawn by Android's own views in the app's windows is Google Sans Flex too, like the Compose text. -->
        <item name="android:fontFamily">@font/google_sans_flex</item>
        <!-- Material 3's background, shown behind Settings before its first frame and on its launch screen. -->
        <item name="android:colorBackground">@color/window_background</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <!-- Material 3's scrim behind dialogs. -->
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="android:windowAnimationStyle">@style/Theme.IntelligentSearch.Animation</item>
    </style>
    <style name="Theme.IntelligentSearch.Animation.None">
        <item name="android:windowEnterAnimation">@anim/no_anim</item>
        <item name="android:windowExitAnimation">@anim/no_anim</item>
        <item name="android:activityOpenEnterAnimation">@anim/no_anim</item>
        <item name="android:activityOpenExitAnimation">@anim/no_anim</item>
        <item name="android:activityCloseEnterAnimation">@anim/no_anim</item>
        <item name="android:activityCloseExitAnimation">@anim/no_anim</item>
        <item name="android:taskOpenEnterAnimation">@anim/no_anim</item>
        <item name="android:taskOpenExitAnimation">@anim/no_anim</item>
        <item name="android:taskCloseEnterAnimation">@anim/no_anim</item>
        <item name="android:taskCloseExitAnimation">@anim/no_anim</item>
        <item name="android:taskToFrontEnterAnimation">@anim/no_anim</item>
        <item name="android:taskToFrontExitAnimation">@anim/no_anim</item>
        <item name="android:taskToBackEnterAnimation">@anim/no_anim</item>
        <item name="android:taskToBackExitAnimation">@anim/no_anim</item>
        <item name="android:wallpaperOpenEnterAnimation">@anim/no_anim</item>
        <item name="android:wallpaperOpenExitAnimation">@anim/no_anim</item>
        <item name="android:wallpaperCloseEnterAnimation">@anim/no_anim</item>
        <item name="android:wallpaperCloseExitAnimation">@anim/no_anim</item>
        <item name="android:wallpaperIntraOpenEnterAnimation">@anim/no_anim</item>
        <item name="android:wallpaperIntraOpenExitAnimation">@anim/no_anim</item>
        <item name="android:wallpaperIntraCloseEnterAnimation">@anim/no_anim</item>
        <item name="android:wallpaperIntraCloseExitAnimation">@anim/no_anim</item>
    </style>

    <style name="Theme.IntelligentSearch.Overlay" parent="Platform.IntelligentSearch">
        <!-- Recents screenshots are off, so Android draws the Recents card from these when its live preview ends;
             the theme's own status bar color would show as a colored header on it. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Text drawn by Android's own views in the app's windows is Google Sans Flex too, like the Compose text. -->
        <item name="android:fontFamily">@font/google_sans_flex</item>
        <!-- Material 3's scrim behind dialogs. -->
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@style/Theme.IntelligentSearch.Animation.None</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:ambientShadowAlpha">0</item>
        <item name="android:spotShadowAlpha">0</item>
        <item name="android:windowSplashScreenBackground">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/transparent_splash</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>

    <style name="Theme.IntelligentSearch.Overlay.Widget" parent="Theme.IntelligentSearch.Overlay">
        <item name="android:windowElevation">0dp</item>
        <item name="android:windowSplashScreenBackground">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/transparent_splash</item>
    </style>

    <!-- The home screen's search bar opens the overlay see-through (no wallpaper yet): its blur fades in over the home
         screen instead of the home screen vanishing in one frame. MainActivity brings the wallpaper in once the blur
         is full. -->
    <style name="Theme.IntelligentSearch.Overlay.WidgetLaunch" parent="Theme.IntelligentSearch.Overlay.Widget">
        <item name="android:windowShowWallpaper">false</item>
    </style>

    <style name="Theme.IntelligentSearch.Overlay.Launcher" parent="Theme.IntelligentSearch.Overlay">
        <item name="android:windowElevation">0dp</item>
        <item name="android:windowSplashScreenBackground">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/transparent_splash</item>
    </style>
</resources>
